{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kadry-pro.ru/schemas/templates.schema.json",
  "title": "Kadry-Pro template catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle", "paid_single_price", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "paid_single_price": { "const": 500 },
    "bundle": { "type": "object", "required": ["id", "name", "price", "file"], "properties": { "id": { "const": "free-20" }, "name": { "type": "string" }, "price": { "const": 0 }, "file": { "const": "/shablony/free-bundle-20.zip" } } },
    "items": { "type": "array", "minItems": 64, "maxItems": 64, "items": { "type": "object", "required": ["id", "name", "category", "description", "access", "free", "price", "preview"], "properties": { "id": { "type": "string", "pattern": "^\\d{2}$" }, "name": { "type": "string", "minLength": 1 }, "category": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "free": { "type": "boolean" }, "access": { "enum": ["free", "paid"] }, "price": { "type": "integer", "minimum": 0 }, "file": { "type": ["string", "null"] }, "preview": { "type": ["string", "null"] } } } }
  }
}
