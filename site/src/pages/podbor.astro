/**
 * Страница «podbor» — перенесена с podbor.html без потери текстов.
 * Заголовок, описание и JSON-LD взяты из старой страницы один в один;
 * адрес остаётся прежним (build.format: 'file' → /podbor.html).
 */
import Base from '../layouts/Base.astro';
import { renderPriceToken, formatPrice, getPrice } from '../shared/prices.ts';
const content = renderPriceToken("<!-- ====== НАВИГАЦИЯ ====== -->\n\n<!-- Мобильное меню -->\n\n<!-- ============================================================\n     1. HERO\n     ============================================================ -->\n<section class=\"hero hero-sub\" style=\"padding-bottom: 80px;\">\n  <div class=\"hero-bg\"></div>\n  <div class=\"hero-grid\"></div>\n  <div class=\"container\" style=\"display: block;\">\n    <div class=\"hero-content\" style=\"max-width: 900px;\">\n\n      <nav class=\"breadcrumb-nav anim\" aria-label=\"Хлебные крошки\">\n        <a href=\"/\">Главная</a>\n        <span class=\"breadcrumb-sep\">→</span>\n        <a href=\"/services.html\">Услуги</a>\n        <span class=\"breadcrumb-sep\">→</span>\n        <span class=\"breadcrumb-current\">Подбор персонала</span>\n      </nav>\n\n      <div class=\"hero-badge anim anim-delay-1\">\n        <span class=\"hero-badge-dot\"></span>\n        Принимаю заявки на подбор\n      </div>\n\n      <h1 class=\"anim anim-delay-2\">\n        Подбор персонала в <strong class=\"accent\">Ростове-на-Дону</strong> — от единичной вакансии до массового проекта\n      </h1>\n\n      <p class=\"hero-subtitle anim anim-delay-3\" style=\"margin-bottom: 32px;\">\n        Единичный и массовый подбор кадров. Вахтовый персонал, рабочие специальности, офис.\n        Закрытие вакансий от <strong class=\"price-highlight\">30&nbsp;000&nbsp;₽</strong>\n        с гарантией замены. Быстрые сроки — первые кандидаты через 3–5 дней.\n      </p>\n\n      <div class=\"hero-benefits anim anim-delay-4\" style=\"border-top: none; margin-top: 0; padding-top: 0; margin-bottom: 32px;\">\n        <div class=\"benefit-item\">\n          <span class=\"benefit-icon\">📅</span>\n          <span>14 лет HR-опыта</span>\n        </div>\n        <div class=\"benefit-item\">\n          <span class=\"benefit-icon\">🔄</span>\n          <span>Гарантия замены</span>\n        </div>\n        <div class=\"benefit-item\">\n          <span class=\"benefit-icon\">📝</span>\n          <span>Работа по договору</span>\n        </div>\n      </div>\n\n      <div class=\"hero-actions anim anim-delay-5\">\n        <a href=\"#contact-form\" class=\"btn btn-primary btn-lg\">\n          <span class=\"btn-icon\">💬</span> Обсудить вакансию\n        </a>\n        <a href=\"#pricing\" class=\"btn btn-outline btn-lg\">\n          <span class=\"btn-icon\">💰</span> Смотреть цены\n        </a>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     2. ВИДЫ ПОДБОРА (4 карточки)\n     ============================================================ -->\n<section class=\"section\" id=\"types\">\n  <div class=\"container\">\n    <div class=\"section-header anim\">\n      <h2>Виды <strong>подбора</strong></h2>\n      <p>Выберите формат, который подходит для вашей задачи</p>\n    </div>\n\n    <div class=\"podbor-types\">\n\n      <!-- Единичный -->\n      <div class=\"card pricing-card featured anim\">\n        <div class=\"pricing-badge\">Популярное</div>\n        <h3>👤 Единичный подбор</h3>\n        <p class=\"pricing-desc\">1–3 вакансии</p>\n        <div class=\"pricing-price\">{{price:services.recruitment}}</div>\n        <p class=\"pricing-desc\" style=\"margin-bottom: 16px;\">фикс или 50% от оклада</p>\n        <ul class=\"pricing-features\">\n          <li>Срок закрытия: 7–14 дней</li>\n          <li>3–5 кандидатов на выбор</li>\n          <li>Гарантия замены — 1 месяц</li>\n          <li>Оплата по факту выхода на работу</li>\n        </ul>\n        <a href=\"#contact-form\" class=\"btn btn-primary btn-block\">Заказать подбор</a>\n      </div>\n\n      <!-- Массовый -->\n      <div class=\"card pricing-card anim anim-delay-1\">\n        <h3>👥 Массовый подбор</h3>\n        <p class=\"pricing-desc\">10–50 человек</p>\n        <div class=\"pricing-price\">от {{price:services.mass-recruitment}}<span class=\"per\">/чел</span></div>\n        <p class=\"pricing-desc\" style=\"margin-bottom: 16px;\">гибкие условия оплаты</p>\n        <ul class=\"pricing-features\">\n          <li>Срок: от 2 недель</li>\n          <li>Еженедельные отчёты о ходе</li>\n          <li>Координация выхода на работу</li>\n          <li>Скидки при объёмах от 30 чел.</li>\n        </ul>\n        <a href=\"#contact-form\" class=\"btn btn-outline btn-block\">Обсудить проект</a>\n      </div>\n\n      <!-- Проектный -->\n      <div class=\"card pricing-card anim anim-delay-2\">\n        <h3>🏗️ Проектный подбор</h3>\n        <p class=\"pricing-desc\">50+ человек, вахта</p>\n        <div class=\"pricing-price\">индивидуально</div>\n        <p class=\"pricing-desc\" style=\"margin-bottom: 16px;\">стартовый платёж + поэтапно</p>\n        <ul class=\"pricing-features\">\n          <li>Подбор вахтовиков по всей РФ</li>\n          <li>Сварщики, электрики, монтажники</li>\n          <li>Организация логистики персонала</li>\n          <li>Проектный менеджмент 24/7</li>\n        </ul>\n        <a href=\"#contact-form\" class=\"btn btn-outline btn-block\">Рассчитать стоимость</a>\n      </div>\n\n      <!-- Абонентский -->\n      <div class=\"card pricing-card anim anim-delay-3\">\n        <h3>🔄 Абонентский подбор</h3>\n        <p class=\"pricing-desc\">Постоянное сопровождение</p>\n        <div class=\"pricing-price\">от {{price:services.recruitment-subscription}}<span class=\"per\">/мес</span></div>\n        <p class=\"pricing-desc\" style=\"margin-bottom: 16px;\">безлимитные вакансии</p>\n        <ul class=\"pricing-features\">\n          <li>Безлимитное кол-во вакансий</li>\n          <li>Приоритетное обслуживание</li>\n          <li>Выделенный рекрутер</li>\n          <li>Аналитика и отчётность</li>\n        </ul>\n        <a href=\"#contact-form\" class=\"btn btn-outline btn-block\">Подключить</a>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     3. СПЕЦИАЛИЗАЦИИ (4 карточки, акцент на вахту)\n     ============================================================ -->\n<section class=\"section section-alt\" id=\"specializations\">\n  <div class=\"container\">\n    <div class=\"section-header anim\">\n      <h2>Кого <strong>подбираю</strong></h2>\n      <p>Специализация на ключевых направлениях для бизнеса юга России</p>\n    </div>\n\n    <div class=\"podbor-specs\">\n\n      <div class=\"card service-card anim\" style=\"cursor: default;\">\n        <div class=\"service-card-icon\">🏢</div>\n        <h3>Офисный персонал</h3>\n        <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Менеджеры, бухгалтеры, администраторы, помощники руководителя, HR-специалисты, секретари</p>\n        <div class=\"service-card-price\">от {{price:services.recruitment}}</div>\n      </div>\n\n      <div class=\"card service-card anim anim-delay-1\" style=\"cursor: default;\">\n        <div class=\"service-card-icon\">🏭</div>\n        <h3>Производство и строительство</h3>\n        <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Мастера, технологи, инженеры, прорабы, специалисты по охране труда, рабочие</p>\n        <div class=\"service-card-price\">от {{price:services.recruitment}}</div>\n      </div>\n\n      <div class=\"card service-card anim anim-delay-2\" style=\"cursor: default;\">\n        <div class=\"service-card-icon\">🛒</div>\n        <h3>Торговля и услуги</h3>\n        <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Продавцы, кассиры, мерчендайзеры, специалисты по клиентскому сервису, логисты</p>\n        <div class=\"service-card-price\">от {{price:services.mass-recruitment}}/чел</div>\n      </div>\n\n      <!-- ВАХТА — с акцентом -->\n      <div class=\"card service-card spec-card-accent anim anim-delay-3\" style=\"cursor: default;\">\n        <div class=\"service-card-icon\" style=\"background: var(--accent-glow-strong);\">⚡</div>\n        <h3>Вахтовый персонал</h3>\n        <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Сварщики НАКС, электрики, монтажники, слесари, разнорабочие. Подбор по всей России для вахтовых проектов</p>\n        <div class=\"service-card-price\">от {{price:services.shift-recruitment}}/чел</div>\n        <span class=\"tag\" style=\"margin-top: 12px;\">⭐ Особая специализация</span>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     4. ПРОЦЕСС РАБОТЫ (5 шагов)\n     ============================================================ -->\n<section class=\"section\" id=\"process\">\n  <div class=\"container\" style=\"max-width: 900px;\">\n    <div class=\"section-header anim\">\n      <h2>Как я <strong>работаю</strong></h2>\n      <p>Прозрачный процесс от заявки до выхода сотрудника</p>\n    </div>\n\n    <div class=\"card anim\" style=\"padding: 40px;\">\n\n      <div class=\"pvs-item\" style=\"gap: 16px;\">\n        <span class=\"step-number\">1</span>\n        <div>\n          <h4 style=\"margin-bottom: 6px;\">Погружение в бизнес <span class=\"step-time\">— 1–2 дня</span></h4>\n          <p style=\"color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7;\">\n            Изучаю специфику компании, корпоративную культуру, требования к кандидату.\n            Составляю портрет идеального сотрудника и согласовываю стратегию поиска.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"pvs-item\" style=\"gap: 16px;\">\n        <span class=\"step-number\">2</span>\n        <div>\n          <h4 style=\"margin-bottom: 6px;\">Поиск и скрининг <span class=\"step-time\">— 3–5 дней</span></h4>\n          <p style=\"color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7;\">\n            Собираю резюме с 5+ источников: hh.ru, SuperJob, Avito, профессиональные\n            сообщества, собственная база. Провожу скрининг-звонки, отбираю 10–15 кандидатов.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"pvs-item\" style=\"gap: 16px;\">\n        <span class=\"step-number\">3</span>\n        <div>\n          <h4 style=\"margin-bottom: 6px;\">Глубинное интервью <span class=\"step-time\">— 2–3 дня</span></h4>\n          <p style=\"color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7;\">\n            Провожу собеседования по компетенциям, оцениваю мотивацию и soft skills.\n            Проверяю рекомендации с 2–3 предыдущих мест работы.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"pvs-item\" style=\"gap: 16px;\">\n        <span class=\"step-number\">4</span>\n        <div>\n          <h4 style=\"margin-bottom: 6px;\">Презентация кандидатов <span class=\"step-time\">— 1 день</span></h4>\n          <p style=\"color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7;\">\n            Показываю 3–5 лучших кандидатов с развёрнутыми характеристиками: опыт,\n            сильные стороны, мотивация, ожидания по зарплате, потенциальные риски.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"pvs-item\" style=\"gap: 16px; border-bottom: none;\">\n        <span class=\"step-number\">5</span>\n        <div>\n          <h4 style=\"margin-bottom: 6px;\">Сопровождение адаптации <span class=\"step-time\">— 1–3 месяца</span></h4>\n          <p style=\"color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7;\">\n            Помогаю с оформлением, поддерживаю связь с сотрудником и руководителем\n            в первые месяцы. При необходимости — бесплатная замена в рамках гарантии.\n          </p>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     5. ГАРАНТИИ\n     ============================================================ -->\n<section class=\"section section-alt\" id=\"guarantees\">\n  <div class=\"container\" style=\"max-width: 900px;\">\n    <div class=\"section-header anim\">\n      <h2>Гарантии <strong>результата</strong></h2>\n      <p>Работаю на результат — рискую вместе с вами</p>\n    </div>\n\n    <div class=\"card anim\" style=\"background: linear-gradient(135deg, rgba(74,222,128,0.1), rgba(74,222,128,0.03)); border-color: rgba(74,222,128,0.3); padding: 36px;\">\n      <div class=\"podbor-guarantees\">\n\n        <div class=\"guarantee-block\">\n          <div class=\"guarantee-block-icon\">🔄</div>\n          <h4>Замена бесплатно</h4>\n          <p>Если кандидат уйдёт в гарантийный срок (1–3 месяца в зависимости от тарифа) — подберу замену за свой счёт</p>\n        </div>\n\n        <div class=\"guarantee-block\">\n          <div class=\"guarantee-block-icon\">💸</div>\n          <h4>Возврат 50%</h4>\n          <p>Если не закрою вакансию за 30 рабочих дней — верну 50% предоплаты. Это мотивирует меня работать быстро</p>\n        </div>\n\n        <div class=\"guarantee-block\">\n          <div class=\"guarantee-block-icon\">📋</div>\n          <h4>Оплата по факту</h4>\n          <p>50% при выходе кандидата на работу, 50% после прохождения испытательного срока. Вы платите за результат</p>\n        </div>\n\n        <div class=\"guarantee-block\">\n          <div class=\"guarantee-block-icon\">🔒</div>\n          <h4>Конфиденциальность</h4>\n          <p>Кандидаты не знают, кто работодатель, до финального собеседования. Информация о вакансии — под NDA</p>\n        </div>\n\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     6. ПРАЙС-ЛИСТ (таблицы)\n     ============================================================ -->\n<section class=\"section\" id=\"pricing\">\n  <div class=\"container\" style=\"max-width: 1000px;\">\n    <div class=\"section-header anim\">\n      <h2>Прайс-лист <strong>подбора персонала</strong></h2>\n      <p>Прозрачные цены без скрытых платежей</p>\n    </div>\n\n    <!-- Основные услуги -->\n    <div class=\"card anim\" style=\"margin-bottom: 32px; overflow-x: auto;\">\n      <h3 style=\"margin-bottom: 20px; color: var(--accent);\">📋 Основные услуги подбора</h3>\n      <table class=\"data-table\">\n        <thead>\n          <tr>\n            <th>Услуга</th>\n            <th>Стоимость</th>\n            <th>Гарантия замены</th>\n            <th>Срок</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>Единичный подбор (оклад до 50 000 ₽)</td>\n            <td class=\"price-cell\">{{price:services.recruitment}}</td>\n            <td>1 месяц</td>\n            <td>7–14 дней</td>\n          </tr>\n          <tr>\n            <td>Единичный подбор (оклад выше 50 000 ₽)</td>\n            <td class=\"price-cell\">50% от оклада</td>\n            <td>3 месяца</td>\n            <td>10–21 день</td>\n          </tr>\n          <tr>\n            <td>Массовый подбор (10–30 чел.)</td>\n            <td class=\"price-cell\">{{price:services.mass-recruitment}}/чел</td>\n            <td>2 недели</td>\n            <td>от 2 недель</td>\n          </tr>\n          <tr>\n            <td>Массовый подбор (30–100 чел.)</td>\n            <td class=\"price-cell\">4 000 ₽/чел</td>\n            <td>2 недели</td>\n            <td>от 3 недель</td>\n          </tr>\n          <tr>\n            <td>Проектный подбор (100+ чел.)</td>\n            <td class=\"price-cell\">от {{price:services.shift-recruitment}}/чел</td>\n            <td>индивидуально</td>\n            <td>от 1 месяца</td>\n          </tr>\n          <tr>\n            <td>Абонентский (до 5 вакансий/мес)</td>\n            <td class=\"price-cell\">{{price:services.recruitment-subscription}}/мес</td>\n            <td>3 месяца</td>\n            <td>постоянно</td>\n          </tr>\n          <tr>\n            <td>Абонентский (до 10 вакансий/мес)</td>\n            <td class=\"price-cell\">125 000 ₽/мес</td>\n            <td>3 месяца</td>\n            <td>постоянно</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <!-- Дополнительные услуги -->\n    <div class=\"card anim anim-delay-1\" style=\"overflow-x: auto;\">\n      <h3 style=\"margin-bottom: 20px; color: var(--accent);\">➕ Дополнительные услуги</h3>\n      <table class=\"data-table\">\n        <thead>\n          <tr>\n            <th>Услуга</th>\n            <th>Стоимость</th>\n            <th>Примечание</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>Скрининг резюме (без собеседований)</td>\n            <td class=\"price-cell\">10 000 ₽</td>\n            <td class=\"note-cell\">10 отобранных резюме с комментариями</td>\n          </tr>\n          <tr>\n            <td>Проверка кандидатов (рекомендации, базы)</td>\n            <td class=\"price-cell\">{{price:services.mass-recruitment}}/чел</td>\n            <td class=\"note-cell\">Проверка 3+ источников, отчёт</td>\n          </tr>\n          <tr>\n            <td>Тестирование профессиональных навыков</td>\n            <td class=\"price-cell\">от 15 000 ₽</td>\n            <td class=\"note-cell\">Разработка теста + оценка результатов</td>\n          </tr>\n          <tr>\n            <td>Подбор из других регионов (релокация)</td>\n            <td class=\"price-cell\">+50% к стоимости</td>\n            <td class=\"note-cell\">Помощь с переездом и адаптацией</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     7. КЕЙСЫ / ПРИМЕРЫ РАБОТ\n     ============================================================ -->\n<section class=\"section section-alt\" id=\"cases-podbor\">\n  <div class=\"container\">\n    <div class=\"section-header anim\">\n      <h2>Примеры <strong>работ</strong></h2>\n      <p>Реальные проекты по подбору персонала</p>\n    </div>\n\n    <div class=\"cases-grid\">\n\n      <div class=\"card case-card anim\">\n        <div class=\"case-label\">Массовый подбор · Вахта</div>\n        <h3>50 вахтовиков для строительства в Бийске</h3>\n        <div class=\"case-meta\">\n          <span>🔧 Сварщики НАКС, монтажники</span>\n          <span>⏱ Срок: <strong>3 недели</strong></span>\n        </div>\n        <p>Строительная компания из Ростова выиграла подряд. Нужно было набрать 50 человек за месяц — сварщиков с аттестацией НАКС, монтажников металлоконструкций, разнорабочих.</p>\n        <div class=\"case-results\">\n          <h4>Результат</h4>\n          <ul>\n            <li>53 человека вышли на объект за 3 недели</li>\n            <li>Текучесть за первый месяц — 6% (норма 15–20%)</li>\n            <li>Сэкономили 400 000 ₽ по сравнению с агентством</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"card case-card anim anim-delay-1\">\n        <div class=\"case-label\">Единичный подбор</div>\n        <h3>5 менеджеров по продажам за 2 недели</h3>\n        <div class=\"case-meta\">\n          <span>📊 B2B-продажи, FMCG</span>\n          <span>⏱ Срок: <strong>14 дней</strong></span>\n        </div>\n        <p>Дистрибьюторская компания открывала новое направление. Нужны были менеджеры с опытом B2B-продаж в сегменте FMCG и знанием региона.</p>\n        <div class=\"case-results\">\n          <h4>Результат</h4>\n          <ul>\n            <li>Все 5 вакансий закрыты за 14 дней</li>\n            <li>4 из 5 прошли испытательный срок</li>\n            <li>Замена 5-го кандидата — бесплатно по гарантии</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"card case-card anim anim-delay-2\">\n        <div class=\"case-label\">Экспертный подбор</div>\n        <h3>Главный бухгалтер с зарплатой 80 000 ₽</h3>\n        <div class=\"case-meta\">\n          <span>🏭 Производственная компания</span>\n          <span>⏱ Срок: <strong>10 дней</strong></span>\n        </div>\n        <p>Нужен главбух с опытом в производстве, знанием МСФО и 1С:ERP. Предыдущие попытки через hh.ru за 2 месяца не дали ни одного подходящего кандидата.</p>\n        <div class=\"case-results\">\n          <h4>Результат</h4>\n          <ul>\n            <li>Нашла кандидата через профессиональное сообщество</li>\n            <li>Выход на работу через 10 дней после заявки</li>\n            <li>Сотрудник работает в компании уже 2+ года</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"card case-card anim anim-delay-3\">\n        <div class=\"case-label\">Абонентский подбор</div>\n        <h3>15 продавцов для сети магазинов за месяц</h3>\n        <div class=\"case-meta\">\n          <span>🛍 Розничная сеть, 8 точек</span>\n          <span>⏱ Срок: <strong>1 месяц</strong></span>\n        </div>\n        <p>Сеть магазинов электроники расширялась. Каждый месяц нужны 3–5 продавцов. Оформили абонентский формат подбора для постоянного сопровождения.</p>\n        <div class=\"case-results\">\n          <h4>Результат</h4>\n          <ul>\n            <li>15 продавцов закрыты за первый месяц</li>\n            <li>Снижение текучести на 35% за 3 месяца</li>\n            <li>Экономия 60% по сравнению с единичным подбором</li>\n          </ul>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     8. СРАВНЕНИЕ С АГЕНТСТВАМИ\n     ============================================================ -->\n<section class=\"section\" id=\"comparison\">\n  <div class=\"container\" style=\"max-width: 1000px;\">\n    <div class=\"section-header anim\">\n      <h2>Почему <strong>я, а не агентство?</strong></h2>\n      <p>Честное сравнение: крупные агентства vs. персональный рекрутер</p>\n    </div>\n\n    <div class=\"card anim\" style=\"overflow-x: auto;\">\n      <table class=\"data-table\">\n        <thead>\n          <tr>\n            <th>Критерий</th>\n            <th style=\"color: var(--text-muted);\">Крупные агентства</th>\n            <th style=\"color: var(--accent);\">Мария Перепечай</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td><strong>Стоимость</strong></td>\n            <td class=\"comparison-bad\">100 000–300 000 ₽</td>\n            <td class=\"comparison-good\">от {{price:services.recruitment}}</td>\n          </tr>\n          <tr>\n            <td><strong>Сроки</strong></td>\n            <td class=\"comparison-bad\">2–4 недели</td>\n            <td class=\"comparison-good\">7–14 дней</td>\n          </tr>\n          <tr>\n            <td><strong>Подход</strong></td>\n            <td class=\"comparison-bad\">Шаблонный, конвейерный</td>\n            <td class=\"comparison-good\">Индивидуальный, под ваш бизнес</td>\n          </tr>\n          <tr>\n            <td><strong>Гарантии</strong></td>\n            <td class=\"comparison-bad\">Стандартные (1 замена)</td>\n            <td class=\"comparison-good\">Расширенные + возврат 50%</td>\n          </tr>\n          <tr>\n            <td><strong>Коммуникация</strong></td>\n            <td class=\"comparison-bad\">Через менеджеров-посредников</td>\n            <td class=\"comparison-good\">Напрямую с исполнителем</td>\n          </tr>\n          <tr>\n            <td><strong>Вахтовый персонал</strong></td>\n            <td class=\"comparison-bad\">Обычно не специализируются</td>\n            <td class=\"comparison-good\">Глубокая экспертиза, 14 лет</td>\n          </tr>\n          <tr>\n            <td><strong>Прозрачность</strong></td>\n            <td class=\"comparison-bad\">Отчёт после закрытия</td>\n            <td class=\"comparison-good\">Еженедельные отчёты</td>\n          </tr>\n          <tr>\n            <td><strong>Массовый подбор</strong></td>\n            <td class=\"comparison-bad\">Минимальный заказ от 200 000 ₽</td>\n            <td class=\"comparison-good\">от {{price:services.mass-recruitment}}/чел, любые объёмы</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     9. FAQ (7 вопросов)\n     ============================================================ -->\n<section class=\"section section-alt\" id=\"faq\">\n  <div class=\"container\" style=\"max-width: 900px;\">\n    <div class=\"section-header anim\">\n      <h2>Частые <strong>вопросы</strong></h2>\n      <p>Ответы на популярные вопросы о подборе персонала</p>\n    </div>\n\n    <div class=\"accordion-item anim\">\n      <button class=\"accordion-header\">\n        Сколько времени занимает подбор персонала?\n        <span class=\"accordion-icon\">+</span>\n      </button>\n      <div class=\"accordion-body\">\n        <div class=\"accordion-body-inner\">\n          <strong>Единичная вакансия</strong> — 7–14 дней. <strong>Массовый подбор</strong> 10–30 человек — от 2 недель. <strong>Проектный подбор</strong> 50+ человек — от 1 месяца.\n          Первые кандидаты появляются уже через 3–5 дней после старта. Сроки зависят от сложности вакансии, уровня зарплаты и специфических требований к кандидату.\n          Для срочных вакансий могу ускорить процесс за дополнительную плату.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"accordion-item anim anim-delay-1\">\n      <button class=\"accordion-header\">\n        Что если кандидат не подойдёт или уволится?\n        <span class=\"accordion-icon\">+</span>\n      </button>\n      <div class=\"accordion-body\">\n        <div class=\"accordion-body-inner\">\n          В зависимости от тарифа гарантия замены составляет <strong>от 1 до 3 месяцев</strong>. Если кандидат уйдёт или будет уволен в гарантийный период — подберу замену <strong>бесплатно</strong>.\n          Если не закрою вакансию за 30 рабочих дней — верну 50% предоплаты. Благодаря тщательному отбору 85% кандидатов проходят испытательный срок.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"accordion-item anim anim-delay-2\">\n      <button class=\"accordion-header\">\n        Работаете ли вы с вахтовым персоналом?\n        <span class=\"accordion-icon\">+</span>\n      </button>\n      <div class=\"accordion-body\">\n        <div class=\"accordion-body-inner\">\n          Да, <strong>подбор вахтовиков — одна из моих ключевых специализаций</strong>. Подбираю сварщиков (в т.ч. с НАКС), электриков, монтажников, слесарей, разнорабочих.\n          Имею опыт массового подбора 50+ человек для строительных проектов по всей России. Помогаю с организацией логистики персонала до объекта.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"accordion-item anim anim-delay-3\">\n      <button class=\"accordion-header\">\n        Какие регионы покрываете?\n        <span class=\"accordion-icon\">+</span>\n      </button>\n      <div class=\"accordion-body\">\n        <div class=\"accordion-body-inner\">\n          <strong>Работаю по всей России.</strong> Основной фокус — Ростов-на-Дону, Краснодар, Волгоград и юг России, но подбираю кандидатов из любых регионов.\n          Для вахтовых проектов ищу людей по всей стране. При необходимости подбора из другого региона с релокацией — стоимость увеличивается на 50%.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"accordion-item anim anim-delay-4\">\n      <button class=\"accordion-header\">\n        Есть ли предоплата?\n        <span class=\"accordion-icon\">+</span>\n      </button>\n      <div class=\"accordion-body\">\n        <div class=\"accordion-body-inner\">\n          Для <strong>единичного подбора</strong> — оплата только по факту: 50% при выходе кандидата, 50% после испытательного срока. Для <strong>массового и проектного подбора</strong> — стартовый платёж 30% и поэтапная оплата по мере закрытия вакансий.\n          Для <strong>абонентского формата</strong> — ежемесячная оплата в начале месяца.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"accordion-item anim anim-delay-5\">\n      <button class=\"accordion-header\">\n        Как проверяете кандидатов?\n        <span class=\"accordion-icon\">+</span>\n      </button>\n      <div class=\"accordion-body\">\n        <div class=\"accordion-body-inner\">\n          Многоступенчатая проверка: <strong>скрининг-звонок</strong> (первичная оценка), <strong>глубинное интервью</strong> по компетенциям (30–60 мин),\n          <strong>проверка рекомендаций</strong> с 2–3 предыдущих мест работы, верификация документов об образовании и квалификации.\n          Дополнительно (за отдельную плату): проверка по базам данных, тестирование профессиональных навыков.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"accordion-item anim\">\n      <button class=\"accordion-header\">\n        Работаете ли по договору?\n        <span class=\"accordion-icon\">+</span>\n      </button>\n      <div class=\"accordion-body\">\n        <div class=\"accordion-body-inner\">\n          <strong>Только по договору.</strong> Заключаю договор оказания услуг с чётким техническим заданием, сроками, гарантиями и условиями оплаты.\n          По завершении — акт выполненных работ. Работаю как ИП, предоставляю все закрывающие документы для бухгалтерии.\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     10. CTA + ФОРМА\n     ============================================================ -->\n<section class=\"section cta-section\" id=\"contact-form\">\n  <div class=\"container\">\n    <div class=\"contact-grid\">\n\n      <div class=\"anim\">\n        <h2 style=\"font-size:clamp(1.5rem,3vw,2.2rem);font-weight:300;margin-bottom:16px;\">\n          Нужен сотрудник? <strong>Обсудим задачу за 10 минут</strong>\n        </h2>\n        <p style=\"color:var(--text-secondary);margin-bottom:32px;\">\n          Расскажите о вакансии — я оценю сложность, назову сроки и точную стоимость.\n          Консультация бесплатная и ни к чему не обязывает.\n        </p>\n\n        <div class=\"contact-info-item\">\n          <div class=\"contact-info-icon\">📱</div>\n          <div>\n            <h4>Телефон</h4>\n            <a href=\"tel:+79613022112\">+7 (961) 302-21-12</a>\n          </div>\n        </div>\n        <div class=\"contact-info-item\">\n          <div class=\"contact-info-icon\">✉️</div>\n          <div>\n            <h4>Email</h4>\n            <a href=\"mailto:m.perepechay@yandex.ru\">m.perepechay@yandex.ru</a>\n          </div>\n        </div>\n        <div class=\"contact-info-item\">\n          <div class=\"contact-info-icon\">📍</div>\n          <div>\n            <h4>Локация</h4>\n            <p>Ростов-на-Дону (работаю по всей России)</p>\n          </div>\n        </div>\n\n        <div class=\"messengers\" style=\"margin-top: 24px;\">\n          <a href=\"https://wa.me/79613022112\" class=\"messenger-btn messenger-whatsapp\" target=\"_blank\" rel=\"noopener\">\n            <span class=\"messenger-icon\">💬</span> WhatsApp\n          </a>\n          <a href=\"https://t.me/Mariya061\" class=\"messenger-btn messenger-telegram\" target=\"_blank\" rel=\"noopener\">\n            <span class=\"messenger-icon\">✈️</span> Telegram\n          </a>\n        </div>\n      </div>\n\n      <div class=\"anim anim-delay-1\">\n        <form data-validate=\"\" data-lead-form data-page=\"podbor\" novalidate>\n          <input type=\"hidden\" name=\"page\" value=\"podbor\">\n          <input type=\"hidden\" name=\"source\" value=\"contact-form:podbor\">\n          <input type=\"text\" name=\"company_website\" class=\"quick-lead-hp\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\">\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label class=\"form-label\">Ваше имя *</label>\n              <input type=\"text\" name=\"name\" class=\"form-input\" placeholder=\"Иван Иванов\" required=\"\">\n              <span class=\"form-error\">Укажите имя</span>\n            </div>\n            <div class=\"form-group\">\n              <label class=\"form-label\">Телефон *</label>\n              <input type=\"tel\" name=\"phone\" class=\"form-input\" data-mask=\"phone\" placeholder=\"+7 (___) ___-__-__\" required=\"\">\n              <span class=\"form-error\">Укаж