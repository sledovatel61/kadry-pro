const content = renderPriceToken("<!-- HERO -->\n  <section class=\"hero hero-sub\">\n    <div class=\"hero-bg\"></div>\n    <div class=\"container\">\n      <div class=\"hero-content\">\n        <h1 class=\"anim\">Аудит кадрового <strong class=\"accent\">учёта</strong></h1>\n        <p class=\"hero-subtitle anim anim-delay-1\">Проверка документов перед инспекцией ГИТ. Выявлю риски, устраню нарушения, защищу от штрафов до 500 000 ₽</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- КОНТЕНТ -->\n  <section class=\"section bg-inner-scene bg-services-scene\">\n    <div class=\"container\" style=\"max-width: 900px;\">\n\n      <!-- Проблема -->\n      <div class=\"card anim\" style=\"margin-bottom: 32px; background: rgba(239, 68, 68, 0.05); border-color: rgba(239, 68, 68, 0.2);\">\n        <h2 style=\"color: var(--danger); margin-bottom: 16px;\">⚠️ Проверка ГИТ может прийти завтра</h2>\n        <p style=\"color: var(--text-secondary); line-height: 1.8; margin-bottom: 16px;\">\n          Трудовая инспекция не предупреждает о визите заранее. Если найдут нарушения —\n          штрафы от 30 000 до 100 000 ₽ за каждое нарушение, при повторном — до 200 000 ₽ и дисквалификация руководителя (ст. 5.27 КоАП РФ).\n        </p>\n        <p style=\"color: var(--text-secondary); line-height: 1.8;\">\n          <strong>Решение:</strong> аудит кадрового учёта «здесь и сейчас». За 1–2 дня проверю все документы,\n          выявлю риски, подготовлю к инспекции.\n        </p>\n      </div>\n\n      <!-- Что проверяю -->\n      <h2 class=\"anim\" style=\"font-size: 1.5rem; font-weight: 300; margin: 48px 0 24px; text-align: center;\">\n        Что проверяю <strong>за 1 день</strong>\n      </h2>\n\n      <div class=\"services-grid\" style=\"grid-template-columns: repeat(2, 1fr);\">\n\n        <div class=\"card service-card anim\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">📋</div>\n          <h3>Трудовые договоры</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">\n            Обязательные реквизиты, сроки заключения, соответствие ТК РФ,\n            дополнительные условия (NDA, материальная ответственность)\n          </p>\n        </div>\n\n        <div class=\"card service-card anim anim-delay-1\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">📄</div>\n          <h3>Приказы и ЛНА</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">\n            Приказы о приёме, увольнении, переводе. ПВТР, положения,\n            должностные инструкции — наличие и оформление\n          </p>\n        </div>\n\n        <div class=\"card service-card anim\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">📚</div>\n          <h3>Личные дела и трудовые книжки</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">\n            Правильность ведения, записи об образовании,\n            корректность записей о приёме и увольнении\n          </p>\n        </div>\n\n        <div class=\"card service-card anim anim-delay-1\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">⏰</div>\n          <h3>Табели и отпуска</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">\n            Соответствие фактического времени табелям,\n            оформление отпусков, компенсации при увольнении\n          </p>\n        </div>\n\n        <div class=\"card service-card anim\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">🛡️</div>\n          <h3>Воинский учёт</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">\n            Карточки формы № 10 и карточка организации № 18, своевременность постановки\n            на учёт и снятия, сведения в военкомат\n          </p>\n        </div>\n\n        <div class=\"card service-card anim anim-delay-1\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">📊</div>\n          <h3>Отчётность в СФР</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">\n            ЕФС-1: сведения о приёме, увольнении и стаже — своевременность сдачи,\n            корректность данных\n          </p>\n        </div>\n\n      </div>\n\n      <!-- Результат аудита -->\n      <h2 class=\"anim\" style=\"font-size: 1.5rem; font-weight: 300; margin: 48px 0 24px; text-align: center;\">\n        Что вы <strong>получите</strong>\n      </h2>\n\n      <div class=\"card anim\" style=\"margin-bottom: 32px;\">\n        <div class=\"pvs-item\">\n          <span class=\"pvs-icon good\">1</span>\n          <div>\n            <h4 style=\"margin-bottom: 4px;\">Детальный отчёт о найденных нарушениях</h4>\n            <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Список рисков с указанием конкретных статей ТК РФ и размеров штрафов</p>\n          </div>\n        </div>\n        <div class=\"pvs-item\">\n          <span class=\"pvs-icon good\">2</span>\n          <div>\n            <h4 style=\"margin-bottom: 4px;\">План устранения нарушений</h4>\n            <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Пошаговые рекомендации: что исправить, в какие сроки, в какой последовательности</p>\n          </div>\n        </div>\n        <div class=\"pvs-item\">\n          <span class=\"pvs-icon good\">3</span>\n          <div>\n            <h4 style=\"margin-bottom: 4px;\">Готовность к проверке ГИТ</h4>\n            <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">После моего аудита вы спокойно встретите инспектора — документы в порядке</p>\n          </div>\n        </div>\n        <div class=\"pvs-item\" style=\"border-bottom: none;\">\n          <span class=\"pvs-icon good\">4</span>\n          <div>\n            <h4 style=\"margin-bottom: 4px;\">Варианты дальнейшего сотрудничества</h4>\n            <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Могу устранить нарушения сама или взять кадры на абонентское обслуживание</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Цены -->\n      <h2 class=\"anim\" style=\"font-size: 1.5rem; font-weight: 300; margin: 48px 0 24px; text-align: center;\">\n        Стоимость <strong>аудита</strong>\n      </h2>\n\n      <div class=\"pricing-grid\" style=\"grid-template-columns: repeat(3, 1fr); margin-bottom: 32px;\">\n        <div class=\"card pricing-card anim\">\n          <h3>Экспресс</h3>\n          <p class=\"pricing-desc\">До 10 сотрудников</p>\n          <div class=\"pricing-price\">{{price:audit.express}}</div>\n          <ul class=\"pricing-features\">\n            <li>Проверка основных документов</li>\n            <li>Устный отчёт</li>\n            <li>Рекомендации по устранению</li>\n          </ul>\n          <a href=\"/contact.html\" class=\"btn btn-outline btn-block\">Заказать</a>\n        </div>\n\n        <div class=\"card pricing-card featured anim anim-delay-1\">\n          <div class=\"pricing-badge\">Рекомендую</div>\n          <h3>Стандарт</h3>\n          <p class=\"pricing-desc\">До 30 сотрудников</p>\n          <div class=\"pricing-price\">{{price:audit.standard}}</div>\n          <ul class=\"pricing-features\">\n            <li>Полная проверка всех документов</li>\n            <li>Письменный отчёт с рисками</li>\n            <li>План устранения нарушений</li>\n            <li>Подготовка к проверке ГИТ</li>\n          </ul>\n          <a href=\"/contact.html\" class=\"btn btn-primary btn-block\">Заказать</a>\n        </div>\n\n        <div class=\"card pricing-card anim anim-delay-2\">\n          <h3>Полный</h3>\n          <p class=\"pricing-desc\">50+ сотрудников</p>\n          <div class=\"pricing-price\">{{price:audit.full}}</div>\n          <ul class=\"pricing-features\">\n            <li>Всё из пакета «Стандарт»</li>\n            <li>Проверка всех филиалов</li>\n            <li>Выезд к клиенту</li>\n            <li>Сопровождение при проверке</li>\n          </ul>\n          <a href=\"/contact.html\" class=\"btn btn-outline btn-block\">Заказать</a>\n        </div>\n      </div>\n\n      <!-- Срочность -->\n      <div class=\"card anim\" style=\"margin-bottom: 32px; background: linear-gradient(135deg, var(--accent-glow), var(--accent-glow)); border-color: var(--accent-border);\">\n        <h3 style=\"margin-bottom: 16px;\">🚀 Срочный аудит — за 4 часа</h3>\n        <p style=\"color: var(--text-secondary); margin-bottom: 16px;\">\n          Инспекция уже на пороге? Проведу экспресс-проверку за 4 часа.\n          Выявлю критические риски, которые грозят штрафами.\n        </p>\n        <div style=\"display: flex; gap: 16px; align-items: center;\">\n          <div class=\"pricing-price\" style=\"margin: 0;\">{{price:audit.urgent}}</div>\n          <a href=\"/contact.html\" class=\"btn btn-primary\">Заказать срочно</a>\n        </div>\n      </div>\n\n      <!-- CTA -->\n      <div class=\"card anim\" style=\"text-align: center;\">\n        <h3 style=\"margin-bottom: 16px;\">Не уверены, нужен ли аудит?</h3>\n        <p style=\"color: var(--text-secondary); margin-bottom: 24px;\">\n          Позвоните — за 10 минут бесплатной консультации скажу,\n          есть ли у вас риски и стоит ли проводить проверку.\n        </p>\n        <a href=\"tel:+79613022112\" class=\"btn btn-primary btn-lg\" style=\"margin-right: 16px;\">Позвонить</a>\n        <a href=\"/contact.html\" class=\"btn btn-outline btn-lg\">Написать</a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n");
---

<Base
  title={"Аудит кадрового учёта | Проверка документов перед инспекцией ГИТ"}
