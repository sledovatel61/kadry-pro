---
import Base from '../layouts/Base.astro';
---
<Base title="Бесплатный набор готов — Кадры-Про" description="Заберите бесплатные кадровые шаблоны. Скачивание не требует электронной почты." page="thank-you" noindex>
  <section class="thanks-page container"><div class="thanks-mark" aria-hidden="true">✓</div><p class="eyebrow">Готово</p><h1>Ваш бесплатный набор уже здесь</h1><p class="thanks-lead">Не нужно ждать письма или оставлять адрес электронной почты. Скачайте архив из 20 бесплатных документов или выберите отдельный шаблон.</p><div class="thanks-actions"><a class="thanks-primary" href="/shablony/free-bundle-20.zip" download>Скачать ZIP · 20 документов</a><a class="thanks-secondary" href="/shablony.html">Открыть каталог</a></div><p class="thanks-footnote">Не нашли нужный документ? <a href="/contact.html?service=templates">Напишите Марии</a>.</p></section>
</Base>
<style>
  .thanks-page { max-width: 780px; min-height: 65vh; margin-block: 60px; padding: 74px 32px 64px; border: 1px solid var(--border-color,rgba(255,255,255,.15)); border-radius: 26px; text-align: center; color: var(--text-primary,#f2f6fb); background: var(--grad-card,linear-gradient(165deg,rgba(26,39,64,.9),rgba(14,21,36,.97))); box-shadow: inset 0 1px 0 rgba(255,255,255,.1),0 18px 48px rgba(4,8,20,.48); backdrop-filter: blur(12px); }
  .thanks-mark { display: grid; place-items: center; width: 74px; height: 74px; margin: 0 auto 25px; border: 1px solid var(--accent-border,rgba(88,166,255,.35)); border-radius: 24px; color: var(--accent-text,#b6daff); background: radial-gradient(circle at 28% 20%,rgba(255,255,255,.12),transparent 55%),linear-gradient(145deg,#1a2942,#111b2a); box-shadow: inset 0 1px 0 rgba(255,255,255,.14),0 10px 25px rgba(4,8,20,.42); font-size: 2.3rem; }
  .thanks-page .eyebrow { color: var(--accent,#58a6ff); font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .thanks-page h1 { margin: 10px 0 16px; font-size: clamp(2.3rem,6vw,4.4rem); line-height: 1.04; letter-spacing: -.05em; }
  .thanks-lead { max-width: 620px; margin: 0 auto; color: var(--text-secondary,#c1cbd8); font-size: 1.06rem; line-height: 1.7; }
  .thanks-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .thanks-primary,.thanks-secondary { display: inline-flex; align-items: center; min-height: 50px; padding: 0 19px; border-radius: 11px; text-decoration: none; font-weight: 750; }
  .thanks-primary { color: var(--on-accent,#f8fbff); background: var(--grad-btn,linear-gradient(135deg,#2563eb,#1d4ed8)); box-shadow: inset 0 1px 0 rgba(255,255,255,.24),0 8px 20px rgba(20,74,180,.3); }
  .thanks-secondary { border: 1px solid var(--border-light,rgba(255,255,255,.28)); color: var(--text-primary,#f2f6fb); background: linear-gradient(145deg,rgba(31,46,68,.72),rgba(17,26,41,.9)); box-shadow: inset 0 1px 0 rgba(255,255,255,.1); }
  .thanks-primary:hover,.thanks-primary:focus-visible { color: var(--on-accent,#f8fbff); background: var(--grad-btn-hover,linear-gradient(135deg,#3b82f6,#2563eb)); }
  .thanks-secondary:hover,.thanks-secondary:focus-visible { border-color: var(--accent-border,rgba(88,166,255,.4)); }
  .thanks-footnote { margin-top: 32px; color: var(--text-secondary,#c1cbd8); }
  .thanks-page a:not(.thanks-primary):not(.thanks-secondary) { color: var(--accent-text,#b6daff); }
</style>
