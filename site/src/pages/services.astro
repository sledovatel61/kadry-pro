---
/**
 * Страница «services» — перенесена с services.html без потери текстов.
 * Заголовок, описание и JSON-LD взяты из старой страницы один в один;
 * адрес остаётся прежним (build.format: 'file' → /services.html).
 */
import Base from '../layouts/Base.astro';
import { renderPriceToken, formatPrice, getPrice } from '../shared/prices.ts';
import QuickLeadForm from '../components/QuickLeadForm.astro';
const content = renderPriceToken("<!-- Schema.org JSON-LD -->\n\n  <!-- Hero Sub -->\n  <section class=\"hero hero-sub\">\n    <div class=\"hero-bg\"></div>\n    <div class=\"container\">\n      <div class=\"hero-content\">\n        <h1 class=\"anim\">Услуги и <strong class=\"accent\">цены</strong></h1>\n        <p class=\"hero-subtitle anim anim-delay-1\">Прозрачное ценообразование. Без скрытых платежей. Оплата только за результат.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Tabs Section -->\n  <section class=\"section bg-inner-scene bg-services-scene\">\n    <div class=\"container tabs-container\">\n      <div class=\"tabs-nav anim\">\n        <button class=\"active\" data-tab=\"tab-subscription\">Абонентское</button>\n        <button data-tab=\"tab-single\">Разовые услуги</button>\n        <button data-tab=\"tab-lna\">ЛНА</button>\n        <button data-tab=\"tab-sout\">СОУТ</button>\n        <button data-tab=\"tab-packages\">Комплексные пакеты</button>\n      </div>\n\n      <!-- TAB: Абонентское обслуживание -->\n      <div class=\"tab-content active\" id=\"tab-subscription\">\n        <div class=\"pricing-grid\">\n          <div class=\"card pricing-card anim\">\n            <h3>Старт</h3>\n            <p class=\"pricing-desc\">До 10 сотрудников</p>\n            <div class=\"pricing-price\">{{price:retainer.start}} <span class=\"per\">/мес</span></div>\n            <ul class=\"pricing-features\">\n              <li>Кадровые приказы (приём, увольнение, перевод)</li>\n              <li>Табели учёта рабочего времени</li>\n              <li>Оформление отпусков</li>\n              <li>Ведение журналов по охране труда</li>\n              <li>Трудовые договоры и допсоглашения</li>\n              <li>Сведения о приёме и увольнении в СФР (ЕФС-1)</li>\n              <li>Консультации по трудовому праву</li>\n            </ul>\n            <a href=\"/contact.html\" class=\"btn btn-outline btn-block\">Выбрать</a>\n          </div>\n          <div class=\"card pricing-card featured anim anim-delay-1\">\n            <div class=\"pricing-badge\">Популярный</div>\n            <h3>Бизнес</h3>\n            <p class=\"pricing-desc\">11–30 сотрудников</p>\n            <div class=\"pricing-price\">{{price:retainer.business}} <span class=\"per\">/мес</span></div>\n            <ul class=\"pricing-features\">\n              <li>Всё из тарифа «Старт»</li>\n              <li>СОУТ — организация и сопровождение</li>\n              <li>Воинский учёт</li>\n              <li>Штатное расписание и изменения</li>\n              <li>Графики отпусков</li>\n              <li>Статистическая отчётность в Росстат</li>\n              <li>Бесплатный выезд к клиенту (Ростов-на-Дону)</li>\n            </ul>\n            <a href=\"/contact.html\" class=\"btn btn-primary btn-block\">Выбрать</a>\n          </div>\n          <div class=\"card pricing-card anim anim-delay-2\">\n            <h3>Максимум</h3>\n            <p class=\"pricing-desc\">31–50 сотрудников</p>\n            <div class=\"pricing-price\">{{price:retainer.max}} <span class=\"per\">/мес</span></div>\n            <ul class=\"pricing-features\">\n              <li>Всё из тарифа «Бизнес»</li>\n              <li>Полное кадровое сопровождение</li>\n              <li>Разработка и актуализация ЛНА</li>\n              <li>Подготовка к проверкам ГИТ</li>\n              <li>Оформление иностранных работников</li>\n              <li>Медосмотры, СИЗ, охрана труда</li>\n              <li>Приоритетная поддержка</li>\n            </ul>\n            <a href=\"/contact.html\" class=\"btn btn-outline btn-block\">Выбрать</a>\n          </div>\n        </div>\n        <div class=\"text-center mt-32 anim\">\n          <p class=\"text-muted\">Нужен тариф для штата 50+ сотрудников? <a href=\"/contact.html\">Свяжитесь для индивидуального расчёта</a></p>\n          <p class=\"text-muted\">Воинский учёт можно подключить к тарифу «Старт» — стоимость зависит от числа военнообязанных. <a href=\"/contact.html\">Запросить расчёт</a></p>\n        </div>\n      </div>\n\n      <!-- TAB: Разовые услуги -->\n      <div class=\"tab-content\" id=\"tab-single\">\n        <h3 class=\"mb-24\" style=\"font-weight:300;font-size:1.3rem;\">Кадровые события</h3>\n        <div class=\"card mb-32\">\n          <table class=\"data-table\">\n            <thead><tr><th>Услуга</th><th>Цена</th><th>Что входит</th><th></th></tr></thead>\n            <tbody>\n              <tr><td>Приём на работу</td><td class=\"price-cell\">{{price:services.hire}}</td><td class=\"note-cell\">Трудовой договор, приказ, ЛНА</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Увольнение</td><td class=\"price-cell\">{{price:services.dismissal}}</td><td class=\"note-cell\">Расчёт, приказ, запись в ТК</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Перевод</td><td class=\"price-cell\">{{price:services.transfer}}</td><td class=\"note-cell\">Допсоглашение, приказ</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Приём иностранца + уведомление МВД</td><td class=\"price-cell\">{{price:services.foreign-worker}}</td><td class=\"note-cell\">Полный пакет документов</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n            </tbody>\n          </table>\n        </div>\n\n        <h3 class=\"mb-24\" style=\"font-weight:300;font-size:1.3rem;\">Отпуска</h3>\n        <div class=\"card mb-32\">\n          <table class=\"data-table\">\n            <thead><tr><th>Услуга</th><th>Цена</th><th>Что входит</th><th></th></tr></thead>\n            <tbody>\n              <tr><td>Ежегодный оплачиваемый отпуск</td><td class=\"price-cell\">{{price:services.vacation}}/чел</td><td class=\"note-cell\">Приказ, заявление, график</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Отпуск без сохранения з/п</td><td class=\"price-cell\">{{price:services.unpaid-leave}}/чел</td><td class=\"note-cell\">Оформление</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Декретный отпуск</td><td class=\"price-cell\">{{price:services.maternity}}</td><td class=\"note-cell\">Весь пакет документов</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n            </tbody>\n          </table>\n        </div>\n\n        <h3 class=\"mb-24\" style=\"font-weight:300;font-size:1.3rem;\">Документы, аудит, подбор</h3>\n        <div class=\"card mb-32\">\n          <table class=\"data-table\">\n            <thead><tr><th>Услуга</th><th>Цена</th><th>Что входит</th><th></th></tr></thead>\n            <tbody>\n              <tr><td>Дополнительное соглашение</td><td class=\"price-cell\">{{price:services.amendment}}</td><td class=\"note-cell\">Любые изменения условий</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Трудовой договор</td><td class=\"price-cell\">{{price:services.employment-contract}}</td><td class=\"note-cell\">С учётом рисков</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Штатное расписание (Т-3)</td><td class=\"price-cell\">{{price:services.staffing-table}}</td><td class=\"note-cell\">Включая изменения</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>График отпусков</td><td class=\"price-cell\">{{price:services.vacation-schedule}}</td><td class=\"note-cell\">Годовой</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Табель учёта рабочего времени (до 30 чел)</td><td class=\"price-cell\">{{price:services.timesheet}}/мес</td><td class=\"note-cell\">Ведение</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Журналы по охране труда (комплект)</td><td class=\"price-cell\">{{price:services.ohs-logs}}</td><td class=\"note-cell\">Оформление + ведение</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Аудит кадрового учёта</td><td class=\"price-cell\">от {{price:audit.express}}</td><td class=\"note-cell\">Выявление рисков</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Подготовка к проверке ГИТ</td><td class=\"price-cell\">{{price:audit.git_prep}}</td><td class=\"note-cell\">Аудит + устранение нарушений</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Подготовка к проверке военкомата</td><td class=\"price-cell\">{{price:audit.military_prep}}</td><td class=\"note-cell\">Воинский учёт</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Подбор персонала (закрытие вакансии)</td><td class=\"price-cell\">{{price:services.recruitment}}</td><td class=\"note-cell\">Или 50% от оклада</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Консультация (1 час)</td><td class=\"price-cell\">{{price:consult.hour}}</td><td class=\"note-cell\">Онлайн</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n              <tr><td>Выезд к клиенту (разово)</td><td class=\"price-cell\">{{price:services.visit}}</td><td class=\"note-cell\">В черте Ростова</td><td><a href=\"/contact.html\" class=\"btn btn-outline btn-sm\">Заказать</a></td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      <!-- TAB: ЛНА -->\n      <div class=\"tab-content\" id=\"tab-lna\">\n        <div class=\"section-header\" style=\"margin-bottom:40px;\">\n          <h2 style=\"font-size:1.5rem;\">Локальные нормативные <strong>акты</strong></h2>\n          <p>Индивидуальная разработка под специфику вашей компании — не шаблоны из интернета</p>\n        </div>\n        <div class=\"services-grid\">\n          <div class=\"card card-accent service-card\">\n            <h3>Правила внутреннего трудового распорядка</h3>\n            <p>Индивидуально под компанию</p>\n            <div class=\"service-card-price\">{{price:lna.pvtr}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Положение об оплате труда</h3>\n            <p>Включая премиальную систему</p>\n            <div class=\"service-card-price\">{{price:lna.pay}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Положение о премировании</h3>\n            <p>Критерии и порядок начисления</p>\n            <div class=\"service-card-price\">{{price:lna.bonus}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Положение об аттестации</h3>\n            <p>Порядок проведения, документы</p>\n            <div class=\"service-card-price\">{{price:lna.attestation}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Положение о персональных данных</h3>\n            <p>По ФЗ-152: согласие, политика, обязательства</p>\n            <div class=\"service-card-price\">{{price:lna.personal-data}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Регламент кадрового делопроизводства</h3>\n            <p>Описание всех процессов, сроков, ответственности</p>\n            <div class=\"service-card-price\">{{price:lna.hr-regulation}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Положение о командировках</h3>\n            <p>Порядок оформления и возмещения</p>\n            <div class=\"service-card-price\">{{price:lna.business-trips}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Положение о конфиденциальности</h3>\n            <p>Коммерческая тайна, NDA</p>\n            <div class=\"service-card-price\">{{price:lna.nda}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Должностная инструкция</h3>\n            <p>Индивидуальная разработка, не шаблон</p>\n            <div class=\"service-card-price\">{{price:lna.job-description}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Инструкция по охране труда</h3>\n            <p>По должности</p>\n            <div class=\"service-card-price\">{{price:lna.ohs-instruction}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Программа адаптации</h3>\n            <p>С чек-листами и графиком</p>\n            <div class=\"service-card-price\">{{price:lna.adaptation}}</div>\n          </div>\n          <div class=\"card card-accent service-card\">\n            <h3>Положение о противодействии коррупции</h3>\n            <p>Обязательный документ</p>\n            <div class=\"service-card-price\">{{price:lna.anti-corruption}}</div>\n          </div>\n        </div>\n\n        <div class=\"mt-48 templates-cross\">\n          <h3 style=\"font-weight:300;font-size:1.3rem;text-align:center;margin-bottom:8px;\">Шаблоны и формы</h3>\n          <p style=\"color:var(--text-secondary);text-align:center;max-width:640px;margin:0 auto 24px;\">\n            Готовые кадровые документы — в отдельном каталоге. Единая сетка цен действует по всему сайту,\n            никаких «пакетов за 5 000 ₽» здесь больше нет.\n          </p>\n          <div class=\"card templates-cross-card\">\n            <div class=\"templates-cross-grid\">\n              <div class=\"templates-cross-item\">\n                <div class=\"templates-cross-value\">20</div>\n                <div class=\"templates-cross-label\">базовых шаблонов<br><b>бесплатно</b></div>\n              </div>\n              <div class=\"templates-cross-item\">\n                <div class=\"templates-cross-value\">25</div>\n                <div class=\"templates-cross-label\">шаблонов<br><b>за подписку (email)</b></div>\n              </div>\n              <div class=\"templates-cross-item\">\n                <div class=\"templates-cross-value\">{{price:templates.single}}</div>\n                <div class=\"templates-cross-label\">один платный<br><b>шаблон</b></div>\n              </div>\n              <div class=\"templates-cross-item templates-cross-item--accent\">\n                <div class=\"templates-cross-value\">{{price:templates.bundle-64}}</div>\n                <div class=\"templates-cross-label\">полный пакет<br><b>все 64 документа</b></div>\n              </div>\n            </div>\n            <a href=\"/shablony.html\" class=\"btn btn-primary btn-block btn-lg templates-cross-btn\">Открыть каталог шаблонов →</a>\n          </div>\n        </div>\n      </div>\n\n      <!-- TAB: СОУТ -->\n      <div class=\"tab-content\" id=\"tab-sout\">\n        <div class=\"grid-2\">\n          <div>\n            <h3 style=\"font-weight:300;font-size:1.5rem;margin-bottom:24px;\">Специальная оценка условий труда</h3>\n            <p style=\"color:var(--text-secondary);margin-bottom:32px;\">Организация и сопровождение СОУТ: от подбора аккредитованной лаборатории и подготовки документов до декларации в ГИТ. Обязательна для всех работодателей. Услуги аккредитованной лаборатории (замеры и отчёт) оплачиваются отдельно — по договору заказчика с лабораторией.</p>\n            <div class=\"card mb-24\">\n              <table class=\"data-table\">\n                <tbody>\n                  <tr><td>До 10 рабочих мест</td><td class=\"price-cell\">{{price:sout.up-to-10}}</td><td class=\"note-cell\">Организация и сопровождение</td></tr>\n                  <tr><td>11–30 рабочих мест</td><td class=\"price-cell\">{{price:sout.from-11-to-30}}</td><td class=\"note-cell\">Организация и сопровождение</td></tr>\n                  <tr><td>Свыше 30 рабочих мест</td><td class=\"price-cell\">Индивидуально</td><td class=\"note-cell\"><a href=\"/contact.html\">Запросить расчёт</a></td></tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n          <div class=\"card\" style=\"align-self:start;\">\n            <h4 style=\"margin-bottom:16px;font-weight:600;\">Этапы проведения СОУТ</h4>\n            <div class=\"pvs-item\"><span class=\"pvs-icon good\">1</span><p>Формирование комиссии и перечня рабочих мест</p></div>\n            <div class=\"pvs-item\"><span class=\"pvs-icon good\">2</span><p>Идентификация вредных и опасных факторов</p></div>\n            <div class=\"pvs-item\"><span class=\"pvs-icon good\">3</span><p>Проведение измерений и исследований</p></div>\n            <div class=\"pvs-item\"><span class=\"pvs-icon good\">4</span><p>Оформление результатов, подготовка отчёта</p></div>\n            <div class=\"pvs-item\"><span class=\"pvs-icon good\">5</span><p>Подача декларации в ГИТ</p></div>\n            <div class=\"pvs-item\"><span class=\"pvs-icon good\">6</span><p>Ознакомление работников с результатами</p></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- TAB: Комплексные пакеты -->\n      <div class=\"tab-content\" id=\"tab-packages\">\n        <div class=\"section-header\" style=\"margin-bottom:40px;\">\n          <h2 style=\"font-size:1.5rem;\">Комплексные <strong>пакеты ЛНА</strong></h2>\n          <p>Выгоднее, чем заказывать документы по отдельности</p>\n        </div>\n        <div class=\"packages-grid\">\n          <div class=\"card package-card anim\">\n            <h3>Минимальный</h3>\n            <div class=\"package-price\">{{price:lna.bundle-min}}</div>\n            <div class=\"package-saving\">Экономия 4 000 ₽</div>\n            <ul class=\"package-includes\">\n              <li>Правила внутреннего трудового распорядка (ПВТР)</li>\n              <li>Положение об оплате труда</li>\n              <li>3 должностные инструкции</li>\n            </ul>\n            <a href=\"/contact.html\" class=\"btn btn-outline btn-block\">Заказать пакет</a>\n          </div>\n          <div class=\"card package-card featured anim anim-delay-1\">\n            <div class=\"pricing-badge\">Оптимальный</div>\n            <h3>Стандартный</h3>\n            <div class=\"package-price\">{{price:lna.bundle-standard}}</div>\n            <div class=\"package-saving\">Экономия 7 000 ₽</div>\n            <ul class=\"package-includes\">\n              <li>Всё из пакета «Минимальный»</li>\n              <li>Регламент кадрового делопроизводства</li>\n              <li>Положение о персональных данных</li>\n              <li>Пакет шаблонов кадровых документов — базовая подборка из <a href=\"/shablony.html\">каталога шаблонов</a></li>\n            </ul>\n            <a href=\"/contact.html\" class=\"btn btn-primary btn-block\">Заказать пакет</a>\n          </div>\n          <div class=\"card package-card anim anim-delay-2\">\n            <h3>Полный</h3>\n            <div class=\"package-price\">{{price:lna.bundle-full}}</div>\n            <div class=\"package-saving\">Индивидуальный расчёт для штатов 50+</div>\n            <ul class=\"package-includes\">\n              <li>Все локальные нормативные акты</li>\n              <li>Все шаблоны и формы</li>\n              <li>Адаптация под специфику компании</li>\n              <li>Программа адаптации новых сотрудников</li>\n              <li>Регламенты и инструкции</li>\n            </ul>\n            <a href=\"/contact.html\" class=\"btn btn-outline btn-block\">Заказать пакет</a>\n          </div>\n        </div>\n      </div>\n\n    </div><!-- /.tabs-container -->\n  </section>\n\n  <!-- CTA -->\n  <section class=\"section cta-section\">\n    <div class=\"container\">\n      <div class=\"cta-inner anim\">\n        <h2>Не нашли нужное?</h2>\n        <p>Опишите вашу задачу — я подготовлю индивидуальное предложение с точной стоимостью и сроками</p>\n        <a href=\"/contact.html\" class=\"btn btn-primary btn-lg\">Запросить расчёт</a>\n      </div>\n    </div>\n  </section>\n");
---

<Base
  title={"Услуги и цены — Кадровый аутсорсинг Мария Перепечай"}
