import Base from '../layouts/Base.astro';
const content = "<!-- Стили страницы: специфичные для trudovoy-spor.html -->\n\n<!-- Прелоадер -->\n\n<!-- ======================================================\n     НАВИГАЦИЯ\n====================================================== -->\n\n<!-- Мобильное меню -->\n\n<!-- ======================================================\n     HERO СТАТЬИ\n====================================================== -->\n<section class=\"article-hero\">\n  <div class=\"hero-bg\"></div>\n  <div class=\"hero-grid\"></div>\n  <div class=\"container\">\n\n    <!-- Хлебные крошки -->\n    <nav class=\"breadcrumb\" aria-label=\"Хлебные крошки\">\n      <a href=\"/\">Главная</a>\n      <span aria-hidden=\"true\">→</span>\n      <span>Трудовой спор: личная история</span>\n    </nav>\n\n    <!-- Мета-информация статьи -->\n    <div class=\"article-meta anim\">\n      <span class=\"article-category-tag\">⚖️ Трудовые споры</span>\n      <span class=\"article-date\">📅 2025 год</span>\n      <span class=\"article-read-time\">⏱️ 18–22 минуты чтения</span>\n    </div>\n\n    <!-- Заголовок -->\n    <h1 class=\"anim anim-delay-1\">\n      «Мне сказали: <strong class=\"accent\">«Пиши по собственному»</strong>».<br>\n      Я ответила: <strong>нет</strong>\n    </h1>\n\n    <!-- Подзаголовок -->\n    <p class=\"article-subtitle anim anim-delay-2\">\n      История о том, как начальник отдела кадров почти два месяца сражалась с работодателем — и победила. Пошаговая инструкция защиты при <strong>незаконном увольнении</strong>, принудительном давлении и незаконных дисциплинарных взысканиях.\n    </p>\n\n    <!-- Дисклеймер -->\n    <div class=\"article-disclaimer anim anim-delay-2\">\n      <span class=\"article-disclaimer-icon\">📌</span>\n      <span>Эта статья написана от первого лица. Все даты, суммы и факты реальны. Названия, имена и наименования изменены или опущены. Цель одна — показать вам: <strong>работодатель не всесилен. Закон сильнее.</strong></span>\n    </div>\n\n    <!-- Победные цифры -->\n    <div class=\"article-wins anim anim-delay-3\">\n      <div class=\"article-win-item\">\n        <span class=\"article-win-number\" data-count=\"47\">0</span>\n        <div class=\"article-win-label\">дней борьбы</div>\n      </div>\n      <div class=\"article-win-item\">\n        <span class=\"article-win-number\">300 000 ₽</span>\n        <div class=\"article-win-label\">компенсация</div>\n      </div>\n      <div class=\"article-win-item\">\n        <span class=\"article-win-number\" data-count=\"7\">0</span>\n        <div class=\"article-win-label\">статей ТК применено</div>\n      </div>\n      <div class=\"article-win-item\">\n        <span class=\"article-win-number\" data-count=\"0\">0</span>\n        <div class=\"article-win-label\">адвокатов нанято</div>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<!-- ======================================================\n     ОСНОВНОЙ КОНТЕНТ СТАТЬИ\n====================================================== -->\n<div class=\"container\">\n  <div class=\"article-layout\">\n\n    <!-- === БОКОВОЕ ОГЛАВЛЕНИЕ === -->\n    <aside class=\"article-toc anim\">\n      <div class=\"article-toc-title\">📋 Содержание</div>\n      <ul class=\"article-toc-list\">\n        <li><a href=\"#prolog\">Пролог. Пятница</a></li>\n        <li><a href=\"#chapter1\">Глава 1. Больничный и аудит</a></li>\n        <li><a href=\"#chapter2\">Глава 2. Тотальная блокада</a></li>\n        <li><a href=\"#chapter3\">Глава 3. Провокации</a></li>\n        <li><a href=\"#chapter4\">Глава 4. Выговор и ответный удар</a></li>\n        <li><a href=\"#chapter5\">Глава 5. Прокуратура ответила</a></li>\n        <li><a href=\"#final\">Финал. Соглашение</a></li>\n        <li><a href=\"#timeline\">Хронология событий</a></li>\n        <li><a href=\"#principles\">Три принципа победы</a></li>\n        <li><a href=\"#risk-check\">Оцените свой риск</a></li>\n        <li><a href=\"#instruction\">Пошаговая инструкция</a></li>\n        <li><a href=\"#calculator\">Калькулятор компенсации</a></li>\n        <li><a href=\"#statistics\">Статистика</a></li>\n        <li><a href=\"#faq\">Частые вопросы</a></li>\n        <li><a href=\"#laws\">Ключевые законы</a></li>\n        <li><a href=\"#postscript\">Послесловие</a></li>\n      </ul>\n\n      <!-- Боковой CTA -->\n      <div class=\"article-toc-cta\">\n        <p>Попали в похожую ситуацию? Получите консультацию специалиста</p>\n        <a href=\"/contact\" class=\"btn btn-primary btn-sm btn-block\" onclick=\"if(typeof ym!=='undefined')ym(108237323,'reachGoal','article_sidebar_cta')\">\n          Получить помощь →\n        </a>\n      </div>\n    </aside>\n\n    <!-- === ОСНОВНОЙ ТЕКСТ СТАТЬИ === -->\n    <main class=\"article-content\" id=\"article-main\">\n\n      <!-- ======================================\n           ПРОЛОГ\n      ====================================== -->\n      <h2 id=\"prolog\" class=\"anim\">Пролог. Пятница. Обычный день, который перевернул всё</h2>\n\n      <p class=\"anim\">Был обычный сентябрьский день. Я сидела за своим рабочим столом — начальник отдела кадров, человек, который по роду службы знает <strong>трудовое законодательство</strong> лучше многих. И именно поэтому то, что произошло дальше, я поначалу не могла воспринять всерьёз.</p>\n\n      <p class=\"anim\">Зашёл руководитель. Без предисловий, без объяснений причин — просто произнёс фразу, которую я запомню надолго:</p>\n\n      <!-- Цитата руководителя -->\n      <div class=\"article-quote anim\">\n        <p>— Напишите заявление по собственному.</p>\n        <div class=\"article-quote-author\">Слова руководителя. Без объяснений. Без причин.</div>\n      </div>\n\n      <p class=\"anim\">Не «мы вынуждены сократить отдел», не «у нас финансовые трудности», не «вы нам не подходите». Просто — напишите. И уйдите.</p>\n\n      <p class=\"anim\">Я написала. Под давлением, в тот же день. Но уже через два дня я <strong>отозвала это заявление</strong> — совершенно законно, опираясь на часть 4 статьи 80 Трудового кодекса РФ: работник вправе отозвать своё заявление об увольнении в любой момент до истечения срока предупреждения, если приказ об увольнении не был издан. Приказа не было. Я была в своём праве.</p>\n\n      <p class=\"anim\">Именно с этого момента и началась <strong>война</strong>.</p>\n\n      <!-- ======================================\n           ГЛАВА 1\n      ====================================== -->\n      <h2 id=\"chapter1\" class=\"anim\">Глава первая. Больничный. И — аудит</h2>\n\n      <p class=\"anim\">Вскоре после отзыва заявления я заболела и ушла на больничный. Казалось бы — обычная история. Но пока я лежала с температурой, в офисе шла активная работа. Только не производственная.</p>\n\n      <p class=\"anim\">На моём рабочем месте появился другой человек. В мой кабинет, где хранились личные дела, трудовые книжки и сейф, — зашли чужие люди. А 23 сентября, пока я официально болела, был проведён внеплановый <strong>«кадровый аудит»</strong>.</p>\n\n      <p class=\"anim\">Вдумайтесь: проверку моей работы провели в моё отсутствие. Без меня. Не дав мне возможности ни присутствовать, ни давать пояснения, ни защищаться. Это всё равно что судить человека заочно, даже не вызвав его в суд.</p>\n\n      <p class=\"anim\">И — что особенно цинично — аудит провела сотрудница, которая в этот момент <em>занимала мою должность</em>. Человек, кровно заинтересованный в результате проверки, стал её автором и исполнителем.</p>\n\n      <p class=\"anim\">Это называется <strong>конфликт интересов</strong>. В нормальной процедуре такого не бывает. Здесь — было.</p>\n\n      <p class=\"anim\">В первый день после больничного, ещё в коридоре, меня перехватили и сообщили: в свой кабинет я больше не войду. Там теперь сидит другой человек. Мне указали на другое помещение — без моих документов, без сейфа, без ключей, без подключённого компьютера.</p>\n\n      <p class=\"anim\">Это был день икс. День, когда я поняла: началась не производственная история. <strong>Началось уничтожение.</strong></p>\n\n      <!-- ======================================\n           ГЛАВА 2\n      ====================================== -->\n      <h2 id=\"chapter2\" class=\"anim\">Глава вторая. Тотальная блокада</h2>\n\n      <p class=\"anim\">То, что последовало дальше, я могу описать одним словом — <strong>осада</strong>.</p>\n\n      <p class=\"anim\">У меня не было:</p>\n\n      <ul class=\"article-list anim\">\n        <li><span class=\"article-list-icon\">✗</span> доступа к программе 1С, где хранятся все кадровые данные</li>\n        <li><span class=\"article-list-icon\">✗</span> доступа к корпоративной электронной почте</li>\n        <li><span class=\"article-list-icon\">✗</span> доступа к принтеру и сканеру</li>\n        <li><span class=\"article-list-icon\">✗</span> ключей от сейфа с трудовыми книжками</li>\n        <li><span class=\"article-list-icon\">✗</span> рабочего места в кабинете отдела кадров</li>\n      </ul>\n\n      <p class=\"anim\">Мне дали стол в другом кабинете и компьютер, не подключённый к локальной сети. Функционально бесполезный прямоугольник.</p>\n\n      <p class=\"anim\">Я приходила на работу каждое утро. Садилась. И не могла сделать ничего из того, что входит в мои прямые обязанности. Потому что все инструменты для работы были у других людей.</p>\n\n      <p class=\"anim\"><strong>Статья 22 Трудового кодекса РФ</strong> прямо обязывает работодателя обеспечивать работника всем необходимым для исполнения трудовых обязанностей. Эта норма нарушалась каждый день. Систематически. Умышленно.</p>\n\n      <p class=\"anim\">Но молчать я не собиралась.</p>\n\n      <p class=\"anim\">Я начала писать. Каждый день — докладные записки на имя директора. Фиксировала: доступа нет, работать невозможно, прошу устранить. Секретариат поначалу их принимал. Потом перестал — сослался на устное указание руководства.</p>\n\n      <p class=\"anim\">Тогда я начала ходить на почту. Каждый день. За свои деньги. Отправляла письма заказными отправлениями с уведомлением — чтобы было доказательство получения. Это не метафора про стойкость характера. Это буквально: <strong>я тратила личные деньги, чтобы зафиксировать нарушения работодателя</strong> в отношении меня.</p>\n\n      <!-- ======================================\n           ГЛАВА 3\n      ====================================== -->\n      <h2 id=\"chapter3\" class=\"anim\">Глава третья. Провокации</h2>\n\n      <p class=\"anim\">Разобравшись, что уволить меня просто так не получится, работодатель перешёл к следующей тактике — <strong>провокационным поручениям</strong>.</p>\n\n      <p class=\"anim\">Схема элементарна: дать задание, выполнение которого технически невозможно в созданных условиях, а потом наказать за неисполнение.</p>\n\n      <h3 class=\"anim\">Поручение первое</h3>\n      <p class=\"anim\">Восстановить отсутствующие дополнительные соглашения к трудовым договорам — без доступа к 1С, где хранятся актуальные данные об окладах. Срок — несколько дней. Я написала развёрнутый профессиональный отказ: составление финансовых документов на основе непроверенных данных приведёт к ошибкам в начислении зарплаты, претензиям налоговой и реальному ущербу для компании. <strong>Я не саботирую — я предотвращаю вред.</strong></p>\n\n      <h3 class=\"anim\">Поручение второе</h3>\n      <p class=\"anim\">Оформить трудовые договоры с тремя сотрудниками. Срок — один рабочий день. Я выполнила — по предоставленному образцу. Но зафиксировала в служебной записке: образец устаревший, актуальный мне не дали, качество документов под вопросом — по вине работодателя.</p>\n\n      <h3 class=\"anim\">Поручение третье — самое абсурдное</h3>\n      <p class=\"anim\">Заархивировать кадровые документы за целый год. Срок — пять рабочих дней. Когда я открыла выданный ключ от шкафа, увидела следующее: шкаф стоял в коридоре, кадровые и бухгалтерские документы за разные годы свалены вперемешку, папки не подписаны, рабочего места рядом нет.</p>\n\n      <p class=\"anim\">Я написала подробную служебную записку с описанием состояния документов и указанием на нарушение <strong>Федерального закона № 152-ФЗ «О персональных данных»</strong> — работать с личными данными сотрудников в проходном коридоре недопустимо.</p>\n\n      <p class=\"anim\">Любопытная деталь: получив мой мотивированный отказ, работодатель за выходные привёл шкаф в порядок, разложил документы по папкам, убрал бухгалтерские бумаги. Тем самым косвенно признав: <em>я была права. Хаос существовал. Условия были непригодными.</em></p>\n\n      <!-- ======================================\n           ГЛАВА 4\n      ====================================== -->\n      <h2 id=\"chapter4\" class=\"anim\">Глава четвёртая. Выговор. И ответный удар</h2>\n\n      <p class=\"anim\">Всё шло к тому, что должно было прийти: 22 октября мне вручили акт служебного расследования и приказ о <strong>дисциплинарном взыскании — выговор</strong>.</p>\n\n      <p class=\"anim\">В качестве оснований — неисполнение тех самых провокационных поручений. Нарушения должностной инструкции. Многочисленные претензии коллег.</p>\n\n      <p class=\"anim\">Я взяла акт расследования, провела его детальный анализ и направила работодателю официальное <strong>возражение на приказ о взыскании</strong>. Вот ключевые доводы:</p>\n\n      <p class=\"anim\"><strong>Первое.</strong> Аудит, ставший основой расследования, проводился в период моего больничного — без моего участия, без возможности защититься. Это грубейшее нарушение процессуальных гарантий.</p>\n\n      <p class=\"anim\"><strong>Второе.</strong> Запрошенные мной документы для дачи объяснений так и не были предоставлены. Требование от 30 сентября осталось без ответа. Нельзя наказывать человека, которому не дали возможности объясниться.</p>\n\n      <p class=\"anim\"><strong>Третье.</strong> Взыскание наложено за невыполнение поручений, которые сам работодатель сделал невозможными — заблокировав доступ к инструментам работы. Об этом он сам написал в своём уведомлении от 7 октября.</p>\n\n      <p class=\"anim\"><strong>Четвёртое.</strong> С должностной инструкцией, нарушения которой мне вменяются, я никогда не была ознакомлена в установленном порядке. Моей подписи на этом документе нет. По статье 68 ТК РФ именно работодатель обязан ознакомить работника с должностной инструкцией. <em>Нельзя нарушить то, о существовании чего тебя официально не уведомили.</em></p>\n\n      <p class=\"anim\"><strong>Пятое.</strong> Часть вменяемых нарушений относится к маю-августу. Значит, работодатель знал о них ещё тогда — и пропустил месячный срок для наложения взыскания, установленный <strong>статьёй 193 ТК РФ</strong>.</p>\n\n      <p class=\"anim\">Параллельно с возражением я направила жалобы в <strong>Государственную инспекцию труда</strong> и <strong>прокуратуру</strong>. С подробным изложением всей цепочки событий, со всеми приложениями, с хронологией.</p>\n\n      <!-- ======================================\n           ГЛАВА 5\n      ====================================== -->\n      <h2 id=\"chapter5\" class=\"anim\">Глава пятая. Прокуратура ответила</h2>\n\n      <p class=\"anim\">14 ноября пришёл ответ из прокуратуры.</p>\n\n      <!-- Официальная цитата -->\n      <div class=\"article-quote-official anim\">\n        <p>«Установлено, что приказ о применении дисциплинарного взыскания в виде выговора от 22.10.2025 вынесен в нарушении норм трудового законодательства, в связи с чем прокуратурой района принесён протест».</p>\n        <div class=\"article-quote-official-source\">📋 Официальный ответ прокуратуры района · Ноябрь 2025</div>\n      </div>\n\n      <p class=\"anim\"><strong>Протест прокуратуры</strong> — это официальный акт надзорного органа, констатирующий незаконность действий работодателя. Это не мнение. Это правовая позиция государства.</p>\n\n      <p class=\"anim\">Всё. <strong class=\"accent\">Выговор рухнул.</strong></p>\n\n      <p class=\"anim\">В тот же день я направила работодателю требование об отмене незаконного приказа о выговоре и прекращении второго служебного расследования — которое было инициировано уже после первого, на основании того же незаконного акта. Раз основание ничтожно — ничтожно и всё, что из него вытекает.</p>\n\n      <p class=\"anim\">А через несколько дней — предложение о расторжении трудового договора по соглашению сторон.</p>\n\n      <!-- ======================================\n           ФИНАЛ\n      ====================================== -->\n      <h2 id=\"final\" class=\"anim\">Финал. Соглашение</h2>\n\n      <p class=\"anim\">Работодатель согласился.</p>\n\n      <p class=\"anim\">Мы подписали соглашение о расторжении трудового договора по <strong>пункту 1 части 1 статьи 77 ТК РФ</strong> — по взаимному согласию сторон. Чистая запись в трудовой книжке. Полный расчёт. <strong class=\"accent\">Компенсация — 300 000 рублей.</strong></p>\n\n      <p class=\"anim\">Почему не больше? Потому что я сознательно выбрала определённость вместо судебной неизвестности.</p>\n\n      <p class=\"anim\">Могла ли я выиграть больше через суд? Да. Дело было беспроигрышным. При незаконном увольнении суд восстанавливает на работе и взыскивает средний заработок за всё время вынужденного прогула — каждый день судебного разбирательства увеличивал бы сумму. Плюс компенсация морального вреда. Плюс судебные издержки. С учётом апелляций речь могла идти о значительно большей сумме — и о многих месяцах борьбы.</p>\n\n      <p class=\"anim\">Я выбрала деньги сейчас и возможность двигаться дальше. <strong>Это тоже победа.</strong></p>\n\n      <!-- ======================================\n           ХРОНОЛОГИЯ СОБЫТИЙ (таймлайн)\n      ====================================== -->\n      <h2 id=\"timeline\" class=\"anim\">Хронология: 47 дней противостояния</h2>\n\n      <div class=\"article-timeline anim\">\n\n        <div class=\"timeline-event event-bad\">\n          <div class=\"timeline-dot dot-bad\"></div>\n          <div class=\"timeline-date\">Сентябрь, день 1</div>\n          <h4>Требование написать «по собственному»</h4>\n          <p>Руководитель без объяснений требует написать заявление об увольнении по собственному желанию.</p>\n        </div>\n\n        <div class=\"timeline-event event-neutral\">\n          <div class=\"timeline-dot dot-neutral\"></div>\n          <div class=\"timeline-date\">Сентябрь, день 1</div>\n          <h4>Заявление написано — под давлением</h4>\n          <p>Написала заявление об увольнении в тот же день. Ошибка, которую исправила через двое суток.</p>\n        </div>\n\n        <div class=\"timeline-event event-good\">\n          <div class=\"timeline-dot dot-good\"></div>\n          <div class=\"timeline-date\">Сентябрь, день 3</div>\n          <h4>Заявление отозвано — законно ✓</h4>\n          <p>Отозвала заявление письменно. Основание: ч. 4 ст. 80 ТК РФ. Приказ об увольнении издан не был.</p>\n        </div>\n\n        <div class=\"timeline-event event-bad\">\n          <div class=\"timeline-dot dot-bad\"></div>\n          <div class=\"timeline-date\">23 сентября</div>\n          <h4>Кадровый аудит в период больничного</h4>\n          <p>Пока я официально болела — проведена проверка моей работы. Без меня. Проводила заинтересованная сотрудница.</p>\n        </div>\n\n        <div class=\"timeline-event event-bad\">\n          <div class=\"timeline-dot dot-bad\"></div>\n          <div class=\"timeline-date\">После больничного</div>\n          <h4>Отстранена от кабинета и ресурсов</h4>\n          <p>Нет доступа к 1С, почте, принтеру, сейфу. Получила стол в другом помещении с компьютером без сети.</p>\n        </div>\n\n        <div class=\"timeline-event event-good\">\n          <div class=\"timeline-dot dot-good\"></div>\n          <div class=\"timeline-date\">Ежедневно</div>\n          <h4>Докладные записки и заказные письма ✓</h4>\n          <p>Каждый день фиксирую нарушения письменно. Когда секретариат перестал принимать — хожу на почту за свои деньги.</p>\n        </div>\n\n        <div class=\"timeline-event event-bad\">\n          <div class=\"timeline-dot dot-bad\"></div>\n          <div class=\"timeline-date\">Октябрь</div>\n          <h4>Три провокационных поручения</h4>\n          <p>Задания, невыполнимые без доступа к инструментам. Цель — создать основание для взыскания.</p>\n        </div>\n\n        <div class=\"timeline-event event-good\">\n          <div class=\"timeline-dot dot-good\"></div>\n          <div class=\"timeline-date\">Октябрь</div>\n          <h4>Мотивированные ответы на каждое поручение ✓</h4>\n          <p>Дала письменный профессиональный анализ каждого задания. Зафиксировала невозможность исполнения по вине работодателя.</p>\n        </div>\n\n        <div class=\"timeline-event event-bad\">\n          <div class=\"timeline-dot dot-bad\"></div>\n          <div class=\"timeline-date\">22 октября</div>\n          <h4>Дисциплинарный выговор</h4>\n          <p>Вручён акт служебного расследования и приказ о взыскании. Основания — мнимые нарушения.</p>\n        </div>\n\n        <div class=\"timeline-event event-good\">\n          <div class=\"timeline-dot dot-good\"></div>\n          <div class=\"timeline-date\">После 22 октября</div>\n          <h4>Возражение + жалобы в ГИТ и прокуратуру ✓</h4>\n          <p>Направила официальное возражение (5 доводов), жалобы в Государственную инспекцию труда и прокуратуру.</p>\n        </div>\n\n        <div class=\"timeline-event event-win\">\n          <div class=\"timeline-dot dot-win\"></div>\n          <div class=\"timeline-date\">14 ноября</div>\n          <h4>🏆 Прокуратура: выговор незаконен!</h4>\n          <p>Прокуратура принесла протест на приказ о взыскании. Выговор отменён. Работодатель проиграл.</p>\n        </div>\n\n        <div class=\"timeline-event event-win\">\n          <div class=\"timeline-dot dot-win\"></div>\n          <div class=\"timeline-date\">Конец ноября</div>\n          <h4>🏆 Соглашение: 300 000 ₽ компенсации</h4>\n          <p>Подписано соглашение о расторжении ТД по п.1 ч.1 ст.77 ТК РФ. Чистая запись в трудовой. Полный расчёт.</p>\n        </div>\n\n      </div>\n\n      <!-- ======================================\n           ТРИ ПРИНЦИПА\n      ====================================== -->\n      <h2 id=\"principles\" class=\"anim\">Что я поняла. И что хочу передать вам</h2>\n\n      <p class=\"anim\">Работодатель рассчитывал на одно: что я сломаюсь. Что изоляция, провокации, выговор и непрекращающееся давление заставят меня написать заявление по собственному и тихо уйти.</p>\n\n      <p class=\"anim\">Этого не произошло. Почему?</p>\n\n      <p class=\"anim\">Не потому что я необыкновенный человек. А потому что я знала — и применяла — <strong>три простых принципа</strong>.</p>\n\n      <div class=\"principles-grid\">\n\n        <div class=\"principle-card anim\">\n          <div class=\"principle-number\">01</div>\n          <h3>📝 Всё фиксировать письменно</h3>\n          <p>Каждая докладная записка, каждое возражение, каждая служебная записка — это кирпич в стене вашей защиты. Работодатель может говорить что угодно устно. Но против бумаги с входящим номером и подписью секретаря — бессилен.</p>\n        </div>\n\n        <div class=\"principle-card anim anim-delay-1\">\n          <div class=\"principle-number\">02</div>\n          <h3>⚖️ Знать свои права</h3>\n          <p>Трудовой кодекс написан не только для работодателей. Он написан для вас. Право отозвать заявление. Право требовать документы. Право обратиться в ГИТ и прокуратуру — бесплатно, без адвоката.</p>\n        </div>\n\n        <div class=\"principle-card anim anim-delay-2\">\n          <div class=\"principle-number\">03</div>\n          <h3>📣 Не молчать</h3>\n          <p>Жалобы в надзорные органы — это не «жалобщичество». Это законный инструмент защиты своих прав. Государственная инспекция труда и прокуратура существуют именно для того, чтобы работодатель соблюдал закон.</p>\n        </div>\n\n      </div>\n\n      <!-- ======================================\n           ОЦЕНКА РИСКА (интерактивный блок)\n      ====================================== -->\n      <h2 id=\"risk-check\" class=\"anim\">Оцените свой риск: что происходит с вами?</h2>\n      <p class=\"anim\">Отметьте признаки, которые совпадают с вашей ситуацией. Чем больше галочек — тем выше риск незаконного увольнения и тем срочнее нужно действовать.</p>\n\n      <div class=\"risk-checker anim\">\n        <div class=\"risk-checker-header\">\n          <h3>🔍 Проверьте свою ситуацию</h3>\n          <p>Нажмите на каждый пункт, который относится к вам</p>\n        </div>\n\n        <div class=\"risk-items\" id=\"risk-items\">\n\n          <div class=\"risk-item\" data-weight=\"3\" onclick=\"toggleRisk(this)\">\n            <div class=\"risk-checkbox\"></div>\n            <div class=\"risk-item-text\">\n              <strong>Меня просят написать «по собственному» без объяснения причин</strong>\n              <span>Самый явный признак принудительного увольнения — высокий риск</span>\n            </div>\n          </div>\n\n          <div class=\"risk-item\" data-weight=\"2\" onclick=\"toggleRisk(this)\">\n            <div class=\"risk-checkbox\"></div>\n            <div class=\"risk-item-text\">\n              <strong>У меня нет доступа к рабочим инструментам (ПК, системам, почте)</strong>\n              <span>Нарушение ст. 22 ТК РФ — намеренное создание условий для «невыполнения» обязанностей</span>\n            </div>\n          </div>\n\n          <div class=\"risk-item\" data-weight=\"2\" onclick=\"toggleRisk(this)\">\n            <div class=\"risk-checkbox\"></div>\n            <div class=\"risk-item-text\">\n              <strong>Мне дают заведомо невыполнимые поручения</strong>\n              <span>Провокационная тактика — создание оснований для дисциплинарного взыскания</span>\n            </div>\n          </div>\n\n          <div class=\"risk-item\" data-weight=\"3\" onclick=\"toggleRisk(this)\">\n            <div class=\"risk-checkbox\"></div>\n            <div class=\"risk-item-text\">\n              <strong>Против меня проводится служебное расследование</strong>\n              <span>Требуйте ознакомления с материалами — без этого вы вправе не давать объяснения</span>\n            </div>\n          </div>\n\n          <div class=\"risk-item\" data-weight=\"2\" onclick=\"toggleRisk(this)\">\n            <div class=\"risk-checkbox\"></div>\n            <div class=\"risk-item-text\">\n              <strong>Мне вынесли дисциплинарное взыскание (замечание или выговор)</strong>\n              <span>Первый шаг к увольнению «по статье» — действуйте немедленно</span>\n            </div>\n          </div>\n\n          <div class=\"risk-item\" data-weight=\"1\" onclick=\"toggleRisk(this)\">\n            <div class=\"risk-checkbox\"></div>\n            <div class=\"risk-item-text\">\n              <strong>Коллеги избегают общения, руководство не здоровается</strong>\n              <span>Социальная изоляция — психологическое давление для ускорения «добровольного» ухода</span>\n            </div>\n          </div>\n\n          <div class=\"risk-item\" data-weight=\"2\" onclick=\"toggleRisk(this)\">\n            <div class=\"risk-checkbox\"></div>\n            <div class=\"risk-item-text\">\n              <strong>Меня не допускают к выполнению части обязанностей без объяснений</strong>\n              <span>Незаконное фактическое отстранение — основания в ст. 76 ТК РФ исчерпывающие</span>\n            </div>\n          </div>\n\n          <div class=\"risk-item\" data-weight=\"1\" onclick=\"toggleRisk(this)\">\n            <div class=\"risk-checkbox\"></div>\n            <div class=\"risk-item-text\">\n              <strong>Мне намекают на «соглашение» с выплатой, но не называют сумму</strong>\n              <span>Работодатель хочет уволить без суда — у вас есть рычаги для переговоров</span>\n            </div>\n          </div>\n\n          <div class=\"risk-item\" data-weight=\"3\" onclick=\"toggleRisk(this)\">\n            <div class=\"risk-checkbox\"></div>\n            <div class=\"risk-item-text\">\n              <strong>Меня проверяли в период больничного или отпуска</strong>\n              <span>Грубейшее процессуальное нарушение — любое взыскание может быть отменено</span>\n            </div>\n          </div>\n\n          <div class=\"risk-item\" data-weight=\"1\" onclick=\"toggleRisk(this)\">\n            <div class=\"risk-checkbox\"></div>\n            <div class=\"risk-item-text\">\n              <strong>На моё место уже фактически взяли другого человека</strong>\n              <span>Работодатель сделал ставку — но без вашей подписи уволить не может</span>\n            </div>\n          </div>\n\n        </div>\n\n        <!-- Счётчик -->\n        <div class=\"risk-counter\">\n          <span>Отмечено пунктов:</span>\n          <span id=\"risk-count\">0</span>\n          <span>из 10</span>\n        </div>\n\n        <!-- Результат -->\n        <div class=\"risk-result\" id=\"risk-result\">\n          <div class=\"risk-result-title\" id=\"risk-result-title\"></div>\n          <p id=\"risk-result-text\"></p>\n        </div>\n\n      </div>\n\n      <!-- CTA после оценки риска -->\n      <div class=\"article-cta-block anim\">\n        <h3>Узнали свою ситуацию?<br><strong>Не медлите — время работает против вас</strong></h3>\n        <p>Получите бесплатную консультацию. Расскажу, какие именно шаги предпринять в вашем случае и каковы ваши шансы на успех.</p>\n        <div class=\"article-cta-buttons\">\n          <a href=\"/contact\" class=\"btn btn-primary btn-lg\" onclick=\"if(typeof ym!=='undefined')ym(108237323,'reachGoal','article_cta_consultation')\">\n            Получить бесплатную консультацию →\n          </a>\n          <a href=\"tel:+79613022112\" class=\"btn btn-outline btn-lg\">\n            Позвонить прямо сейчас\n          </a>\n        </div>\n      </div>\n\n      <!-- ======================================\n           ПРАКТИЧЕСКАЯ ИНСТРУКЦИЯ\n      ====================================== -->\n      <h2 id=\"instruction\" class=\"anim\">Практическая инструкция: что делать, если вас пытаются уволить незаконно</h2>\n      <p class=\"anim\">Эта инструкция основана на личном опыте и нормах действующего законодательства.</p>\n\n      <div class=\"instruction-block anim\">\n        <div class=\"instruction-header\">\n          <h2>📋 Пошаговый план действий при незаконном увольнении</h2>\n          <p>7 шагов от первого давления до получения компенсации · Основан на реальном опыте победы</p>\n        </div>\n\n        <div class=\"instruction-steps\">\n\n          <!-- Шаг 1 -->\n          <div class=\"instruction-step\">\n            <div class=\"step-number\">01</div>\n            <div class=\"step-content\">\n              <h3>Если вас принуждают написать заявление по собственному желанию</h3>\n              <p><strong>Не подписывайте ничего под давлением.</strong> Если уже подписали — помните: у вас есть право отозвать заявление до дня увольнения, если приказ не издан.</p>\n              <p>Отзыв направляйте письменно одновременно всеми способами: лично под роспись секретаря, заказным письмом с уведомлением, по корпоративной электронной почте.</p>\n              <div class=\"step-laws\">\n                <span class=\"step-law\">⚖️ Ч. 4 ст. 80 ТК РФ</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Шаг 2 -->\n          <div class=\"instruction-step\">\n            <div class=\"step-content\" style=\"grid-column:2\">\n            </div>\n          </div>\n          <div class=\"instruction-step\">\n            <div class=\"step-number\">02</div>\n            <div class=\"step-content\">\n              <h3>Если вас отстранили от работы или заблокировали доступ к ресурсам</h3>\n              <p><strong>Пишите докладные записки каждый день.</strong> Фиксируйте: чего именно нет, с какой даты, какие функции невозможно выполнять.</p>\n              <p>Работодатель обязан обеспечить вас всем необходимым для работы. Если документы не принимают нарочно — отправляйте заказными письмами. Сохраняйте квитанции и уведомления о вручении.</p>\n              <div class=\"step-laws\">\n                <span class=\"step-law\">⚖️ Ст. 22 ТК РФ</span>\n                <span class=\"step-law\">⚖️ Ст. 76 ТК РФ</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Шаг 3 -->\n          <div class=\"instruction-step\">\n            <div class=\"step-number\">03</div>\n            <div class=\"step-content\">\n              <h3>Если против вас проводят служебное расследование</h3>\n              <p><strong>Не паникуйте.</strong> Потребуйте письменно предоставить все документы расследования для ознакомления. Без них вы вправе не давать объяснения — невозможно объяснить то, чего вы не видели.</p>\n              <p>Обязательно проверьте: не проводилась ли проверка в период вашего больничного или отпуска? Не является ли проверяющий заинтересованным лицом? Это процессуальные нарушения, которые делают всё расследование ничтожным.</p>\n              <div class=\"step-laws\">\n                <span class=\"step-law\">⚖️ Ст. 193 ТК РФ</span>\n                <span class=\"step-law\">⚖️ Ст. 68 ТК РФ</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Шаг 4 -->\n          <div class=\"instruction-step\">\n            <div class=\"step-number\">04</div>\n            <div class=\"step-content\">\n              <h3>Если вам вынесли дисциплинарное взыскание</h3>\n              <p><strong>Немедленно направьте возражение</strong> работодателю в письменной форме. Укажите все нарушения процедуры.</p>\n              <p>Потребуйте заверенные копии всех документов — их обязаны выдать в течение 3 рабочих дней. Параллельно — жалоба в ГИТ. У вас есть 3 месяца с момента ознакомления с приказом.</p>\n              <div class=\"step-laws\">\n                <span class=\"step-law\">⚖️ Ст. 62 ТК РФ</span>\n                <span class=\"step-law\">⚖️ Ст. 392 ТК РФ</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Шаг 5 -->\n          <div class=\"instruction-step\">\n            <div class=\"step-number\">05</div>\n            <div class=\"step-content\">\n              <h3>Жалоба в Государственную инспекцию труда (ГИТ)</h3>\n              <p><strong>Подать жалобу можно онлайн</strong> через сайт Роструд (<em>Онлайнинспекция.рф</em>) — бесплатно, без адвоката, из дома.</p>\n              <p>Опишите факты чётко и хронологически, приложите документы (скан-копии). ГИТ обязана провести проверку и вынести предписание. Работодателям грозят административные штрафы.</p>\n              <div class=\"step-laws\">\n                <span class=\"step-law\">⚖️ Ст. 352 ТК РФ</span>\n                <span class=\"step-law\">⚖️ Ст. 5.27 КоАП РФ</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Шаг 6 -->\n          <div class=\"instruction-step\">\n            <div class=\"step-number\">06</div>\n            <div class=\"step-content\">\n              <h3>Жалоба в прокуратуру</h3>\n              <p>Прокуратура осуществляет надзор за соблюдением законов, в том числе трудовых. <strong>Протест прокурора</strong> — это серьёзный правовой инструмент, который может отменить незаконный приказ.</p>\n              <p>Жалобу можно подать лично, почтой или через официальный сайт прокуратуры вашего региона. Опишите все факты с датами, приложите доказательства.</p>\n              <div class=\"step-laws\">\n                <span class=\"step-law\">⚖️ ФЗ «О прокуратуре РФ»</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Шаг 7 -->\n          <div class=\"instruction-step\">\n            <div class=\"step-number\">07</div>\n            <div class=\"step-content\">\n              <h3>Суд — последний и самый мощный инструмент</h3>\n              <p>Если переговоры зашли в тупик — суд. Иск о восстановлении на работе подаётся в районный суд по месту нахождения работодателя или по вашему месту жительства.</p>\n              <p><strong>Государственная пошлина не уплачивается</strong> — трудовые споры от неё освобождены. При незаконном увольнении суд взыскивает средний заработок за всё время вынужденного прогула, компенсацию морального вреда и судебные расходы.</p>\n              <p>Помните: п. 34, 53 Постановления Пленума ВС РФ от 17.03.2004 № 2 — именно на эти разъяснения ссылаются суды при рассмотрении трудовых споров.</p>\n              <div class=\"step-laws\">\n                <span class=\"step-law\">⚖️ Ст. 392 ТК РФ</span>\n                <span class=\"step-law\">⚖️ Ст. 394 ТК РФ</span>\n                <span class=\"step-law\">⚖️ Пленум ВС РФ № 2</span>\n              </div>\n            </div>\n          </div>\n\n        </div><!-- /instruction-steps -->\n      </div><!-- /instruction-block -->\n\n      <!-- ======================================\n           КАЛЬКУЛЯТОР КОМПЕНСАЦИИ\n      ====================================== -->\n      <h2 id=\"calculator\" class=\"anim\">Калькулятор: сколько вы можете получить при незаконном увольнении?</h2>\n      <p class=\"anim\">Рассчитайте примерный размер компенсации, которую вправе требовать через суд при незаконном увольнении или незаконном дисциплинарном взыскании.</p>\n\n      <div class=\"compensation-calc anim\">\n        <div class=\"calc-header-article\">\n          <h3>💰 Калькулятор компенсации при незаконном увольнении</h3>\n          <p>Приблизительный расчёт на основе норм ТК РФ · Точную сумму определит суд</p>\n        </div>\n\n        <div class=\"calc-body-article\">\n\n          <!-- Поле: зарплата -->\n          <div class=\"calc-field\">\n            <label>Ваш средний ежемесячный заработок (на руки)</label>\n            <div class=\"calc-value-display\"><span id=\"calc-salary-display\">45 000</span> ₽/мес</div>\n            <input type=\"range\" id=\"calc-salary\" min=\"20000\" max=\"200000\" value=\"45000\" step=\"5000\" aria-label=\"Ваша зарплата\" oninput=\"updateCalc()\">\n          </div>\n\n          <!-- Поле: месяцы спора -->\n          <div class=\"calc-field\">\n            <label>Предполагаемая длительность судебного процесса</label>\n            <div class=\"calc-value-display\"><span id=\"calc-months-display\">6</span> месяцев</div>\n            <input type=\"range\" id=\"calc-months\" min=\"1\" max=\"18\" value=\"6\" step=\"1\" aria-label=\"Длительность спора\" oninput=\"updateCalc()\">\n          </div>\n\n          <!-- Поле: моральный вред -->\n          <div class=\"calc-field\">\n            <label>Компенсация морального вреда (обычно суды присуждают)</label>\n            <div class=\"calc-value-display\"><span id=\"calc-moral-display\">30 000</span> ₽</div>\n            <input type=\"range\" id=\"calc-moral\" min=\"5000\" max=\"100000\" value=\"30000\" step=\"5000\" aria-label=\"Моральный вред\" oninput=\"updateCalc()\">\n          </div>\n\n          <!-- Результаты -->\n          <div class=\"calc-results-article\">\n            <h4>📊 Предварительный расчёт</h4>\n\n            <div class=\"calc-result-row\">\n              <span>Средний заработок за вынужденный прогул</span>\n              <span id=\"calc-lost-salary\">270 000 ₽</span>\n            </div>\n            <div class=\"calc-result-row\">\n              <span>Компенсация морального вреда</span>\n              <span id=\"calc-moral-out\">30 000 ₽</span>\n            </div>\n            <div class=\"calc-result-row\">\n              <span>Госпошлина (платит работодатель)</span>\n              <span style=\"color:var(--accent)\">0 ₽ (для вас)</span>\n            </div>\n            <div class=\"calc-result-row\">\n              <span>Возврат судебных расходов</span>\n              <span id=\"calc-expenses\">~ 15 000 ₽</span>\n            </div>\n\n            <div class=\"calc-result-total\">\n              <span>Итого минимально через суд:</span>\n              <span id=\"calc-total\">315 000 ₽</span>\n            </div>\n\n            <p class=\"calc-disclaimer\">\n              ⚠️ Расчёт является приблизительным и носит информационный характер. Суд определяет размер компенсации индивидуально с учётом всех обстоятельств дела. Реальная сумма может быть как выше, так и ниже.\n            </p>\n          </div>\n\n          <div style=\"text-align:center;margin-top:24px;\">\n            <a href=\"/contact\" class=\"btn btn-primary\" onclick=\"if(typeof ym!=='undefined')ym(108237323,'reachGoal','calc_cta_click')\">\n              Обсудить мою ситуацию бесплатно →\n            </a>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- ======================================\n           СТАТИСТИКА\n      ====================================== -->\n      <h2 id=\"statistics\" class=\"anim\">Трудовые споры в России: реальные цифры</h2>\n\n      <div class=\"article-stats-block anim\">\n        <h3>📊 Статистика трудовых споров · 2023–2025</h3>\n        <div class=\"article-stats-grid\">\n\n          <div class=\"article-stat-item\">\n            <div class=\"article-stat-number\">73%</div>\n            <div class=\"article-stat-label\">дел о незаконном увольнении работники выигрывают в российских судах</div>\n            <div class=\"article-stat-source\">Судебный департамент при ВС РФ</div>\n          </div>\n\n          <div class=\"article-stat-item\">\n            <div class=\"article-stat-number\">200 000 ₽</div>\n            <div class=\"article-stat-label\">максимальный штраф для организации по ст. 5.27 КоАП за нарушение трудового законодательства</div>\n            <div class=\"article-stat-source\">КоАП РФ, актуальная редакция</div>\n          </div>\n\n          <div class=\"article-stat-item\">\n            <div class=\"article-stat-number\">3 мес</div>\n            <div class=\"article-stat-label\">срок исковой давности по большинству трудовых споров — не пропустите!</div>\n            <div class=\"article-stat-source\">Ст. 392 ТК РФ</div>\n          </div>\n\n          <div class=\"article-stat-item\">\n            <div class=\"article-stat-number\">1 мес</div>\n            <div class=\"article-stat-label\">срок для обжалования незаконного увольнения в суде — считается с даты вручения трудовой книжки</div>\n            <div class=\"article-stat-source\">Ст. 392 ТК РФ</div>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- ======================================\n           FAQ\n      ====================================== -->\n      <div class=\"article-faq\">\n        <h2 id=\"faq\" class=\"anim\">Частые вопросы о трудовых спорах</h2>\n\n        <div style=\"max-width:100%;\">\n\n          <div class=\"accordion-item anim\">\n            <button type=\"button\" class=\"accordion-header\" aria-expanded=\"false\">\n              Могу ли я отозвать заявление об увольнении по собственному желанию?\n              <span class=\"accordion-icon\">+</span>\n            </button>\n            <div class=\"accordion-body\">\n              <div class=\"accordion-body-inner\">\n                <strong>Да.</strong> По части 4 статьи 80 ТК РФ работник вправе отозвать своё заявление об увольнении в любой момент до истечения срока предупреждения (14 дней), если приказ об увольнении ещё не был издан. Отзыв оформляйте письменно и обязательно получайте подтверждение вручения — лично под подпись секретаря или заказным письмом с уведомлением. Это был мой первый и главный шаг в истории, которую вы прочитали.\n              </div>\n            </div>\n          </div>\n\n          <div class=\"accordion-item anim anim-delay-1\">\n            <button type=\"button\" class=\"accordion-header\" aria-expanded=\"false\">\n              Что делать, если работодатель проводит служебное расследование в моё отсутствие?\n              <span class=\"accordion-icon\">+</span>\n            </button>\n            <div class=\"accordion-body\">\n              <div class=\"accordion-body-inner\">\n                Это <strong>грубое нарушение процессуальных гарантий</strong>. Потребуйте письменно предоставить все материалы расследования. Факт проведения проверки в период больничного, отпуска или без вашего участия является самостоятельным основанием для признания дисциплинарного взыскания незаконным. Именно этот довод стал ключевым в протесте прокуратуры по моему делу. Обратитесь в ГИТ или прокуратуру незамедлительно.\n              </div>\n            </div>\n          </div>\n\n          <div class=\"accordion-item anim anim-delay-2\">\n            <button type=\"button\" class=\"accordion-header\" aria-expanded=\"false\">\n              Работодатель лишил меня доступа к инструментам работы — это законно?\n              <span class=\"accordion-icon\">+</span>\n            </button>\n            <div class=\"accordion-body\">\n              <div class=\"accordion-body-inner\">\n                <strong>Нет.</strong> Статья 22 ТК РФ прямо обязывает работодателя обеспечивать работника всем необходимым для исполнения трудовых обязанностей. Блокировка доступа к 1С, корпоративной почте, оргтехнике, рабочему месту — это нарушение закона. Важно: если вас лишили инструментов, а потом наказывают за невыполнение обязанностей — это цепочка, которую суд и ГИТ разрывают в пользу работника. Фиксируйте каждый факт письменно.\n              </div>\n            </div>\n          </div>\n\n          <div class=\"accordion-item anim anim-delay-3\">\n            <button type=\"button\" class=\"accordion-header\" aria-expanded=\"false\">\n              Могут ли меня наказать за нарушение должностной инструкции, с которой я не был ознакомлен?\n              <span class=\"accordion-icon\">+</span>\n            </button>\n            <div class=\"accordion-body\">\n              <div class=\"accordion-body-inner\">\n                <strong>Нет.</strong> По статье 68 ТК РФ работодатель обязан ознакомить работника с должностной инструкцией под подпись при приёме на работу. Если вашей подписи нет — нет и юридической обязанности исполнять этот документ. Любое взыскание за его «нарушение» незаконно и может быть обжаловано. Именно этот аргумент я использовала в своём возражении, и он оказался одним из самых весомых.\n              </div>\n            </div>\n          </div>\n\n          <div class=\"accordion-item anim anim-delay-4\">\n            <button type=\"button\" class=\"accordion-header\" aria-expanded=\"false\">\n              Сколько времени есть на обжалование дисциплинарного взыскания?\n              <span class=\"accordion-icon\">+</span>\n            </button>\n            <div class=\"accordion-body\">\n              <div class=\"accordion-body-inner\">\n                По статье 392 ТК РФ: <strong>3 месяца</strong> с момента ознакомления с приказом о взыскании — для обращения в ГИТ и суд. При незаконном увольнении — <strong>1 месяц</strong> со дня вручения трудовой книжки или копии приказа об увольнении. Не пропустите срок: суды, как правило, не восстанавливают его без уважительных причин. Если срок истекает — обращайтесь немедленно, даже без полного комплекта документов.\n              </div>\n            </div>\n          </div>\n\n          <div class=\"accordion-item anim anim-delay-5\">\n            <button type=\"button\" class=\"accordion-header\" aria-expanded=\"false\">\n              Что может получить работник при незаконном увольнении через суд?\n              <span class=\"accordion-icon\">+</span>\n            </button>\n            <div class=\"accordion-body\">\n              <div class=\"accordion-body-inner\">\n                При незаконном увольнении суд (статья 394 ТК РФ): <strong>восстанавливает на работе</strong> или по желанию работника взыскивает компенсацию вместо восстановления; взыскивает <strong>средний заработок за всё время вынужденного прогула</strong>; взыскивает <strong>компенсацию морального вреда</strong>; возмещает <strong>судебные расходы</strong>. Государственная пошлина по трудовым спорам не уплачивается — это льгота для работников.\n              </div>\n            </div>\n          </div>\n\n          <div class=\"accordion-item anim\">\n            <button type=\"button\" class=\"accordion-header\" aria-expanded=\"false\">\n              Стоит ли соглашаться на соглашение сторон вместо суда?\n              <span class=\"accordion-icon\">+</span>\n            </button>\n            <div class=\"accordion-body\">\n              <div class=\"accordion-body-inner\">\n                Зависит от суммы, вашей жизненной ситуации и готовности к долгому процессу. Соглашение сторон даёт: чистую запись в трудовой книжке, деньги сейчас, отсутствие стресса от судебного процесса. Суд может дать больше, но займёт от 3 до 12+ месяцев с учётом апелляций. Я выбрала соглашение — и получила 300 000 ₽ в течение месяца после начала переговоров. Важно: <strong>не подписывайте соглашение, не оценив рыночную стоимость своего иска</strong>. Обратитесь за консультацией.\n              </div>\n            </div>\n          </div>\n\n        </div>\n      </div><!-- /article-faq -->\n\n      <!-- ======================================\n           КЛЮЧЕВЫЕ ЗАКОНЫ\n      ====================================== -->\n      <div class=\"laws-block anim\" id=\"laws\">\n        <div class=\"laws-header\">\n          <span class=\"laws-header-icon\">⚖️</span>\n          <h3>Ключевые нормы, на которые я опиралась</h3>\n        </div>\n        <div class=\"laws-list\">\n\n          <div class=\"law-item\">\n            <div class=\"law-code\">Ст. 80 ТК РФ</div>\n            <div class=\"law-desc\">\n              <strong>Право на отзыв заявления об увольнении</strong>\n              Работник вправе отозвать заявление в любой момент до истечения срока предупреждения, если приказ не издан\n            </div>\n          </div>\n\n          <div class=\"law-item\">\n            <div class=\"law-code\">Ст. 22 ТК РФ</div>\n            <div class=\"law-desc\">\n              <strong>Обязанности работодателя по обеспечению условий труда</strong>\n              Работодатель обязан предоставить работника необходимым оборудованием, инструментами и документацией\n            </div>\n          </div>\n\n          <div class=\"law-item\">\n            <div class=\"law-code\">Ст. 76 ТК РФ</div>\n            <div class=\"law-desc\">\n              <strong>Законные основания для отстранения от работы</strong>\n              Перечень оснований для отстранения исчерпывающий — произвольное отстранение незаконно\n            </div>\n          </div>\n\n          <div class=\"law-item\">\n            <div class=\"law-code\">Ст. 68 ТК РФ</div>\n            <div class=\"law-desc\">\n              <strong>Обязанность ознакомить работника с должностной инструкцией</strong>\n              Ознакомление под подпись при приёме на работу — обязанность работодателя, а не работника\n            </div>\n          </div>\n\n          <div class=\"law-item\">\n            <div class=\"law-code\">Ст. 193 ТК РФ</div>\n            <div class=\"law-desc\">\n              <strong>Порядок применения дисциплинарных взысканий</strong>\n              Месячный срок для наложения взыскания, обязательное объяснение работника, строгая процедура\n            </div>\n          </div>\n\n          <div class=\"law-item\">\n            <div class=\"law-code\">Ст. 392 ТК РФ</div>\n            <div class=\"law-desc\">\n              <strong>Сроки обращения в суд по трудовым спорам</strong>\n              3 месяца по общему правилу; 1 месяц при незаконном увольнении\n            </div>\n          </div>\n\n          <div class=\"law-item\">\n            <div class=\"law-code\">Ст. 62 ТК РФ</div>\n            <div class=\"law-desc\">\n              <strong>Право на получение документов, связанных с работой</strong>\n              Работодатель обязан выдать заверенные копии в течение 3 рабочих дней с момента обращения\n            </div>\n          </div>\n\n          <div class=\"law-item\">\n            <div class=\"law-code\">Ст. 352 ТК РФ</div>\n            <div class=\"law-desc\">\n              <strong>Способы защиты трудовых прав</strong>\n              Самозащита, профсоюзная защита, государственный контроль (ГИТ), судебная защита\n            </div>\n          </div>\n\n          <div class=\"law-item\">\n            <div class=\"law-code\">Ст. 5.27 КоАП</div>\n            <div class=\"law-desc\">\n              <strong>Административная ответственность за нарушение трудового законодательства</strong>\n              Штраф до 200 000 ₽ для организаций; дисквалификация должностных лиц\n            </div>\n          </div>\n\n          <div class=\"law-item\">\n            <div class=\"law-code\">Пленум ВС № 2</div>\n            <div class=\"law-desc\">\n              <strong>Постановление Пленума ВС РФ от 17.03.2004 № 2</strong>\n              Пп. 34, 53 — разъяснения по трудовым спорам, на которые ссылаются все суды страны\n            </div>\n          </div>\n\n        </div>\n      </div><!-- /laws-block -->\n\n      <!-- ======================================\n           ПОСЛЕСЛОВИЕ\n      ====================================== -->\n      <h2 id=\"postscript\" class=\"anim\">Вместо послесловия</h2>\n\n      <div class=\"article-postscript anim\">\n\n        <p>Когда я вспоминаю те недели — ощущение как после долгой болезни. Изматывающей, несправедливой, унизительной. Запрет разговаривать с коллегами. Компьютер без сети. Почта за свои деньги. Ощущение, что ты стоишь у глухой стены, а с другой стороны — корпоративная машина, юристы, приказы и служебные записки.</p>\n\n        <p>Но стена оказалась не такой уж прочной. Потому что с моей стороны был закон.</p>\n\n        <p>Если вы читаете это и узнаёте свою ситуацию — знайте: <strong>вы не одни. И у вас есть инструменты. Они работают.</strong></p>\n\n        <p><strong>Работодатель не всесилен. Он очень уязвим перед законом — если вы знаете, как с этим законом работать.</strong></p>\n\n        <p>Если вам нужна помощь или консультация по трудовым спорам — обратитесь ко мне. Расскажу, оценю вашу ситуацию и подскажу конкретные шаги. Первая консультация — бесплатно.</p>\n\n      </div>\n\n      <!-- Теги статьи -->\n      <div class=\"article-tags anim\">\n        <span class=\"article-tag\">#трудовой_спор</span>\n        <span class=\"article-tag\">#незаконное_увольнение</span>\n        <span class=\"article-tag\">#принудительное_увольнение</span>\n        <span class=\"article-tag\">#дисциплинарное_взыскание</span>\n        <span class=\"article-tag\">#жалоба_в_ГИТ</span>\n        <span class=\"article-tag\">#прокуратура</span>\n        <span class=\"article-tag\">#ТК_РФ</span>\n        <span class=\"article-tag\">#права_работника</span>\n        <span class=\"article-tag\">#служебное_расследование</span>\n        <span class=\"article-tag\">#соглашение_об_увольнении</span>\n      </div>\n\n      <!-- Финальный CTA -->\n      <div class=\"article-cta-block anim\">\n        <h3>Нужна <strong>профессиональная помощь</strong> в трудовом споре?</h3>\n        <p>14 лет опыта в кадровом делопроизводстве. Знаю законы изнутри — как специалист, который сам прошёл через это. Первая консультация бесплатно.</p>\n        <div class=\"article-cta-buttons\">\n          <a href=\"/contact\" class=\"btn btn-primary btn-lg\" onclick=\"if(typeof ym!=='undefined')ym(108237323,'reachGoal','article_final_cta')\">\n            Получить консультацию →\n          </a>\n          <a href=\"tel:+79613022112\" class=\"btn btn-outline btn-lg\">\n            +7 (961) 302-21-12\n          </a>\n        </div>\n      </div>\n\n    </main><!-- /article-content -->\n  </div><!-- /article-layout -->\n</div><!-- /container -->\n\n<!-- ======================================================\n     CTA-СЕКЦИЯ (форма заявки)\n====================================================== -->\n<section class=\"section cta-section\" id=\"contact-form\">\n  <div class=\"container\">\n    <div class=\"contact-grid\">\n      <div class=\"anim\">\n        <h2 style=\"font-size:clamp(1.5rem,3vw,2.2rem);font-weight:300;margin-bottom:16px;\">\n          Попали в похожую <strong>ситуацию?</strong>\n        </h2>\n        <p style=\"color:var(--text-secondary);margin-bottom:32px;\">\n          Расскажите о вашей ситуации — разберём вместе. Я знаю трудовое право изнутри, как специалист и как человек, который сам прошёл через незаконное давление работодателя.\n        </p>\n        <div class=\"contact-info-item\">\n          <div class=\"contact-info-icon\">📞</div>\n          <div>\n            <h4>Телефон</h4>\n            <a href=\"tel:+79613022112\">+7 (961) 302-21-12</a>\n          </div>\n        </div>\n        <div class=\"contact-info-item\">\n          <div class=\"contact-info-icon\">✉️</div>\n          <div>\n            <h4>Email</h4>\n            <a href=\"mailto:m.perepechay@yandex.ru\">m.perepechay@yandex.ru</a>\n          </div>\n        </div>\n        <div class=\"contact-info-item\">\n          <div class=\"contact-info-icon\">🕐</div>\n          <div>\n            <h4>Время ответа</h4>\n            <p style=\"color:var(--text-primary);\">В течение 2 часов в рабочее время</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"anim anim-delay-1\">\n        <form data-lead-form data-page=\"trudovoy-spor\" novalidate>\n              <input type=\"hidden\" name=\"page\" value=\"trudovoy-spor\">\n              <input type=\"hidden\" name=\"source\" value=\"contact-form:trudovoy-spor\">\n              <input type=\"text\" name=\"company_website\" class=\"quick-lead-hp\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\">\n\n          <!-- Скрытое поле: источник обращения -->\n          <input type=\"hidden\" name=\"source\" value=\"trudovoy-spor-page\">\n          <!-- Honeypot-защита от спама -->\n          <input type=\"text\" name=\"_gotcha\" style=\"display:none\" tabindex=\"-1\" autocomplete=\"off\">\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label class=\"form-label\">Ваше имя *</label>\n              <input type=\"text\" name=\"name\" class=\"form-input\" placeholder=\"Иван Иванов\" required=\"\">\n              <span class=\"form-error\">Укажите имя</span>\n            </div>\n            <div class=\"form-group\">\n              <label class=\"form-label\">Телефон *</label>\n              <input type=\"tel\" name=\"phone\" class=\"form-input\" data-mask=\"phone\" placeholder=\"+7 (___) ___-__-__\" required=\"\">\n              <span class=\"form-error\">Укажите корректный телефон</span>\n            </div>\n            <div class=\"form-group\">\n              <label class=\"form-label\">Email</label>\n              <input type=\"email\" name=\"email\" class=\"form-input\" placeholder=\"your@email.ru\">\n              <span class=\"form-error\">Укажите корректный email</span>\n            </div>\n            <div class=\"form-group\">\n              <label class=\"form-label\">Тип вопроса</label>\n              <select name=\"service\" class=\"form-select\">\n                <option value=\"\">Выберите тему</option>\n                <option value=\"illegal_dismissal\">Незаконное увольнение</option>\n                <option value=\"forced_resignation\">Принуждение написать «по собственному»</option>\n                <option value=\"disciplinary\">Дисциплинарное взыскание</option>\n                <option value=\"git_complaint\">Жалоба в ГИТ</option>\n                <option value=\"compensation_calc\">Расчёт компенсации</option>\n                <option value=\"other\">Другой вопрос</option>\n              </select>\n            </div>\n            <div class=\"form-group full\">\n              <label class=\"form-label\">Опишите вашу ситуацию</label>\n              <textarea name=\"message\" class=\"form-textarea\" placeholder=\"Что происходит? С какого момента? Какие документы уже есть?\"></textarea>\n            </div>\n            <div class=\"form-group full\">\n              <label class=\"form-checkbox\">\n                <input type=\"checkbox\" name=\"consent\" required=\"\">\n                Даю согласие на обработку персональных данных в соответствии с <a href=\"/privacy\" target=\"_blank\" style=\"text-decoration:underline;\">политикой конфиденциальности</a>\n              </label>\n            </div>\n            <div class=\"form-group full\">\n              <button type=\"submit\" class=\"btn btn-primary btn-block btn-lg\" onclick=\"if(typeof ym!=='undefined')ym(108237323,'reachGoal','article_form_submit')\">\n                Получить бесплатную консультацию\n              </button>\n            </div>\n          </div>\n        </form>\n        <div class=\"form-success\">\n          <h3>✓ Заявка отправлена!</h3>\n          <p>Свяжусь с вами в течение 2 часов в рабочее время.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ======================================================\n     ФУТЕР\n====================================================== -->\n\n<!-- Фиксированная кнопка звонка (мобильные) -->\n\n<!-- ======================================================\n     СКРИПТЫ\n====================================================== -->\n";
