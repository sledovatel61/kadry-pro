---
import Base from '../layouts/Base.astro';
import catalog from '../../content/templates.json';
---
<Base title="Бесплатный архив кадровых шаблонов — Кадры-Про" description="Скачайте архив из 20 бесплатных кадровых шаблонов. Платные документы в архив не входят." page="bundle-download" noindex>
  <section class="bundle-page container"><p class="eyebrow">Бесплатный архив</p><h1>20 кадровых шаблонов</h1><p class="bundle-lead">Архив содержит только документы, помеченные в каталоге как бесплатные. Платных PDF и архива с платными шаблонами здесь нет.</p><a class="bundle-download" href={catalog.bundle.file} download>Скачать free-bundle-20.zip <span>↓</span></a><p class="bundle-meta">ZIP-архив · 20 PDF · без регистрации и электронной почты</p><a class="bundle-back" href="/shablony.html">← Вернуться к каталогу</a></section>
</Base>
<style>
  .bundle-page { max-width: 760px; min-height: 62vh; margin-block: 60px; padding: 74px 32px 64px; border: 1px solid var(--border-color,rgba(255,255,255,.15)); border-radius: 26px; color: var(--text-primary,#f2f6fb); background: var(--grad-card,linear-gradient(165deg,rgba(26,39,64,.9),rgba(14,21,36,.97))); box-shadow: inset 0 1px 0 rgba(255,255,255,.1),0 18px 48px rgba(4,8,20,.48); backdrop-filter: blur(12px); }
  .bundle-page .eyebrow { color: var(--accent,#58a6ff); font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .bundle-page h1 { margin: 8px 0 15px; font-size: clamp(2.4rem,6vw,4.6rem); letter-spacing: -.05em; }
  .bundle-lead { max-width: 650px; color: var(--text-secondary,#c1cbd8); font-size: 1.08rem; line-height: 1.7; }
  .bundle-download { display: inline-flex; align-items: center; gap: 20px; margin-top: 16px; min-height: 56px; padding: 0 22px; border-radius: 12px; color: var(--on-accent,#f8fbff); background: var(--grad-btn,linear-gradient(135deg,#2563eb,#1d4ed8)); box-shadow: inset 0 1px 0 rgba(255,255,255,.24),0 10px 24px rgba(20,74,180,.32); text-decoration: none; font-weight: 800; }
  .bundle-download:hover,.bundle-download:focus-visible { color: var(--on-accent,#f8fbff); background: var(--grad-btn-hover,linear-gradient(135deg,#3b82f6,#2563eb)); box-shadow: inset 0 1px 0 rgba(255,255,255,.3),0 13px 28px rgba(20,74,180,.4); transform: translateY(-2px); }
  .bundle-meta { color: var(--text-muted,#94a2b2); font-size: .86rem; }
  .bundle-back { display: inline-block; margin-top: 25px; color: var(--accent-text,#b6daff); text-decoration: none; }
</style>
