---
import Base from '../layouts/Base.astro';
import catalog from '../../content/templates.json';
---
<Base title="Бесплатный архив кадровых шаблонов — Кадры-Про" description="Скачайте архив из 20 бесплатных кадровых шаблонов. Платные документы в архив не входят." page="bundle-download" noindex>
  <section class="bundle-page container"><p class="eyebrow">Бесплатный архив</p><h1>20 кадровых шаблонов</h1><p class="bundle-lead">Архив содержит только документы, помеченные в каталоге как бесплатные. Платных PDF и архива с платными шаблонами здесь нет.</p><a class="bundle-download" href={catalog.bundle.file} download>Скачать free-bundle-20.zip <span>↓</span></a><p class="bundle-meta">ZIP-архив · 20 PDF · без регистрации и электронной почты</p><a class="bundle-back" href="/shablony.html">← Вернуться к каталогу</a></section>
</Base>
<style>
  .bundle-page{max-width:760px;min-height:62vh;padding:110px 22px 90px;color:var(--text-primary,#f4f7f4)}.bundle-page .eyebrow{color:var(--accent,#4ade80);font-weight:800;letter-spacing:.14em;text-transform:uppercase}.bundle-page h1{margin:8px 0 15px;font-size:clamp(2.4rem,6vw,4.6rem);letter-spacing:-.05em}.bundle-lead{max-width:650px;color:var(--text-secondary,#b9c5bc);font-size:1.08rem;line-height:1.7}.bundle-download{display:inline-flex;align-items:center;gap:20px;margin-top:16px;min-height:56px;padding:0 22px;border-radius:12px;background:var(--accent,#4ade80);color:var(--on-accent,#081c10);text-decoration:none;font-weight:800}.bundle-meta{color:var(--text-muted,#8f9d93);font-size:.86rem}.bundle-back{display:inline-block;margin-top:25px;color:var(--accent-text,var(--accent,#4ade80));text-decoration:none}
</style>
