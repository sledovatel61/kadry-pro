const content = "<section class=\"hero hero-sub\">\n    <div class=\"hero-bg\"></div>\n    <div class=\"container\">\n      <div class=\"hero-content\">\n        <h1 class=\"anim\">Кейсы и <strong class=\"accent\">результаты</strong></h1>\n        <p class=\"hero-subtitle anim anim-delay-1\">Реальные проекты с измеримыми результатами</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"container\">\n      <!-- Filters -->\n      <div class=\"cases-filter anim\">\n        <button class=\"active\" data-filter=\"all\">Все</button>\n        <button data-filter=\"production\">Производство</button>\n        <button data-filter=\"network\">Сеть / Филиалы</button>\n        <button data-filter=\"security\">Охрана</button>\n        <button data-filter=\"construction\">Строительство</button>\n      </div>\n\n      <!-- Cases Grid -->\n      <div class=\"cases-grid\">\n\n        <!-- Case 1 -->\n        <div class=\"card case-card anim\" data-category=\"production\">\n          <div class=\"case-label\">Производство</div>\n          <h3>Цифровая трансформация кадрового учёта</h3>\n          <div class=\"case-meta\">\n            <span>Штат: <strong>250 чел</strong></span>\n            <span>Срок: <strong>3 месяца</strong></span>\n            <span>Год: <strong>2025</strong></span>\n          </div>\n          <p><strong>Задача:</strong> Производственное предприятие вело кадровый учёт «на бумаге». Документы терялись, сроки нарушались, риск штрафов при проверке — критический.</p>\n          <p><strong>Что сделано:</strong> Полный перевод кадрового документооборота из бумажного архива в систему 1С ERP. Внедрена система KPI для HR-процессов. Разработана многоступенчатая программа адаптации.</p>\n          <div class=\"case-results\">\n            <h4>Результаты</h4>\n            <ul>\n              <li>Сокращение времени обработки кадровых операций на 60%</li>\n              <li>Повышение удержания новых сотрудников на 35%</li>\n              <li>100% соответствие трудовому законодательству</li>\n              <li>Исключены риски административных санкций</li>\n            </ul>\n          </div>\n        </div>\n\n        <!-- Case 2 -->\n        <div class=\"card case-card anim anim-delay-1\" data-category=\"network\">\n          <div class=\"case-label\">Сеть / Филиалы</div>\n          <h3>Кадровое управление сетью из 21 филиала</h3>\n          <div class=\"case-meta\">\n            <span>Штат: <strong>250+ чел</strong></span>\n            <span>Филиалов: <strong>21</strong></span>\n            <span>Период: <strong>2,5 года</strong></span>\n          </div>\n          <p><strong>Задача:</strong> Федеральная сеть фитнес-клубов в разных регионах. Отсутствие централизованного HR-управления. Каждый клуб вёл документы по-своему.</p>\n          <p><strong>Что сделано:</strong> Единоличное управление кадрами всей сети. Разработка и внедрение единых корпоративных стандартов кадрового документооборота для всех 21 объекта.</p>\n          <div class=\"case-results\">\n            <h4>Результаты</h4>\n            <ul>\n              <li>Единые стандарты для всех 21 объекта</li>\n              <li>Автоматизация расчётов — 0% ошибок</li>\n              <li>Бесперебойное сопровождение без увеличения HR-штата</li>\n              <li>Полная аттестация рабочих мест с учётом вредных факторов</li>\n            </ul>\n          </div>\n        </div>\n\n        <!-- Case 3 -->\n        <div class=\"card case-card anim\" data-category=\"security\">\n          <div class=\"case-label\">Охранная деятельность</div>\n          <h3>Построение кадровой службы с нуля для ЧОО с 1000+ сотрудников</h3>\n          <div class=\"case-meta\">\n            <span>Штат: <strong>1000+ чел</strong></span>\n            <span>Срок: <strong>7 лет</strong></span>\n          </div>\n          <p><strong>Задача:</strong> Компания-лидер охранных услуг. Бурный рост, высокая текучесть, сложная лицензионная деятельность. Кадровой службы не было.</p>\n          <p><strong>Что сделано:</strong> Создание кадровой функции с нуля. Все внутренние регламенты. Полный цикл корпоративных изменений: смена гендиректора, перерегистрация акций, изменения устава. Управление ~1000 договорами страхования.</p>\n          <div class=\"case-results\">\n            <h4>Результаты</h4>\n            <ul>\n              <li>0 штрафов за 7 лет при проверках ГИТ, ПФР, ФСС</li>\n              <li>Единственный кадровик на 1000+ человек</li>\n              <li>Полный цикл корпоративных трансформаций «под ключ»</li>\n              <li>Построена воронка найма и резерв кандидатов</li>\n            </ul>\n          </div>\n        </div>\n\n        <!-- Case 4 -->\n        <div class=\"card case-card anim anim-delay-1\" data-category=\"construction\">\n          <div class=\"case-label\">Строительство</div>\n          <h3>Кадровое сопровождение при вредных условиях труда</h3>\n          <div class=\"case-meta\">\n            <span>Штат: <strong>200+ чел</strong></span>\n            <span>Вредные: <strong>100 чел</strong></span>\n          </div>\n          <p><strong>Задача:</strong> Группа строительных компаний. 100 человек на вредных условиях труда. Необходим допуск СРО. Работали иностранные высококвалифицированные специалисты.</p>\n          <p><strong>Что сделано:</strong> Полный цикл КДП для группы компаний. Оформление иностранных ВКС. Подготовка документации для СРО. Организация медосмотров, выдача СИЗ, специальная оценка условий труда.</p>\n          <div class=\"case-results\">\n            <h4>Результаты</h4>\n            <ul>\n              <li>Получен допуск СРО</li>\n              <li>0 нарушений при проверках</li>\n              <li>Все иностранные ВКС оформлены без замечаний</li>\n              <li>100% соблюдение требований по охране труда</li>\n            </ul>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- Reviews placeholder -->\n  <section class=\"section section-alt\">\n    <div class=\"container\">\n      <div class=\"section-header anim\">\n        <h2>Отзывы <strong>клиентов</strong></h2>\n        <p>По запросу предоставлю контакты рекомендателей: генеральные директора, HR-менеджеры, юридические консультанты</p>\n      </div>\n      <div class=\"text-center anim\">\n        <a href=\"/contact\" class=\"btn btn-outline btn-lg\">Запросить рекомендации</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- CTA -->\n  <section class=\"section cta-section\">\n    <div class=\"container\">\n      <div class=\"cta-inner anim\">\n        <h2>У вас похожая <strong>задача?</strong></h2>\n        <p>Расскажите о вашей ситуации — предложу решение и рассчитаю стоимость</p>\n        <a href=\"/contact\" class=\"btn btn-primary btn-lg\">Обсудить проект</a>\n      </div>\n    </div>\n  </section>\n";
