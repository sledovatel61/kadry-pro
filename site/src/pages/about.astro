---
/**
 * Страница «about» — перенесена с about.html без потери текстов.
 * Заголовок, описание и JSON-LD взяты из старой страницы один в один;
 * адрес остаётся прежним (build.format: 'file' → /about.html).
 */
import Base from '../layouts/Base.astro';
import QuickLeadForm from '../components/QuickLeadForm.astro';
const content = "<!-- Hero -->\n  <section class=\"hero hero-sub\">\n    <div class=\"hero-bg\"></div>\n    <div class=\"container\">\n      <div class=\"hero-content\" style=\"max-width:900px;\">\n        <div class=\"hero-badge anim\"><span class=\"hero-badge-dot\"></span>14 лет в HR</div>\n        <h1 class=\"anim anim-delay-1\">Мария <strong class=\"accent\">Перепечай</strong></h1>\n        <p class=\"hero-subtitle anim anim-delay-2\">Директор по персоналу уровня C-level. Специализация — построение кадровой инфраструктуры с нуля для компаний численностью до 1000+ сотрудников. Превращаю кадровую функцию из центра затрат в стратегический инструмент управления бизнесом.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Деловой портрет + короткое представление.\n       Раньше на странице «Обо мне» не было фотографии вовсе, хотя портрет\n       в хорошем качестве уже лежал в проекте. -->\n  <section class=\"section about-intro\">\n    <div class=\"container\">\n      <div class=\"about-intro-grid\">\n        <div class=\"about-intro-photo anim\">\n          <picture>\n            <source\n              type=\"image/avif\"\n              srcset=\"/img/maria-480.avif 480w, /img/maria-720.avif 720w, /img/maria-1080.avif 1080w\"\n              sizes=\"(max-width: 768px) 80vw, 360px\"\n            >\n            <source\n              type=\"image/webp\"\n              srcset=\"/img/maria-480.webp 480w, /img/maria-720.webp 720w, /img/maria-1080.webp 1080w\"\n              sizes=\"(max-width: 768px) 80vw, 360px\"\n            >\n            <img\n              src=\"/img/maria-720.webp\"\n              alt=\"Мария Перепечай — кадровый специалист, директор по персоналу, Ростов-на-Дону\"\n              width=\"720\"\n              height=\"955\"\n              loading=\"lazy\"\n              decoding=\"async\"\n            >\n          </picture>\n          <div class=\"about-intro-caption\">\n            <strong>Мария Перепечай</strong>\n            <span>кадровый специалист · директор по персоналу</span>\n          </div>\n        </div>\n        <div class=\"about-intro-text anim anim-delay-1\">\n          <h2>14 лет в кадрах — <strong>без единого штрафа</strong></h2>\n          <p>\n            Я прошла путь от кадрового делопроизводителя до руководителя отдела кадров\n            в компаниях с численностью до 1000+ сотрудников: производство, федеральная\n            сеть фитнес-клубов, логистика, общепит, розница.\n          </p>\n          <p>\n            Теперь помогаю малому бизнесу: беру кадровый учёт под ключ, привожу документы\n            в порядок, готовлю к проверкам ГИТ и военкомата, разрабатываю ЛНА и сопровождаю СОУТ.\n            Работаю официально — договор, акты, закрывающие документы. Удалённо по всей России,\n            встречи в Ростове-на-Дону.\n          </p>\n          <ul class=\"about-intro-facts\">\n            <li><b>1000+</b> сотрудников в управлении одновременно</li>\n            <li><b>21 филиал</b> федеральной сети — единые кадровые стандарты</li>\n            <li><b>0 штрафов</b> за 14 лет работы</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Timeline -->\n  <section class=\"section\">\n    <div class=\"container\">\n      <div class=\"section-header anim\">\n        <h2>Профессиональный <strong>путь</strong></h2>\n        <p>Более 14 лет опыта в 6 отраслях — от стартапов до предприятий с 1000+ сотрудников</p>\n      </div>\n\n      <div class=\"timeline\" style=\"max-width:800px;margin:0 auto;\">\n\n        <div class=\"timeline-item anim\">\n          <div class=\"timeline-dot\"></div>\n          <div class=\"timeline-date\">Февраль 2025 — настоящее время</div>\n          <h3>Руководитель отдела кадров</h3>\n          <div class=\"timeline-company\">Производственная компания | 250 сотрудников</div>\n          <ul>\n            <li>Перевод кадрового документооборота в 1С ERP — сокращение времени обработки на 60%</li>\n            <li>Внедрение системы KPI для HR-процессов</li>\n            <li>Разработка программы адаптации — повышение удержания новых сотрудников на 35%</li>\n            <li>100% соответствие трудовому законодательству</li>\n          </ul>\n          <div class=\"timeline-tags\"><span class=\"tag\">Производство</span><span class=\"tag\">1С ERP</span><span class=\"tag\">Цифровизация</span></div>\n        </div>\n\n        <div class=\"timeline-item anim\">\n          <div class=\"timeline-dot\"></div>\n          <div class=\"timeline-date\">Июль 2022 — Февраль 2025 (2 года 8 мес)</div>\n          <h3>Ведущий менеджер по персоналу</h3>\n          <div class=\"timeline-company\">Федеральная сеть фитнес-клубов | 21 филиал | 250+ сотрудников</div>\n          <ul>\n            <li>Единоличное управление кадрами 21 объекта без региональных кадровиков</li>\n            <li>Единые стандарты кадрового документооборота для всей сети</li>\n            <li>Полная аттестация рабочих мест, актуализация штатного расписания</li>\n            <li>Автоматизация расчётов стажа и больничных — 0% ошибок</li>\n          </ul>\n          <div class=\"timeline-tags\"><span class=\"tag\">Фитнес</span><span class=\"tag\">Сеть</span><span class=\"tag\">Стандартизация</span></div>\n        </div>\n\n        <div class=\"timeline-item anim\">\n          <div class=\"timeline-dot\"></div>\n          <div class=\"timeline-date\">Март 2015 — Май 2022 (7 лет 3 мес)</div>\n          <h3>Начальник отдела кадров</h3>\n          <div class=\"timeline-company\">Крупнейшая частная охранная организация | 1000+ сотрудников</div>\n          <ul>\n            <li>Создание кадровой службы с нуля для компании экстенсивного роста</li>\n            <li>Полный цикл корпоративных изменений: смена гендиректора, перерегистрация акций, изменения устава</li>\n            <li>Выстроена система взаимодействия с ГИТ, ПФР, ФСС — 0 штрафов за 7 лет</li>\n            <li>Управление портфелем из ~1000 договоров страхования персонала</li>\n          </ul>\n          <div class=\"timeline-tags\"><span class=\"tag\">Охрана</span><span class=\"tag\">1000+ чел</span><span class=\"tag\">Корпоративное право</span></div>\n        </div>\n\n        <div class=\"timeline-item anim\">\n          <div class=\"timeline-dot\"></div>\n          <div class=\"timeline-date\">Июнь 2013 — Март 2015 (1 год 10 мес)</div>\n          <h3>Специалист по кадрам → Ведущий специалист</h3>\n          <div class=\"timeline-company\">ГК «Президент» | Финансы, аудит, консалтинг | 50+ сотрудников</div>\n          <ul>\n            <li>Разработка организационной структуры группы компаний</li>\n            <li>Комплекс ЛНА: положения, должностные инструкции, стандарты</li>\n            <li>Кадровое сопровождение сделок и проектов</li>\n          </ul>\n          <div class=\"timeline-tags\"><span class=\"tag\">Финансы</span><span class=\"tag\">Консалтинг</span></div>\n        </div>\n\n        <div class=\"timeline-item anim\">\n          <div class=\"timeline-dot\"></div>\n          <div class=\"timeline-date\">Октябрь 2011 — Июнь 2013 (1 год 9 мес)</div>\n          <h3>Специалист по кадрам</h3>\n          <div class=\"timeline-company\">ГК «Славяне» | Строительство, дорожное строительство | 200+ сотрудников</div>\n          <ul>\n            <li>Полный цикл КДП для группы компаний с распределённой структурой</li>\n            <li>Оформление иностранных ВКС: ходатайства, визы, разрешения</li>\n            <li>Подготовка документации для допуска СРО</li>\n            <li>100 сотрудников на вредных условиях труда — медосмотры, СИЗ, СОУТ</li>\n          </ul>\n          <div class=\"timeline-tags\"><span class=\"tag\">Строительство</span><span class=\"tag\">СРО</span><span class=\"tag\">Вредные условия</span><span class=\"tag\">Иностранцы</span></div>\n        </div>\n\n        <div class=\"timeline-item anim\">\n          <div class=\"timeline-dot\"></div>\n          <div class=\"timeline-date\">Ранний опыт</div>\n          <h3>Инспектор по кадрам</h3>\n          <div class=\"timeline-company\">ОАО «Песчанокопское ХПП» | Сельское хозяйство | 90 сотрудников</div>\n          <ul>\n            <li>КДП полного цикла в единственном лице</li>\n            <li>40 сотрудников на вредных условиях труда</li>\n            <li>Внедрение электронного документооборота</li>\n          </ul>\n          <div class=\"timeline-tags\"><span class=\"tag\">Агробизнес</span></div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- Competencies -->\n  <section class=\"section section-alt\">\n    <div class=\"container\">\n      <div class=\"section-header anim\">\n        <h2>Профессиональные <strong>компетенции</strong></h2>\n      </div>\n      <div class=\"comp-grid\">\n        <div class=\"card comp-card anim\">\n          <h3>💻 Кадровые системы</h3>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>1С:ERP Управление предприятием</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>1С:ЗУП (Зарплата и управление персоналом)</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>1С:Документооборот</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Контур.Персонал</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>КАМИН</div>\n        </div>\n        <div class=\"card comp-card anim anim-delay-1\">\n          <h3>⚖️ Юридические</h3>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Трудовое законодательство РФ — эксперт</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Гражданское право (договорное)</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Корпоративное право</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Административное право</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Миграционное право</div>\n        </div>\n        <div class=\"card comp-card anim anim-delay-2\">\n          <h3>🎯 Специализации</h3>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Штатное расписание любой сложности</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Воинский учёт и бронирование</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>СОУТ, медосмотры, СИЗ</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Трудоустройство иностранцев (ВКС, РВП)</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Статотчётность (П-4, П-4(НЗ), 57-Т)</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Education -->\n  <section class=\"section\">\n    <div class=\"container\">\n      <div class=\"section-header anim\">\n        <h2>Образование и <strong>развитие</strong></h2>\n      </div>\n      <div class=\"grid-2\" style=\"max-width:900px;margin:0 auto;\">\n        <div class=\"card anim\">\n          <h3 style=\"font-size:1.1rem;margin-bottom:16px;\">🎓 Высшее образование</h3>\n          <p style=\"font-weight:600;margin-bottom:4px;\">Невинномысский институт экономики, управления и права</p>\n          <p class=\"text-muted\">Факультет экономики и управления | Экономист | 2013</p>\n        </div>\n        <div class=\"card anim anim-delay-1\">\n          <h3 style=\"font-size:1.1rem;margin-bottom:16px;\">📚 Повышение квалификации</h3>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>1С:Предприятие 8 — Кадровый учёт (сертификат)</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Трудовое законодательство — ежегодное обновление</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Корпоративное право для кадровиков</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Аттестация рабочих мест (СОУТ)</div>\n          <div class=\"comp-item\"><span class=\"comp-dot\"></span>Воинский учёт — подготовка ответственных лиц</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- CTA -->\n  <section class=\"section cta-section\">\n    <div class=\"container\">\n      <div class=\"cta-inner anim\">\n        <h2>Готова начать <strong>работу сразу</strong></h2>\n        <p>Расскажите о вашей компании — предложу оптимальный формат сотрудничества</p>\n        <a href=\"/contact\" class=\"btn btn-primary btn-lg\">Обсудить задачу</a>\n      </div>\n    </div>\n  </section>\n";
---

<Base
  title={"Обо мне — Мария Перепечай | Кадровый специалист"}
  description={"14 лет опыта в HR. Производство, строительство, финансы, агробизнес, охрана, фитнес. 1000+ сотрудников, 21 филиал, 0 штрафов."}
  page="about"
  jsonLd={[{"@context":"https://schema.org","@type":"Organization","name":"Кадры-Про","url":"https://kadry-pro.ru/","logo":"https://kadry-pro.ru/logo.png","image":"https://kadry-pro.ru/logo.png","description":"Кадровый аутсорсинг для малого бизнеса: абонентское обслуживание, разработка ЛНА, СОУТ, подбор персонала, подготовка к проверкам ГИТ. Ростов-на-Дону, работа по всей России.","telephone":"+7-961-302-21-12","email":"m.perepechay@yandex.ru","address":{"@type":"PostalAddress","addressLocality":"Ростов-на-Дону","addressRegion":"Ростовская область","addressCountry":"RU"},"areaServed":{"@type":"Country","name":"Россия"}}]}
  
>
  <Fragment set:html={content} />

  <QuickLeadForm page="about" service="consultation" title="Обсудим вашу ситуацию" />
</Base>
