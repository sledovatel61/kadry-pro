const content = "<!-- ==================== НАВИГАЦИЯ (копируем с index.html) ==================== -->\n\n  <!-- Мобильное меню -->\n\n  <!-- ==================== HERO (шапка страницы) ==================== -->\n  <section class=\"hero hero-sub\">\n    <div class=\"hero-bg\"></div>\n    <div class=\"container\">\n      <div class=\"hero-content\">\n        <h1 class=\"anim\">Штрафы ГИТ за кадровые документы в <strong class=\"accent\">2026 году</strong></h1>\n        <p class=\"hero-subtitle anim anim-delay-1\">Полный список штрафов трудовой инспекции. Как избежать санкций до 500 000 ₽ и подготовиться к проверке</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- ==================== ОСНОВНОЙ КОНТЕНТ ==================== -->\n  <section class=\"section\">\n    <div class=\"container\" style=\"max-width: 900px;\">\n\n      <!-- Вступление -->\n      <div class=\"card anim\" style=\"margin-bottom: 32px;\">\n        <p style=\"font-size: 1.1rem; line-height: 1.8; color: var(--text-secondary);\">\n          В 2026 году трудовая инспекция усилила контроль за соблюдением трудового законодательства.\n          Размеры штрафов выросли, а проверки стали чаще и строже.\n          Знание актуальных санкций поможет защитить ваш бизнес от многотысячных потерь.\n        </p>\n      </div>\n\n      <!-- Штрафы по категориям -->\n      <h2 class=\"anim\" style=\"font-size: 1.5rem; font-weight: 300; margin-bottom: 24px; text-align: center;\">\n        Самые <strong>частые нарушения</strong> и штрафы\n      </h2>\n\n      <!-- Карточка 1: Трудовой договор -->\n      <div class=\"card anim\" style=\"margin-bottom: 24px; border-left: 4px solid var(--danger);\">\n        <h3 style=\"color: var(--danger); font-size: 1.2rem; margin-bottom: 12px;\">\n          ⚠️ Отсутствие трудового договора\n        </h3>\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;\">\n          <div>\n            <div style=\"font-size: 2rem; font-weight: 700; color: var(--danger);\">до 100 000 ₽</div>\n            <div style=\"color: var(--text-muted); font-size: 0.9rem;\">за каждого неоформленного сотрудника</div>\n          </div>\n          <div>\n            <div style=\"font-size: 2rem; font-weight: 700; color: var(--danger);\">до 200 000 ₽</div>\n            <div style=\"color: var(--text-muted); font-size: 0.9rem;\">повторное нарушение</div>\n          </div>\n        </div>\n        <p style=\"color: var(--text-secondary); line-height: 1.6;\">\n          <strong>Что проверяет ГИТ:</strong> наличие письменного трудового договора, сроки его заключения (в день приёма),\n          обязательные условия (должность, оклад, режим работы).\n        </p>\n      </div>\n\n      <!-- Карточка 2: Оформление -->\n      <div class=\"card anim\" style=\"margin-bottom: 24px; border-left: 4px solid var(--warning);\">\n        <h3 style=\"color: var(--warning); font-size: 1.2rem; margin-bottom: 12px;\">\n          ⚠️ Неправильное оформление приёма/увольнения\n        </h3>\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;\">\n          <div>\n            <div style=\"font-size: 2rem; font-weight: 700; color: var(--warning);\">50 000 ₽</div>\n            <div style=\"color: var(--text-muted); font-size: 0.9rem;\">нарушение сроков оформления</div>\n          </div>\n          <div>\n            <div style=\"font-size: 2rem; font-weight: 700; color: var(--warning);\">до 20 000 ₽</div>\n            <div style=\"color: var(--text-muted); font-size: 0.9rem;\">ошибки в трудовой книжке</div>\n          </div>\n        </div>\n        <p style=\"color: var(--text-secondary); line-height: 1.6;\">\n          <strong>Риски:</strong> приказ о приёме — в день выхода, увольнение — за 2 недели,\n          запись в трудовой — вовремя и без ошибок.\n        </p>\n      </div>\n\n      <!-- Карточка 3: ЛНА -->\n      <div class=\"card anim\" style=\"margin-bottom: 24px; border-left: 4px solid var(--danger);\">\n        <h3 style=\"color: var(--danger); font-size: 1.2rem; margin-bottom: 12px;\">\n          ⚠️ Отсутствие ЛНА (ПВТР, положения, инструкции)\n        </h3>\n        <div style=\"margin-bottom: 16px;\">\n          <div style=\"font-size: 2rem; font-weight: 700; color: var(--danger);\">до 200 000 ₽</div>\n          <div style=\"color: var(--text-muted); font-size: 0.9rem;\">отсутствие правил внутреннего трудового распорядка</div>\n        </div>\n        <p style=\"color: var(--text-secondary); line-height: 1.6;\">\n          <strong>Обязательные документы:</strong> ПВТР, положение об оплате труда,\n          должностные инструкции, положение о персональных данных (ФЗ-152).\n        </p>\n      </div>\n\n      <!-- Карточка 4: Воинский учёт -->\n      <div class=\"card anim\" style=\"margin-bottom: 24px; border-left: 4px solid var(--danger);\">\n        <h3 style=\"color: var(--danger); font-size: 1.2rem; margin-bottom: 12px;\">\n          ⚠️ Нарушения воинского учёта\n        </h3>\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;\">\n          <div>\n            <div style=\"font-size: 2rem; font-weight: 700; color: var(--danger);\">до 500 000 ₽</div>\n            <div style=\"color: var(--text-muted); font-size: 0.9rem;\">для организации</div>\n          </div>\n          <div>\n            <div style=\"font-size: 2rem; font-weight: 700; color: var(--danger);\">до 80 000 ₽</div>\n            <div style=\"color: var(--text-muted); font-size: 0.9rem;\">для должностного лица</div>\n          </div>\n        </div>\n        <p style=\"color: var(--text-secondary); line-height: 1.6;\">\n          <strong>Критично:</strong> учёт военнообязанных и призывников, своевременная подготовка отчётности,\n          ведение личных карточек.\n        </p>\n      </div>\n\n      <!-- Чек-лист -->\n      <h2 class=\"anim\" style=\"font-size: 1.5rem; font-weight: 300; margin: 48px 0 24px; text-align: center;\">\n        Чек-лист: <strong>как избежать штрафов</strong>\n      </h2>\n\n      <div class=\"card anim\" style=\"margin-bottom: 32px;\">\n        <ul style=\"list-style: none; padding: 0;\">\n          <li style=\"padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; gap: 12px; align-items: flex-start;\">\n            <span style=\"color: var(--accent-text); font-weight: 700; flex-shrink: 0;\">✓</span>\n            <span style=\"color: var(--text-secondary);\">Проверьте все трудовые договоры на обязательные реквизиты</span>\n          </li>\n          <li style=\"padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; gap: 12px; align-items: flex-start;\">\n            <span style=\"color: var(--accent-text); font-weight: 700; flex-shrink: 0;\">✓</span>\n            <span style=\"color: var(--text-secondary);\">Оформите ПВТР и положение об оплате труда</span>\n          </li>\n          <li style=\"padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; gap: 12px; align-items: flex-start;\">\n            <span style=\"color: var(--accent-text); font-weight: 700; flex-shrink: 0;\">✓</span>\n            <span style=\"color: var(--text-secondary);\">Проверьте сроки оформления приказов и записей в трудовых книжках</span>\n          </li>\n          <li style=\"padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; gap: 12px; align-items: flex-start;\">\n            <span style=\"color: var(--accent-text); font-weight: 700; flex-shrink: 0;\">✓</span>\n            <span style=\"color: var(--text-secondary);\">Ведите воинский учёт (если есть военнообязанные)</span>\n          </li>\n          <li style=\"padding: 12px 0; display: flex; gap: 12px; align-items: flex-start;\">\n            <span style=\"color: var(--accent-text); font-weight: 700; flex-shrink: 0;\">✓</span>\n            <span style=\"color: var(--text-secondary);\">Проведите внутренний аудит перед проверкой ГИТ</span>\n          </li>\n        </ul>\n      </div>\n\n      <!-- CTA-блок -->\n      <div class=\"card anim\" style=\"background: linear-gradient(135deg, var(--accent-glow), var(--accent-glow)); border-color: var(--accent-border); text-align: center; padding: 40px;\">\n        <h3 style=\"font-size: 1.3rem; margin-bottom: 16px; color: var(--accent-text);\">\n          Профессиональная подготовка к проверке ГИТ\n        </h3>\n        <p style=\"color: var(--text-secondary); margin-bottom: 24px; line-height: 1.6;\">\n          За 14 лет работы я подготовила <strong>более 200 компаний</strong> к проверкам трудовой инспекции.\n          <strong>0 штрафов</strong> — результат моих клиентов.\n        </p>\n        <div style=\"display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;\">\n          <a href=\"/contact.html\" class=\"btn btn-primary btn-lg\">\n            Заказать аудит документов\n          </a>\n          <a href=\"/services.html?tab=tab-single\" class=\"btn btn-outline btn-lg\">\n            Смотреть цены на услуги\n          </a>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- ==================== FOOTER (копируем с index.html) ==================== -->\n\n  <!-- Кнопка звонка на мобильном -->\n\n  <!-- Подключаем скрипты -->\n";
