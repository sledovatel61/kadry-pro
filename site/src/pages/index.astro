<Base
  title={"Кадровый аутсорсинг под ключ — Мария Перепечай | Ростов-на-Дону"}
  description={"Кадровый аутсорсинг для малого бизнеса от " + formatPrice(getPrice('retainer.start')) + "/мес вместо штатного кадровика за 75 000 ₽. 16 лет опыта, 0 штрафов. Полное кадровое сопровождение, ЛНА, подготовка к проверкам ГИТ. Работаю удалённо по всей России."}
  page="home"
  jsonLd={[{"@context":"https://schema.org","@type":"ProfessionalService","name":"Кадровый аутсорсинг — Мария Перепечай","description":"Кадровый аутсорсинг для малого бизнеса. Полное кадровое сопровождение, разработка ЛНА, подготовка к проверкам ГИТ, воинский учёт, СОУТ.","url":"https://kadry-pro.ru/","telephone":"+7-961-302-21-12","email":"m.perepechay@yandex.ru","address":{"@type":"PostalAddress","addressLocality":"Ростов-на-Дону","addressRegion":"Ростовская область","addressCountry":"RU"},"geo":{"@type":"GeoCoordinates","latitude":"47.2225","longitude":"39.7188"},"priceRange":"от " + formatPrice(getPrice('retainer.start')) + "/мес","areaServed":{"@type":"Country","name":"Россия"},"serviceType":["Кадровый аутсорсинг","Разработка ЛНА","Подготовка к проверкам ГИТ","Воинский учёт","СОУТ"]}]}
  
>
  {/* Отзывы — перед финальным блоком «Заявка»: из reviews.json + живые из relay */}
  <Fragment set:html={content.split('<!-- ====== CTA + FORM ====== -->')[0]} />
  <ReviewsSection id="reviews-home" source="home" title="Отзывы клиентов" />
  <ReviewModal page="home" />

  {/* Цены тарифов для калькулятора (client/site.ts читает их вместо зашитых чисел) */}
  <script type="application/json" id="calc-prices" set:html={JSON.stringify(calcPrices)}></script>
  <Fragment set:html={content.split('<!-- ====== CTA + FORM ====== -->').slice(1).join('<!-- ====== CTA + FORM ====== -->')} />

  {/* Локальные правки вёрстки главной. Scoped-стиль держим здесь, а не в
      style.css: этот файл — зона Агента 01, и правки в нём дают конфликты.
      ВАЖНО: разметку вставляет set:html, у неё нет data-astro-cid, поэтому
      каждый селектор целиком завёрнут в :global() — вложенные части внутри
      :global() всё равно получили бы скоуп и не сработали. */}
  <style>
    /* Правая колонка героя: плашка локации стоит НАД рамкой портрета.
       Внутри .container она держит композицию на любом мониторе и не
       улетает в дальний правый угол, как прежняя absolute-плашка. */
    :global(.hero-side) {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      flex-shrink: 0;
      z-index: 1;
    }

    /* Снимаем absolute-позиционирование из style.css: теперь это обычная
       строка в потоке правой колонки, а не слой поверх страницы. */
    :global(.hero-side .hero-location-badge--inline) {
      position: static;
      top: auto;
      right: auto;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin: 0;
      padding: 10px 16px;
      max-width: 100%;
      border-radius: 12px;
      background: linear-gradient(165deg, rgba(26, 39, 64, 0.92), rgba(14, 21, 36, 0.96));
      border: 1px solid var(--accent-border, rgba(88, 166, 255, 0.32));
      box-shadow: inset 0 1px 0 rgba(186, 220, 255, 0.12), 0 12px 28px -14px rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(6px);
      animation: none;
    }

    :global(.hero-side .hero-location-badge--inline .location-pin) {
      font-size: 1.1rem;
      animation: none;
    }

    :global(.hero-side .hero-location-badge--inline .location-text) {
      display: flex;
      flex-direction: column;
      line-height: 1.25;
      min-width: 0;
    }

    :global(.hero-side .hero-location-badge--inline .location-text strong) {
      font-size: 0.88rem;
      color: var(--accent-text, var(--accent, #7cc4ff));
    }

    :global(.hero-side .hero-location-badge--inline .location-text span) {
      font-size: 0.76rem;
      color: var(--text-secondary, #c1cbd8);
    }

    /* Мессенджеры — отдельной строкой под «Локацией», а не третьим элементом
       во flex-строке пункта: город больше не сжимается в «Ростов- / на- / Дону». */
    :global(.hero-messengers) {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }

    /* Узкие экраны: фото по-прежнему сверху, но уже вместе с плашкой,
       потому что обёртка .hero-side стала одним flex-элементом колонки. */
    @media (max-width: 768px) {
      :global(.hero-side) {
        gap: 10px;
        width: 100%;
      }
      /* На мобильном сохраняем прежний порядок: сначала портрет, под ним текст.
         Без этого плашка, ставшая первым элементом колонки, выталкивала фото
         вниз и portrait уезжал под заголовок. */
      :global(.hero-side .hero-photo-wrapper) {
        order: -1;
      }
    }
  </style>
</Base>
