/**
 * Страница «index» — перенесена с index.html без потери текстов.
 * Заголовок, описание и JSON-LD взяты из старой страницы один в один;
 * адрес остаётся прежним (build.format: 'file' → /).
 */
import Base from '../layouts/Base.astro';
import { renderPriceToken, formatPrice, getPrice } from '../shared/prices.ts';
import ReviewsSection from '../components/ReviewsSection.astro';
import ReviewModal from '../components/ReviewModal.astro';
// Цены тарифов калькулятора — из единого prices.json (правка в /manage/ меняет и их)
const calcPrices = {
  start: getPrice('retainer.start'),
  business: getPrice('retainer.business'),
  max: getPrice('retainer.max'),
};
const content = renderPriceToken("<!-- ====== HERO ====== -->\n  <section class=\"hero\" id=\"hero\">\n    <div class=\"hero-bg\"></div>\n    <div class=\"hero-grid\"></div>\n\n    <!-- Локация переехала в правую колонку: рядом с портретом она не улетает\n         в угол на широком мониторе, а держит композицию собранной. -->\n    <!-- Новые декоративные элементы -->\n    <div class=\"hero-visual-element\">\n      <div class=\"hero-circle\"></div>\n      <div class=\"hero-dots\"></div>\n    </div>\n\n    <div class=\"container\">\n      <div class=\"hero-content hero-content-with-photo\">\n        <div class=\"hero-badge anim\">\n          <span class=\"hero-badge-dot\"></span>\n          Открыта для новых клиентов\n        </div>\n\n        <!-- Новый подзаголовок с категорией услуг -->\n        <div class=\"hero-category anim anim-delay-1\">\n          <span class=\"category-tag\">💼 Кадровые услуги</span>\n          <span class=\"category-tag\">🛡️ Аутсорсинг</span>\n          <span class=\"category-tag\">📋 ЛНА</span>\n        </div>\n\n        <h1 class=\"anim anim-delay-2\">\n          Кадровый аутсорсинг<br>\n          <strong class=\"accent\">под ключ</strong>\n        </h1>\n\n        <p class=\"hero-subtitle anim anim-delay-3\">\n          От <strong class=\"price-highlight\">{{price:retainer.start}}/мес</strong> вместо штатного кадровика за&nbsp;75&nbsp;000&nbsp;₽.\n          <span class=\"experience-badge\">16&nbsp;лет опыта</span>,\n          <span class=\"guarantee-badge\">0&nbsp;штрафов</span> при проверках ГИТ, военкомата, ПФР и&nbsp;ФСС (ныне СФР).\n        </p>\n\n        <div class=\"hero-actions anim anim-delay-4\">\n          <a href=\"#calculator\" class=\"btn btn-primary btn-lg\">\n            <span class=\"btn-icon\">💰</span> Рассчитать выгоду\n          </a>\n          <a href=\"/contact.html\" class=\"btn btn-outline btn-lg\">\n            <span class=\"btn-icon\">📝</span> Оставить заявку\n          </a>\n        </div>\n\n        <!-- Новые \"преимущества\" под кнопками -->\n        <div class=\"hero-benefits anim anim-delay-5\">\n          <div class=\"benefit-item\">\n            <span class=\"benefit-icon\">⚡</span>\n            <span>Начну завтра</span>\n          </div>\n          <div class=\"benefit-item\">\n            <span class=\"benefit-icon\">🎯</span>\n            <span>Работаю официально</span>\n          </div>\n          <div class=\"benefit-item\">\n            <span class=\"benefit-icon\">🤝</span>\n            <span>Договор + акты</span>\n          </div>\n        </div>\n      </div>\n       <!-- ====== ФОТО МАРИИ ====== -->\n      <!-- Правая колонка: плашка локации + портрет. Плашка стоит НАД рамкой\n           фото и внутри .container, поэтому не улетает в угол на широком экране.\n           Отдельная обёртка нужна, чтобы декоративные уголки (.hero-photo-wrapper\n           ::before/::after) обрамляли именно фото, а не плашку. -->\n      <div class=\"hero-side\">\n        <div class=\"hero-location-badge hero-location-badge--inline\">\n          <span class=\"location-pin\">📍</span>\n          <div class=\"location-text\">\n            <strong>Ростов-на-Дону</strong>\n            <span>Работаю удалённо по всей России</span>\n          </div>\n        </div>\n      <div class=\"hero-photo-wrapper anim anim-delay-3\">\n        <!-- Портрет: 1,2 МБ PNG заменён на AVIF/WebP в трёх размерах (≤ 75 КБ).\n             Пропорции настоящие — 916×1215, поэтому фото больше не «дёргается». -->\n        <picture>\n          <source\n            type=\"image/avif\"\n            srcset=\"/img/maria-480.avif 480w, /img/maria-720.avif 720w, /img/maria-1080.avif 1080w\"\n            sizes=\"(max-width: 768px) 88vw, 420px\"\n          >\n          <source\n            type=\"image/webp\"\n            srcset=\"/img/maria-480.webp 480w, /img/maria-720.webp 720w, /img/maria-1080.webp 1080w\"\n            sizes=\"(max-width: 768px) 88vw, 420px\"\n          >\n          <img\n            src=\"/img/maria-720.webp\"\n            alt=\"Мария Перепечай — специалист по кадровому аутсорсингу, 16 лет опыта в HR\"\n            class=\"hero-photo\"\n            width=\"720\"\n            height=\"955\"\n            loading=\"eager\"\n            fetchpriority=\"high\"\n            decoding=\"async\"\n          >\n        </picture>\n        <div class=\"hero-photo-caption\">\n          <strong>Мария Перепечай</strong>\n          Кадровый специалист · 16 лет опыта\n        </div>\n      </div>\n      <!-- / ФОТО МАРИИ -->\n      </div>\n      <!-- / Правая колонка -->\n    </div>\n  </section>\n\n  <!-- ====== PROBLEMS vs SOLUTIONS ====== -->\n  <section class=\"section\" id=\"problems\">\n    <div class=\"container\">\n      <div class=\"section-header anim\">\n        <h2>Знакомые <strong>проблемы?</strong></h2>\n        <p>Каждая из них может стоить вашему бизнесу сотни тысяч рублей</p>\n      </div>\n      <div class=\"pvs-grid\">\n        <div class=\"card pvs-card problems anim\">\n          <h3>⚠ Без кадровика</h3>\n          <div class=\"pvs-item\"><span class=\"pvs-icon bad\">✗</span><p>Штрафы от трудовой инспекции — до 200 000 ₽</p></div>\n          <div class=\"pvs-item\"><span class=\"pvs-icon bad\">✗</span><p>Ошибки в трудовых договорах и приказах</p></div>\n          <div class=\"pvs-item\"><span class=\"pvs-icon bad\">✗</span><p>Нет ПВТР, положений, должностных инструкций</p></div>\n          <div class=\"pvs-item\"><span class=\"pvs-icon bad\">✗</span><p>Компания не готова к проверке ГИТ и военкомата</p></div>\n          <div class=\"pvs-item\"><span class=\"pvs-icon bad\">✗</span><p>Некому оформить приём, увольнение, перевод</p></div>\n          <div class=\"pvs-item\"><span class=\"pvs-icon bad\">✗</span><p>Воинский учёт не ведётся — штраф до 500 000 ₽</p></div>\n        </div>\n        <div class=\"card pvs-card solutions anim anim-delay-1\">\n          <h3>✓ С Марией Перепечай</h3>\n          <div class=\"pvs-item\"><span class=\"pvs-icon good\">✓</span><p>0 штрафов за 16 лет — доказанный результат</p></div>\n          <div class=\"pvs-item\"><span class=\"pvs-icon good\">✓</span><p>Все документы строго по ТК РФ</p></div>\n          <div class=\"pvs-item\"><span class=\"pvs-icon good\">✓</span><p>Полный комплект ЛНА за 2–4 недели</p></div>\n          <div class=\"pvs-item\"><span class=\"pvs-icon good\">✓</span><p>Подготовлю к любой проверке заблаговременно</p></div>\n          <div class=\"pvs-item\"><span class=\"pvs-icon good\">✓</span><p>Полный кадровый цикл — от приёма до увольнения</p></div>\n          <div class=\"pvs-item\"><span class=\"pvs-icon good\">✓</span><p>Воинский учёт, СОУТ, охрана труда — в одном договоре</p></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ====== CALCULATOR ====== -->\n  <section class=\"section section-alt\" id=\"calculator\">\n    <div class=\"container\">\n      <div class=\"section-header anim\">\n        <h2>Рассчитайте <strong>выгоду</strong></h2>\n        <p>Сравните стоимость штатного кадровика и аутсорсинга</p>\n      </div>\n      <div class=\"calc-grid\">\n        <div class=\"card calc-card anim\">\n          <h3>👩‍💼 Штатный кадровик</h3>\n          <div class=\"calc-slider-group\">\n            <div class=\"calc-slider-label\">\n              <span>Зарплата «на руки»</span>\n              <span class=\"calc-slider-value\"><span id=\"salary-value\">45 000</span><span class=\"currency\"> ₽</span></span>\n            </div>\n            <input type=\"range\" id=\"salary-slider\" min=\"35000\" max=\"80000\" value=\"45000\" step=\"5000\" aria-label=\"Зарплата кадровика\">\n          </div>\n          <div class=\"calc-detail\"><span>Зарплата до вычета НДФЛ (13%)</span><span id=\"salary-gross\">51 724 ₽</span></div>\n          <div class=\"calc-detail\"><span>Страховые взносы (~30,2%)</span><span id=\"salary-tax\">15 621 ₽</span></div>\n          <div class=\"calc-detail\"><span>Рабочее место, ПК, 1С</span><span id=\"salary-workplace\">5 000 ₽</span></div>\n          <div class=\"calc-detail\" style=\"border-bottom:none;padding-top:12px;\"><span><strong>Итого для работодателя</strong></span><span style=\"color:var(--danger);font-weight:700;\" id=\"salary-total\">72 345 ₽</span></div>\n        </div>\n\n        <div class=\"card calc-card anim anim-delay-1\">\n          <h3>🤝 Аутсорсинг</h3>\n          <div class=\"calc-slider-group\">\n            <div class=\"calc-slider-label\">\n              <span>Количество сотрудников</span>\n              <span class=\"calc-slider-value\"><span id=\"staff-value\">10</span><span class=\"currency\"> чел</span></span>\n            </div>\n            <input type=\"range\" id=\"staff-slider\" min=\"1\" max=\"50\" value=\"10\" step=\"1\" aria-label=\"Количество сотрудников\">\n          </div>\n          <div class=\"calc-detail\"><span>Ваш тариф</span><span id=\"staff-tier\">«Старт» (до 10 чел.)</span></div>\n          <div class=\"calc-detail\"><span>Стоимость аутсорсинга</span><span style=\"color:var(--accent-text);font-weight:700;\" id=\"staff-price\">{{price:retainer.start}}/мес</span></div>\n          <div class=\"calc-detail\"><span>Взносы и налоги</span><span>0 ₽</span></div>\n          <div class=\"calc-detail\" style=\"border-bottom:none;\"><span>Рабочее место</span><span>Не нужно</span></div>\n        </div>\n\n        <div class=\"card calc-result anim anim-delay-2\">\n          <h3>💰 Ваша экономия</h3>\n          <div class=\"calc-savings\"><span id=\"savings-month\">58 345</span> ₽/мес</div>\n          <div class=\"calc-savings-year\"><span id=\"savings-year\">700 140 ₽ в год</span></div>\n\n          <!-- Связка калькулятора с заявкой: цифры расчёта уезжают в форму,\n               и Мария сразу видит штат, тариф и экономию клиента. -->\n          <button type=\"button\" class=\"btn btn-primary btn-block btn-lg calc-cta\" id=\"calc-fix\" data-calc-fix>\n            Зафиксировать этот расчёт →\n          </button>\n          <p class=\"calc-cta-note\">Подставим штат, тариф и экономию в заявку — вам не придётся объяснять цифры заново.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ====== STATS ====== -->\n  <section class=\"section\" id=\"stats\">\n    <div class=\"container\">\n      <div class=\"stats-grid\">\n        <div class=\"stat-card anim\">\n          <div class=\"stat-icon\">📅</div>\n          <div class=\"stat-number\" data-count=\"16\" data-suffix=\"+\">0</div>\n          <div class=\"stat-label\">Лет опыта в HR</div>\n        </div>\n        <div class=\"stat-card anim anim-delay-1\">\n          <div class=\"stat-icon\">👥</div>\n          <div class=\"stat-number\" data-count=\"1000\" data-suffix=\"+\">0</div>\n          <div class=\"stat-label\">Сотрудников под управлением</div>\n        </div>\n        <div class=\"stat-card anim anim-delay-2\">\n          <div class=\"stat-icon\">🏢</div>\n          <div class=\"stat-number\" data-count=\"21\">0</div>\n          <div class=\"stat-label\">Филиал без региональных кадровиков</div>\n        </div>\n        <div class=\"stat-card anim anim-delay-3\">\n          <div class=\"stat-icon\">🛡️</div>\n          <div class=\"stat-number\" data-count=\"0\">0</div>\n          <div class=\"stat-label\">Штрафов за всю карьеру</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ====== SERVICES OVERVIEW ====== -->\n  <section class=\"section section-alt\" id=\"services-overview\" data-section=\"what-i-do\">\n    <div class=\"container\">\n      <div class=\"section-header anim\">\n        <h2>Что я <strong>делаю</strong></h2>\n        <p>Полный спектр кадровых услуг для малого и среднего бизнеса</p>\n      </div>\n      <div class=\"services-grid\">\n\n        <!-- Абонентское — ведёт на страницу услуг -->\n        <a href=\"/services.html?tab=tab-subscription\" class=\"card card-accent service-card anim\">\n          <div class=\"service-card-icon\">📋</div>\n          <h3>Абонентское обслуживание</h3>\n          <p>Полное кадровое сопровождение на ежемесячной основе</p>\n          <div class=\"service-card-price\">от {{price:retainer.start}}/мес</div>\n        </a>\n\n        <!-- ЛНА — ведёт на детальную страницу -->\n        <a href=\"/lna.html\" class=\"card card-accent service-card anim anim-delay-1\">\n          <div class=\"service-card-icon\">📄</div>\n          <h3>Разработка ЛНА</h3>\n          <p>ПВТР, положения, должностные инструкции — индивидуально</p>\n          <div class=\"service-card-price\">от 3 000 ₽</div>\n        </a>\n\n        <!-- СОУТ — ведёт на детальную страницу -->\n        <a href=\"/sout.html\" class=\"card card-accent service-card anim anim-delay-2\">\n          <div class=\"service-card-icon\">🔬</div>\n          <h3>Организация СОУТ</h3>\n          <p>Спецоценка под ключ с аккредитованной лабораторией</p>\n          <div class=\"service-card-price\">от {{price:sout.up-to-10}}</div>\n        </a>\n\n        <!-- Подбор персонала — ТЕПЕРЬ на отдельную страницу -->\n        <a href=\"/podbor.html\" class=\"card card-accent service-card anim anim-delay-3\">\n          <div class=\"service-card-icon\">🔍</div>\n          <h3>Подбор персонала</h3>\n          <p>Поиск и отбор кандидатов с выстроенной воронкой найма</p>\n          <div class=\"service-card-price\">от {{price:services.recruitment}}</div>\n        </a>\n\n        <!-- Аудит и проверки — ТЕПЕРЬ на отдельную страницу -->\n        <a href=\"/audit.html\" class=\"card card-accent service-card anim anim-delay-4\">\n          <div class=\"service-card-icon\">🛡️</div>\n          <h3>Аудит и проверки</h3>\n          <p>Проверка кадровых документов и подготовка к инспекциям</p>\n          <div class=\"service-card-price\">от {{price:audit.express}}</div>\n        </a>\n\n        <!-- Консультации — остаётся на контакты -->\n        <a href=\"/contact.html\" class=\"card card-accent service-card anim anim-delay-5\">\n          <div class=\"service-card-icon\">💬</div>\n          <h3>Консультации</h3>\n          <p>Экспертная консультация по любым кадровым вопросам</p>\n          <div class=\"service-card-price\">{{price:consult.hour}}/час</div>\n        </a>\n\n      </div>\n    </div>\n  </section>\n\n    <!-- ====== SEO СТРАНИЦЫ (Полезные материалы) ====== -->\n  <section class=\"section section-alt\" id=\"materials\">\n    <div class=\"container\">\n      <div class=\"section-header anim\">\n        <h2>Полезные <strong>материалы</strong></h2>\n        <p>Гайды и справочная информация для работодателей</p>\n      </div>\n      <div class=\"services-grid\">\n        <a href=\"/shtrafy-git.html\" class=\"card card-accent service-card anim\">\n          <div class=\"service-card-icon\">⚠️</div>\n          <h3>Штрафы ГИТ 2026</h3>\n          <p>Полный список штрафов трудовой инспекции и как их избежать</p>\n          <div class=\"service-card-price\" style=\"color: var(--accent-text);\">Читать →</div>\n        </a>\n        <a href=\"/lna.html\" class=\"card card-accent service-card anim anim-delay-1\">\n          <div class=\"service-card-icon\">📋</div>\n          <h3>Разработка ЛНА</h3>\n          <p>ПВТР, положения, инструкции — индивидуально под ваш бизнес</p>\n          <div class=\"service-card-price\" style=\"color: var(--accent-text);\">Подробнее →</div>\n        </a>\n        <a href=\"/sout.html\" class=\"card card-accent service-card anim anim-delay-2\">\n          <div class=\"service-card-icon\">🔬</div>\n          <h3>Организация СОУТ</h3>\n          <p>Сопровождение специальной оценки условий труда от {{price:sout.up-to-10}}</p>\n          <div class=\"service-card-price\" style=\"color: var(--accent-text);\">Узнать цену →</div>\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <!-- ====== CTA + FORM ====== -->\n  <section class=\"section cta-section\" id=\"contact-form\">\n    <div class=\"container\">\n      <div class=\"contact-grid\">\n        <div class=\"anim\">\n          <h2 style=\"font-size:clamp(1.5rem,3vw,2.2rem);font-weight:300;margin-bottom:16px;\">Бесплатная <strong>консультация</strong></h2>\n          <p style=\"color:var(--text-secondary);margin-bottom:32px;\">Расскажите о вашей задаче — я предложу оптимальное решение и рассчитаю стоимость</p>\n          <div class=\"contact-info-item\">\n            <div class=\"contact-info-icon\">📱</div>\n            <div>\n              <h4>Телефон</h4>\n              <a href=\"tel:+79613022112\">+7 (961) 302-21-12</a>\n            </div>\n          </div>\n          <div class=\"contact-info-item\">\n            <div class=\"contact-info-icon\">✉️</div>\n            <div>\n              <h4>Email</h4>\n              <a href=\"mailto:m.perepechay@yandex.ru\">m.perepechay@yandex.ru</a>\n            </div>\n          </div>\n          <div class=\"contact-info-item\">\n            <div class=\"contact-info-icon\">📍</div>\n            <div>\n              <h4>Локация</h4>\n              <p>Ростов-на-Дону</p>\n            </div>\n          </div>\n          <!-- Мессенджеры — отдельной строкой ПОД «Локацией»: в прежней разметке\n               они лежали внутри flex-строки пункта и сжимали город в столбик. -->\n          <div class=\"messengers hero-messengers\">\n          <a href=\"https://wa.me/79613022112\" class=\"messenger-btn messenger-whatsapp\" target=\"_blank\" rel=\"noopener\">\n            <span class=\"messenger-icon\">💬</span> WhatsApp\n          </a>\n          <a href=\"https://t.me/Mariya061\" class=\"messenger-btn messenger-telegram\" target=\"_blank\" rel=\"noopener\">\n            <span class=\"messenger-icon\">✈️</span> Telegram\n          </a>\n          <a href=\"https://max.ru/u/f9LHodD0cOLiuQ9EgyjlbHIJwJl6MM59mjwQFfIGh0UQE-CLoaQb-A60M0U\" class=\"messenger-btn messenger-max\" target=\"_blank\" rel=\"noopener\">\n            <span class=\"messenger-icon\">Ⓜ️</span> MAX\n          </a>\n        </div>\n      </div>\n        <div class=\"anim anim-delay-1\">\n          <form data-validate=\"\" data-lead-form data-page=\"home\" id=\"home-lead-form\">\n            <input type=\"hidden\" name=\"page\" value=\"home\">\n            <input type=\"hidden\" name=\"source\" value=\"home:form\">\n            <!-- Параметры калькулятора: заполняются кнопкой «Зафиксировать этот расчёт» -->\n            <input type=\"hidden\" name=\"calc_staff\" value=\"\" data-calc-field=\"staff\">\n            <input type=\"hidden\" name=\"calc_tier\" value=\"\" data-calc-field=\"tier\">\n            <input type=\"hidden\" name=\"calc_salary\" value=\"\" data-calc-field=\"salary\">\n            <input type=\"hidden\" name=\"calc_savings_month\" value=\"\" data-calc-field=\"savings\">\n            <input type=\"hidden\" name=\"company_website\" value=\"\">\n            <div class=\"form-grid\">\n              <div class=\"form-group\">\n                <label class=\"form-label\">Ваше имя *</label>\n                <input type=\"text\" name=\"name\" class=\"form-input\" placeholder=\"Иван Иванов\" required=\"\">\n                <span class=\"form-error\">Укажите имя</span>\n              </div>\n              <div class=\"form-group\">\n                <label class=\"form-label\">Телефон *</label>\n                <input type=\"tel\" name=\"phone\" class=\"form-input\" data-mask=\"phone\" placeholder=\"+7 (___) ___-__-__\" required=\"\">\n                <span class=\"form-error\">Укажите корректный телефон</span>\n              </div>\n              <div class=\"form-group\">\n                <label class=\"form-label\">Email</label>\n                <input type=\"email\" name=\"email\" class=\"form-input\" placeholder=\"your@email.ru\">\n                <span class=\"form-error\">Укажите корректный email</span>\n              </div>\n              <div class=\"form-group\">\n                <label class=\"form-label\">Услуга</label>\n                <select name=\"service\" class=\"form-select\">\n                  <option value=\"\">Выберите услугу</option>\n                  <option value=\"subscription\">Абонентское обслуживание