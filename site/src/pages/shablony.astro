  .template-download { color: var(--accent-text,#b6daff); }
  .template-request {
    display: inline-flex; align-items: center; justify-content: center; min-height: 38px;
    padding: 8px 13px; border: 1px solid var(--accent-border,rgba(88,166,255,.42)); border-radius: 9px;
    color: var(--on-accent,#f8fbff); background: var(--grad-btn,linear-gradient(135deg,#2563eb,#1d4ed8));
