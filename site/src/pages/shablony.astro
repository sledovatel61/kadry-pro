  .template-empty { padding: 30px; border: 1px dashed var(--border-light,rgba(255,255,255,.28)); border-radius: 14px; color: var(--text-secondary,#c1cbd8); text-align: center; background: linear-gradient(145deg,rgba(26,39,64,.55),rgba(14,21,36,.72)); }
  .templates-assurance { max-width: 1236px; margin: 0 auto 80px; padding: 25px; display: flex; align-items: center; gap: 18px; border: 1px solid var(--border-color,rgba(255,255,255,.15)); border-radius: 18px; background: var(--grad-card,linear-gradient(165deg,rgba(26,39,64,.9),rgba(14,21,36,.97))); box-shadow: inset 0 1px 0 rgba(255,255,255,.1),0 14px 34px rgba(4,8,20,.4); }
