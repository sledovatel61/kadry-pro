  .template-badge--paid { color: var(--accent-secondary-text,#fde4b8); border: 1px solid var(--accent-secondary-border,rgba(234,185,104,.35)); background: linear-gradient(145deg,rgba(234,185,104,.09),rgba(14,21,36,.94)); backdrop-filter: blur(8px); }
  .template-tile__number { position: absolute; z-index: 2; pointer-events: none; right: 10px; bottom: 10px; padding: 5px 8px; border-radius: 7px; color: var(--text-primary,#f2f6fb); background: rgba(8,15,27,.82); font: 600 .7rem 'JetBrains Mono',monospace; }
  .template-tile__content { flex: 1 1 auto; padding: 17px; display: flex; flex-direction: column; min-height: 205px; }
