  .template-catalog__heading p:not(.eyebrow) { color: var(--text-secondary,#c1cbd8); }
  .template-search { display: flex; align-items: center; gap: 11px; width: min(100%,330px); padding: 0 15px; border: 1px solid var(--border-color,rgba(255,255,255,.15)); border-radius: 12px; background: var(--bg-card,#17202b); color: var(--accent,#58a6ff); font-size: 1.55rem; }
  .template-search input { width: 100%; min-height: 48px; border: 0; outline: 0; background: transparent; color: var(--text-primary,#f2f6fb); font: inherit; font-size: .95rem; }
  .template-search input::placeholder { color: var(--text-muted,#94a2b2); }
