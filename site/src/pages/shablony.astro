  .template-filters button { flex: 0 0 auto; min-height: 39px; padding: 0 13px; border: 1px solid var(--border-color,rgba(255,255,255,.15)); border-radius: 999px; color: var(--text-secondary,#c1cbd8); background: var(--bg-card,#17202b); font: 600 .83rem inherit; cursor: pointer; }
  .template-filters button.is-active { border-color: var(--accent-border,rgba(88,166,255,.38)); color: var(--on-accent,#f8fbff); background: var(--grad-btn,linear-gradient(135deg,#2563eb,#1d4ed8)); box-shadow: inset 0 1px 0 rgba(255,255,255,.24), 0 6px 16px rgba(20,74,180,.25); }
  .template-filters button span { margin-left: 4px; opacity: .85; }
  .template-results { color: var(--text-muted,#94a2b2); font-size: .85rem; }
  .template-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 17px; margin-top: 18px; }
  .template-tile {
    scroll-margin-top: 96px;
    display: flex; flex-direction: column;
    overflow: hidden; border: 1px solid var(--border-color,rgba(255,255,255,.15)); border-radius: 17px;
