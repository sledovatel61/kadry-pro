---
import Base from '../layouts/Base.astro';
import catalog from '../../content/templates.json';
import prices from '../../content/prices.json';
import { OWNER } from '../data/site.ts';
import { CONSENT_VERSION } from '../shared/leads-endpoint.ts';

const categories = [...new Set(catalog.items.map((item) => item.category))];
const freeCount = catalog.items.filter((item) => item.free).length;
const paidCount = catalog.items.length - freeCount;
const previewCount = catalog.items.filter((item) => Boolean(item.preview)).length;
/* Комплект переработанных редактируемых DOCX подтверждён только для № 01–10
   (10 файлов в agents/agent-02/docx-01-10, коммит c70ac32). Для остальных
   карточек обещать DOCX нельзя — в репозитории есть лишь PDF образца. */
const DOCX_READY_IDS = new Set(['01', '02', '03', '04', '05', '06', '07', '08', '09', '10']);
const enrichedItems = catalog.items.map((item, index) => {
  const isReworkedDocx = DOCX_READY_IDS.has(String(item.id).padStart(2, '0'));
  return {
    ...item,
    isReworkedDocx,
    previewW: isReworkedDocx ? 1080 : 595,
    previewH: isReworkedDocx ? 1528 : 842,
    loadingMode: (index < 4 ? 'eager' : 'lazy') as 'eager' | 'lazy',
  };
});
const templatesGroup = prices.groups.find((g) => g.id === 'templates');
const bundle64Item = templatesGroup?.items.find((it) => it.id === 'bundle-64');
const bundle64Price = bundle64Item?.price ?? 3500;
const bundle64Name = bundle64Item?.name ?? 'Полный набор из 64 шаблонов';

/* JSON-LD ItemList — как на старом shablony.html: 64 позиции с якорями #sNN. */
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Кадровые шаблоны — Кадры-Про',
  numberOfItems: catalog.items.length,
  itemListElement: catalog.items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: `https://kadry-pro.ru/shablony.html#s${item.id}`,
  })),
};
---
<Base title="Кадровые шаблоны: 20 бесплатно и 44 платных — Кадры-Про" description="Каталог из 64 кадровых документов: 20 шаблонов можно скачать бесплатно, платные доступны с водяным превью первой страницы." page="shablony" jsonLd={[itemListJsonLd]}>
  <section class="templates-hero bg-inner-scene bg-gallery-scene">
    <div class="templates-hero__inner">
      <p class="eyebrow">Практические материалы · 2026</p>
      <h1>Кадровые документы<br /><span>для реальной работы</span></h1>
      <p class="templates-hero__lead">Каталог из {catalog.items.length} документов: {freeCount} бесплатно, ещё {paidCount} можно предварительно посмотреть по водяной копии первой страницы.</p>
      <div class="templates-hero__actions"><a class="templates-primary" href="/shablony/free-bundle-20.zip" download>Скачать бесплатный набор из 20</a><a class="templates-secondary" href="#catalog"><span>Выбрать документ</span> <span aria-hidden="true">↓</span></a></div>
      <div class="templates-proof"><span><b>20</b> бесплатных PDF</span><span><b>{previewCount}</b> водяных превью</span><span><b>0</b> платных PDF в открытой папке</span></div>
    </div>
    <!-- Вместо одинокого кружка «КП» — композиция «Кобальт × Аврора»:
         веер из трёх стеклянных документов. Слой декоративный, поэтому
         aria-hidden и никаких интерактивных элементов внутри. -->
    <div class="templates-hero__docs" aria-hidden="true">
      <div class="hero-doc hero-doc--back">
        <div class="hero-doc__top">
          <span class="hero-doc__pdf">PDF</span>
          <span class="hero-doc__lines" aria-hidden="true"></span>
        </div>
        <strong>ПВТР и положения</strong>
        <span class="hero-doc__meta">Правила · положения · инструкции</span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
      </div>
      <div class="hero-doc hero-doc--mid">
        <div class="hero-doc__top">
          <span class="hero-doc__pdf">PDF</span>
          <span class="hero-doc__lines" aria-hidden="true"></span>
        </div>
        <strong>Приказы и СОУТ</strong>
        <span class="hero-doc__meta">Приказы · журналы · карты СОУТ</span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
      </div>
      <div class="hero-doc hero-doc--front">
        <div class="hero-doc__top">
          <span class="hero-doc__pdf">PDF</span>
          <span class="hero-doc__lines" aria-hidden="true"></span>
        </div>
        <strong>Трудовой договор</strong>
        <span class="hero-doc__meta">ТК РФ · редакция 2026</span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
      </div>
    </div>
  </section>

  <section class="template-catalog bg-inner-scene bg-gallery-scene" id="catalog" aria-labelledby="catalog-title">
    <div class="template-catalog__heading"><div><p class="eyebrow">Библиотека</p><h2 id="catalog-title">Все шаблоны</h2><p>Бесплатные документы доступны сразу. Платные файлы не размещены в открытом доступе. Редактируемый DOCX есть для № 01–10 и отправляется вручную после заявки; у остальных позиций — PDF.</p></div>
      <label class="template-search"><span class="sr-only">Поиск документов</span><span aria-hidden="true">⌕</span><input type="search" id="template-search" placeholder="Найти документ…" autocomplete="off" /></label>
    </div>
    <div class="template-filters" role="group" aria-label="Фильтр по категории"><button type="button" class="is-active" data-filter="all" aria-pressed="true">Все <span>{catalog.items.length}</span></button>{categories.map((category) => <button type="button" data-filter={category} aria-pressed="false">{category}</button>)}</div>
    <p class="template-results" id="template-results" aria-live="polite">Показано {catalog.items.length} из {catalog.items.length} документов</p>
    <div class="template-grid" id="template-grid">
      {enrichedItems.map((item) => (
        <article id={`s${item.id}`} class="template-tile" data-template-card data-category={item.category} data-title={`${item.name} ${item.description}`.toLocaleLowerCase('ru')}>
          <div class="template-tile__visual">
            {item.preview ? (
              <button
                type="button"
                class:list={['template-tile__thumb-btn', item.isReworkedDocx && 'template-tile__thumb-btn--hd']}
                data-open-preview
                data-preview-id={item.id}
                data-preview-title={item.name}
                data-src={item.preview}
                data-preview-width={String(item.previewW)}
                data-preview-height={String(item.previewH)}
                data-preview-price={String(item.price)}
                data-preview-free={item.free ? '1' : '0'}
                data-href={item.free && item.file ? item.file : undefined}
                data-preview-docx={item.isReworkedDocx ? '1' : '0'}
                aria-haspopup="dialog"
                aria-label={`Посмотреть первую страницу шаблона № ${item.id} «${item.name}»`}
              >
                <img
                  src={item.preview}
                  alt={`Предпросмотр первой страницы шаблона № ${item.id} «${item.name}»`}
                  loading={item.loadingMode}
                  decoding="async"
                  width={item.previewW}
                  height={item.previewH}
                />
                <span class="template-tile__zoom-pill" aria-hidden="true">Предпросмотр</span>
              </button>
            ) : (
              <div class="template-tile__free-cover" aria-hidden="true"><span>{item.icon}</span><small>КАДРЫ-ПРО · PDF</small></div>
            )}
            <span class:list={['template-badge', item.free ? 'template-badge--free' : 'template-badge--paid']}>{item.free ? 'Бесплатно' : `${item.price.toLocaleString('ru-RU')} ₽`}</span>
            <span class="template-tile__number">№ {item.id}</span>
          </div>
          <div class="template-tile__content">
            <span class="template-tile__category">{item.category}</span>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <div class="template-tile__actions">
              {item.preview && (
                <button
                  type="button"
                  class="template-preview-btn"
                  data-open-preview
                  data-preview-id={item.id}
                  data-preview-title={item.name}
                  data-src={item.preview}
                  data-preview-width={String(item.previewW)}
                  data-preview-height={String(item.previewH)}
                  data-preview-price={String(item.price)}
                  data-preview-free={item.free ? '1' : '0'}
                  data-href={item.free && item.file ? item.file : undefined}
                  data-preview-docx={item.isReworkedDocx ? '1' : '0'}
                  aria-haspopup="dialog"
                >
                  Посмотреть первую страницу
                </button>
              )}
              <div class="template-tile__footer">
                {item.free ? (
                  <a class="template-download" href={item.file} download>Скачать PDF <span aria-hidden="true">↗</span></a>
                ) : (
                  <>
                    <span class="template-price">{item.price.toLocaleString('ru-RU')} ₽</span>
                    <button type="button" class="template-request" data-open-template data-template-id={item.id} data-template-title={item.name} data-template-price={String(item.price)} data-template-package="single" aria-haspopup="dialog">Оставить заявку</button>
                  </>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="template-empty" id="template-empty" hidden>По этому запросу документы не найдены. Попробуйте изменить слова поиска.</p>
  </section>
  <section class="templates-assurance"><span class="templates-assurance__mark">✓</span><div><h2>Без скрытой раздачи платных файлов</h2><p>Платные документы отправляются Марией лично после согласования реквизитов и подтверждения оплаты. Выберите нужную карточку и нажмите «Оставить заявку» или закажите весь набор целиком — никаких ненастроенных платёжных кнопок на сайте.</p></div><div class="templates-assurance__actions"><button type="button" class="template-bundle-btn" data-open-template data-template-title={bundle64Name} data-template-price={String(bundle64Price)} data-template-package="full" aria-haspopup="dialog">Весь набор · {bundle64Price.toLocaleString('ru-RU')} ₽</button><a href="/contact.html?service=templates">Задать вопрос</a></div></section>

  <dialog id="template-preview-modal" class="template-preview-modal" aria-labelledby="template-preview-title">
    <div class="template-preview__panel">
      <div class="template-preview__header">
        <div class="template-preview__heading">
          <span class="template-preview__badge" data-preview-modal-badge>№ 01 · Бесплатно</span>
          <h2 id="template-preview-title" class="template-preview__title" data-preview-modal-title>Трудовой договор бессрочный</h2>
        </div>
        <div class="template-preview__controls">
          <button type="button" class="template-preview__zoom" data-preview-zoom aria-pressed="false">Крупнее для чтения +</button>
          <button type="button" class="template-preview__close" data-close-preview aria-label="Закрыть предпросмотр">✕</button>
        </div>
      </div>

      <div class="template-preview__viewport" data-preview-viewport>
        <img
          class="template-preview__img"
          data-preview-modal-img
          src="/shablony/previews/01.jpg"
          alt="Первая страница шаблона № 01 «Трудовой договор бессрочный»"
          width="1080"
          height="1528"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="template-preview__footer">
        <p class="template-preview__caption" data-preview-modal-caption>
          Первая страница шаблона. В открытой сборке DOCX нет: после заявки Мария свяжется с вами и пришлёт редактируемый DOCX вручную.
        </p>
        <div class="template-preview__actions">
          <a
            class="template-preview__download"
            data-preview-download
            href="/shablony/free/01_Трудовой_договор_бессрочный.pdf"
            download
            hidden
          >
            Скачать PDF бесплатно <span aria-hidden="true">↗</span>
          </a>
          <button type="button" class="template-request template-preview__order" data-preview-order>
            Оставить заявку · 500 ₽
          </button>
        </div>
      </div>
    </div>
  </dialog>

  <dialog id="template-lead-modal" class="template-modal" aria-labelledby="template-modal-title">
    <div class="template-modal__body">
      <button type="button" class="template-modal__close" data-close-template aria-label="Закрыть окно">✕</button>
      <div class="template-modal__summary">
        <span class="template-modal__badge" data-template-modal-badge>Платный шаблон</span>
        <span class="template-modal__price" data-template-modal-price>500 ₽</span>
      </div>
      <h2 id="template-modal-title" class="template-modal__title" data-template-modal-doc>Заявка на шаблон</h2>
      <p class="template-modal__lead">
        Оплата на сайте пока не проводится: Мария получит заявку, свяжется с вами,
        согласует оплату и отправит готовый документ вручную.
      </p>

      <form
        id="template-lead-form"
        class="template-modal__form"
        data-lead-form
        data-lead-kind="template"
        data-page="shablony"
        data-consent-version={CONSENT_VERSION}
        novalidate
      >
        <div class="form-group">
          <label class="form-label" for="template-lead-name">Ваше имя *</label>
          <input
            id="template-lead-name"
            class="form-input"
            type="text"
            name="name"
            autocomplete="name"
            maxlength="60"
            placeholder="Иван Иванов"
            required
          />
          <span class="form-error" data-error="name" hidden></span>
        </div>

        <div class="form-group">
          <label class="form-label" for="template-lead-phone">Телефон *</label>
          <input
            id="template-lead-phone"
            class="form-input"
            type="tel"
            name="phone"
            data-mask="phone"
            autocomplete="tel"
            inputmode="tel"
            placeholder="+7 (___) ___-__-__"
            required
          />
          <span class="form-error" data-error="phone" hidden></span>
        </div>

        <div class="template-modal__row">
          <div class="form-group">
            <label class="form-label" for="template-lead-method">Как удобнее связаться</label>
            <select id="template-lead-method" class="form-input" name="contact_method">
              <option value="telegram">Написать в Telegram</option>
              <option value="whatsapp">Написать в WhatsApp</option>
              <option value="max">Написать в MAX</option>
              <option value="call">Позвонить по телефону</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="template-lead-email">Почта для файла <span class="template-modal__opt" data-template-email-opt>(по желанию)</span></label>
            <input
              id="template-lead-email"
              class="form-input"
              type="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              maxlength="120"
              placeholder="name@example.ru"
            />
            <span class="form-error" data-error="email" hidden></span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="template-lead-comment">Комментарий <span class="template-modal__opt">(необязательно)</span></label>
          <textarea
            id="template-lead-comment"
            class="form-textarea"
            name="comment"
            rows="2"
            maxlength="2000"
            placeholder="Например: пришлите в Telegram, ООО на УСН"
          ></textarea>
        </div>

        <!-- Офскрин-ловушка (как в QuickLeadForm): не теряет заявку, если мобильное автозаполнение впишет организацию -->
        <input type="text" name="company_website" class="quick-lead-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <label class="form-checkbox template-modal__consent">
          <input type="checkbox" name="consent" required />
          <span>
            Согласен на обработку персональных данных по
            <a href="/privacy.html" target="_blank" rel="noopener">политике конфиденциальности</a>
            и <a href="/consent.html" target="_blank" rel="noopener">согласию на обработку ПДн</a>.
          </span>
        </label>
        <span class="form-error" data-error="consent" hidden></span>

        <button type="submit" class="btn btn--primary template-modal__submit">Отправить заявку</button>
        <p class="lead-error" data-lead-error="template-lead-form" role="alert" hidden></p>
      </form>

      <div class="template-modal__success" data-lead-success="template-lead-form" role="status" aria-live="polite" hidden>
        <h3 data-success-title>Заявка принята — Мария ответит в рабочее время.</h3>
        <p data-success-note hidden></p>
        <p class="template-modal__ticket" data-ticket></p>
        <p class="template-modal__direct">
          Если вопрос срочный: <a href={OWNER.phoneHref}>{OWNER.phone}</a> ·
          <a href={OWNER.telegram} target="_blank" rel="noopener">Telegram {OWNER.telegramHandle}</a>
        </p>
        <button type="button" class="template-modal__done" data-close-template>Закрыть окно</button>
      </div>
    </div>
  </dialog>
</Base>
<script>
  import '../client/template-modal.ts';
  const cards = [...document.querySelectorAll<HTMLElement>('[data-template-card]')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const search = document.querySelector<HTMLInputElement>('#template-search');
  const results = document.querySelector<HTMLElement>('#template-results');
  const empty = document.querySelector<HTMLElement>('#template-empty');
  let category = 'all';
  function updateCatalog() {
    const query = (search?.value ?? '').trim().toLocaleLowerCase('ru');
    let visible = 0;
    for (const card of cards) {
      const matches = (category === 'all' || card.dataset.category === category) && (!query || (card.dataset.title ?? '').includes(query));
      card.hidden = !matches;
      if (matches) visible++;
    }
    if (results) results.textContent = `Показано ${visible} из ${cards.length} документов`;
    if (empty) empty.hidden = visible !== 0;
  }
  filters.forEach((button) => button.addEventListener('click', () => {
    category = button.dataset.filter ?? 'all';
    filters.forEach((item) => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); });
    updateCatalog();
  }));
  search?.addEventListener('input', updateCatalog);
</script>
<style>
  .templates-hero {
    position: relative; overflow: hidden; min-height: 490px; padding: clamp(75px,10vw,130px) 22px 72px;
    background:
      radial-gradient(ellipse at 78% 12%, var(--accent-glow,rgba(88,166,255,.16)) 0, transparent 42%),
      radial-gradient(ellipse at 18% 75%, var(--accent-secondary-glow,rgba(234,185,104,.10)) 0, transparent 38%),
      linear-gradient(135deg, #101a2b 0%, var(--bg-primary,#0f141b) 52%, #111827 100%);
    border-bottom: 1px solid var(--border-color,rgba(255,255,255,.15));
  }
  .templates-hero__inner { position: relative; z-index: 1; max-width: 1180px; margin: auto; }
  .eyebrow { margin: 0 0 12px; color: var(--accent,#58a6ff); font-size: .76rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .templates-hero h1 { max-width: 790px; margin: 0; color: var(--text-primary,#f2f6fb); font-size: clamp(2.8rem,7vw,5.5rem); line-height: .98; letter-spacing: -.055em; }
  .templates-hero h1 span {
    color: transparent; background: var(--grad-heading,linear-gradient(125deg,#ffffff 0%,#9fd0ff 55%,#eab968 100%));
    -webkit-background-clip: text; background-clip: text;
  }
  .templates-hero__lead { max-width: 660px; margin: 24px 0 27px; color: var(--text-secondary,#c1cbd8); font-size: 1.12rem; line-height: 1.65; }
  .templates-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .templates-primary,.templates-secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 20px; border-radius: 11px; text-decoration: none; font-weight: 750; }
  .templates-primary {
    color: var(--on-accent,#f8fbff); background: var(--grad-btn,linear-gradient(135deg,#2563eb,#1d4ed8));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.24), 0 8px 22px rgba(20,74,180,.28); transition: transform .2s, box-shadow .2s, background .2s;
  }
  .templates-secondary { border: 1px solid var(--border-light,rgba(255,255,255,.28)); color: var(--text-primary,#f2f6fb); background: rgba(18,29,48,.42); }
  .templates-proof { display: flex; gap: 28px; margin-top: 36px; color: var(--text-secondary,#c1cbd8); font-size: .9rem; }
  .templates-proof b { color: var(--text-primary,#f2f6fb); font-size: 1.12rem; }
  /* ---------------------------------------------------------------
     Композиция «Кобальт × Аврора»: веер из трёх стеклянных документов
     вместо одинокого кружка «КП». Кобальт — холодное стекло и синий
     кант, Аврора — холодно-золотой блик сверху и тёплый подсвет снизу.
     --------------------------------------------------------------- */
  .templates-hero__docs {
    position: absolute; right: 6%; top: 50%; width: 300px; height: 330px;
    --hero-docs-scale: 1;
    transform: translateY(-50%) scale(var(--hero-docs-scale)); pointer-events: none;
    animation: heroDocsFloat 7s ease-in-out infinite;
  }
  @keyframes heroDocsFloat {
    0%, 100% { transform: translateY(-50%) scale(var(--hero-docs-scale)); }
    50% { transform: translateY(calc(-50% - 12px)) scale(var(--hero-docs-scale)); }
  }
  .hero-doc {
    position: absolute; left: 50%; top: 50%; width: 250px; min-height: 316px;
    display: flex; flex-direction: column; gap: 8px; padding: 18px 18px 16px;
    border-radius: 16px; overflow: hidden;
    border: 1px solid rgba(126, 172, 235, .34);
    background:
      linear-gradient(160deg, rgba(30, 49, 73, .88) 0%, rgba(17, 27, 45, .9) 58%, rgba(12, 20, 34, .94) 100%);
    box-shadow:
      inset 0 1px 0 rgba(198, 226, 255, .22),
      inset 0 -1px 0 rgba(0, 0, 0, .4),
      0 26px 48px -22px rgba(0, 0, 0, .92);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    transform-origin: 50% 90%;
  }
  /* Аврора: тёплый золотой блик на верхней кромке и холодный отблеск внизу */
  .hero-doc::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(120% 60% at 14% 0%, rgba(234, 185, 104, .20) 0%, transparent 58%),
      radial-gradient(100% 55% at 88% 100%, rgba(86, 155, 255, .22) 0%, transparent 62%);
  }
  .hero-doc strong, .hero-doc .hero-doc__meta, .hero-doc .hero-doc__top, .hero-doc .hero-doc__sheet {
    position: relative; z-index: 1;
  }
  .hero-doc strong { color: var(--text-primary, #f2f6fb); font-size: 1rem; line-height: 1.3; letter-spacing: -.01em; }
  .hero-doc__meta { color: var(--hero-doc-meta, #d7e0ea); font-size: .74rem; line-height: 1.4; }
  .hero-doc__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px; }
  .hero-doc__pdf {
    display: inline-grid; place-items: center; min-width: 40px; padding: 3px 8px;
    border-radius: 7px; color: var(--on-accent, #f8fbff); font: 800 .64rem/1 'Inter', system-ui, sans-serif;
    letter-spacing: .1em;
    background: linear-gradient(135deg, #0e7490 0%, #2563eb 52%, #4338ca 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .28), 0 4px 12px -4px rgba(20, 74, 180, .7);
  }
  .hero-doc__lines {
    width: 54px; height: 6px; border-radius: 99px;
    background: linear-gradient(90deg, rgba(234, 185, 104, .55), rgba(126, 172, 235, .12));
  }
  /* Строки-«текст» документа: три светлые полоски, последняя короче */
  .hero-doc__sheet {
    display: block; height: 5px; border-radius: 99px;
    background: rgba(178, 205, 235, .22);
  }
  .hero-doc__sheet:nth-of-type(2) { width: 88%; }
  .hero-doc__sheet:nth-of-type(3) { width: 72%; }
  .hero-doc__sheet:nth-of-type(4) { width: 54%; }

  .hero-doc--back  { transform: translate(-58%, -50%) rotate(-15deg) scale(.9);  filter: saturate(.85) brightness(.82); }
  .hero-doc--mid   { transform: translate(-46%, -50%) rotate(-6deg)  scale(.95); filter: saturate(.92) brightness(.92); }
  .hero-doc--front { transform: translate(-50%, -50%) rotate(7deg);              z-index: 2; }
  .template-catalog { max-width: 1280px; margin: auto; padding: 76px 22px 88px; }
