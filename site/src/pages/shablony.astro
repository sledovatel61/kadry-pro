---
import Base from '../layouts/Base.astro';
import catalog from '../../content/templates.json';
const categories = [...new Set(catalog.items.map((item) => item.category))];
const freeCount = catalog.items.filter((item) => item.free).length;
const paidCount = catalog.items.length - freeCount;

/* JSON-LD ItemList — как на старом shablony.html: 64 позиции с якорями #sNN. */
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Кадровые шаблоны — Кадры-Про',
  numberOfItems: catalog.items.length,
  itemListElement: catalog.items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: `https://kadry-pro.ru/shablony.html#s${item.id}`,
  })),
};
---
<Base title="Кадровые шаблоны: 20 бесплатно и 44 платных — Кадры-Про" description="Каталог из 64 кадровых документов: 20 шаблонов можно скачать бесплатно, платные доступны с водяным превью первой страницы." page="shablony" jsonLd={[itemListJsonLd]}>
  <section class="templates-hero bg-inner-scene bg-gallery-scene">
    <div class="templates-hero__inner">
      <p class="eyebrow">Практические материалы · 2026</p>
      <h1>Кадровые документы<br /><span>для реальной работы</span></h1>
      <p class="templates-hero__lead">Каталог из {catalog.items.length} документов: {freeCount} бесплатно, ещё {paidCount} можно предварительно посмотреть по водяной копии первой страницы.</p>
      <div class="templates-hero__actions"><a class="templates-primary" href="/shablony/free-bundle-20.zip" download>Скачать бесплатный набор из 20</a><a class="templates-secondary" href="#catalog"><span>Выбрать документ</span> <span aria-hidden="true">↓</span></a></div>
      <div class="templates-proof"><span><b>20</b> бесплатных PDF</span><span><b>{paidCount}</b> водяных превью</span><span><b>0</b> платных PDF в открытой папке</span></div>
    </div>
    <!-- Вместо одинокого кружка «КП» — композиция «Кобальт × Аврора»:
         веер из трёх стеклянных документов. Слой декоративный, поэтому
         aria-hidden и никаких интерактивных элементов внутри. -->
    <div class="templates-hero__docs" aria-hidden="true">
      <div class="hero-doc hero-doc--back">
        <div class="hero-doc__top">
          <span class="hero-doc__pdf">PDF</span>
          <span class="hero-doc__lines" aria-hidden="true"></span>
        </div>
        <strong>ПВТР и положения</strong>
        <span class="hero-doc__meta">Правила · положения · инструкции</span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
      </div>
      <div class="hero-doc hero-doc--mid">
        <div class="hero-doc__top">
          <span class="hero-doc__pdf">PDF</span>
          <span class="hero-doc__lines" aria-hidden="true"></span>
        </div>
        <strong>Приказы и СОУТ</strong>
        <span class="hero-doc__meta">Приказы · журналы · карты СОУТ</span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
      </div>
      <div class="hero-doc hero-doc--front">
        <div class="hero-doc__top">
          <span class="hero-doc__pdf">PDF</span>
          <span class="hero-doc__lines" aria-hidden="true"></span>
        </div>
        <strong>Трудовой договор</strong>
        <span class="hero-doc__meta">ТК РФ · редакция 2026</span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
        <span class="hero-doc__sheet"></span>
      </div>
    </div>
  </section>

  <section class="template-catalog bg-inner-scene bg-gallery-scene" id="catalog" aria-labelledby="catalog-title">
    <div class="template-catalog__heading"><div><p class="eyebrow">Библиотека</p><h2 id="catalog-title">Все шаблоны</h2><p>Бесплатные документы доступны сразу. Платные файлы не размещены в открытом доступе.</p></div>
      <label class="template-search"><span class="sr-only">Поиск документов</span><span aria-hidden="true">⌕</span><input type="search" id="template-search" placeholder="Найти документ…" autocomplete="off" /></label>
    </div>
    <div class="template-filters" role="group" aria-label="Фильтр по категории"><button type="button" class="is-active" data-filter="all" aria-pressed="true">Все <span>{catalog.items.length}</span></button>{categories.map((category) => <button type="button" data-filter={category} aria-pressed="false">{category}</button>)}</div>
    <p class="template-results" id="template-results" aria-live="polite">Показано {catalog.items.length} из {catalog.items.length} документов</p>
    <div class="template-grid" id="template-grid">
      {catalog.items.map((item) => <article class="template-tile" data-template-card data-category={item.category} data-title={`${item.name} ${item.description}`.toLocaleLowerCase('ru')}>
        <div class="template-tile__visual">{item.free ? <div class="template-tile__free-cover" aria-hidden="true"><span>{item.icon}</span><small>КАДРЫ-ПРО · PDF</small></div> : <img src={item.preview} alt={`Водяное превью первой страницы документа «${item.name}»`} loading="lazy" width="280" height="396" />}<span class:list={['template-badge', item.free ? 'template-badge--free' : 'template-badge--paid']}>{item.free ? 'Бесплатно' : `${item.price.toLocaleString('ru-RU')} ₽`}</span><span class="template-tile__number">№ {item.id}</span></div>
        <div class="template-tile__content"><span class="template-tile__category">{item.category}</span><h3>{item.name}</h3><p>{item.description}</p><div class="template-tile__footer">{item.free ? <a class="template-download" href={item.file} download>Скачать PDF <span aria-hidden="true">↗</span></a> : <><span class="template-price">{item.price.toLocaleString('ru-RU')} ₽</span><a class="template-request" href="/contact.html?service=templates">Уточнить покупку</a></>}</div></div>
      </article>)}
    </div>
    <p class="template-empty" id="template-empty" hidden>По этому запросу документы не найдены. Попробуйте изменить слова поиска.</p>
  </section>
  <section class="templates-assurance"><span class="templates-assurance__mark">✓</span><div><h2>Без скрытой раздачи платных файлов</h2><p>Платные документы доступны только после подтверждения оплаты. Свяжитесь с Марией, чтобы уточнить состав, актуальность и способ получения. Оплата проводится по индивидуально согласованным реквизитам — никаких ненастроенных платёжных кнопок на сайте.</p></div><a href="/contact.html?service=templates">Задать вопрос</a></section>
</Base>
<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-template-card]')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const search = document.querySelector<HTMLInputElement>('#template-search');
  const results = document.querySelector<HTMLElement>('#template-results');
  const empty = document.querySelector<HTMLElement>('#template-empty');
  let category = 'all';
  function updateCatalog() {
    const query = (search?.value ?? '').trim().toLocaleLowerCase('ru');
    let visible = 0;
    for (const card of cards) {
      const matches = (category === 'all' || card.dataset.category === category) && (!query || (card.dataset.title ?? '').includes(query));
      card.hidden = !matches;
      if (matches) visible++;
    }
    if (results) results.textContent = `Показано ${visible} из ${cards.length} документов`;
    if (empty) empty.hidden = visible !== 0;
  }
  filters.forEach((button) => button.addEventListener('click', () => {
    category = button.dataset.filter ?? 'all';
    filters.forEach((item) => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); });
    updateCatalog();
  }));
  search?.addEventListener('input', updateCatalog);
</script>
<style>
  .templates-hero {
    position: relative; overflow: hidden; min-height: 490px; padding: clamp(75px,10vw,130px) 22px 72px;
    background:
      radial-gradient(ellipse at 78% 12%, var(--accent-glow,rgba(88,166,255,.16)) 0, transparent 42%),
      radial-gradient(ellipse at 18% 75%, var(--accent-secondary-glow,rgba(234,185,104,.10)) 0, transparent 38%),
      linear-gradient(135deg, #101a2b 0%, var(--bg-primary,#0f141b) 52%, #111827 100%);
    border-bottom: 1px solid var(--border-color,rgba(255,255,255,.15));
  }
  .templates-hero__inner { position: relative; z-index: 1; max-width: 1180px; margin: auto; }
  .eyebrow { margin: 0 0 12px; color: var(--accent,#58a6ff); font-size: .76rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .templates-hero h1 { max-width: 790px; margin: 0; color: var(--text-primary,#f2f6fb); font-size: clamp(2.8rem,7vw,5.5rem); line-height: .98; letter-spacing: -.055em; }
  .templates-hero h1 span {
    color: transparent; background: var(--grad-heading,linear-gradient(125deg,#ffffff 0%,#9fd0ff 55%,#eab968 100%));
    -webkit-background-clip: text; background-clip: text;
  }
  .templates-hero__lead { max-width: 660px; margin: 24px 0 27px; color: var(--text-secondary,#c1cbd8); font-size: 1.12rem; line-height: 1.65; }
  .templates-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .templates-primary,.templates-secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 20px; border-radius: 11px; text-decoration: none; font-weight: 750; }
  .templates-primary {
    color: var(--on-accent,#f8fbff); background: var(--grad-btn,linear-gradient(135deg,#2563eb,#1d4ed8));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.24), 0 8px 22px rgba(20,74,180,.28); transition: transform .2s, box-shadow .2s, background .2s;
  }
  .templates-secondary { border: 1px solid var(--border-light,rgba(255,255,255,.28)); color: var(--text-primary,#f2f6fb); background: rgba(18,29,48,.42); }
  .templates-proof { display: flex; gap: 28px; margin-top: 36px; color: var(--text-secondary,#c1cbd8); font-size: .9rem; }
  .templates-proof b { color: var(--text-primary,#f2f6fb); font-size: 1.12rem; }
  /* ---------------------------------------------------------------
     Композиция «Кобальт × Аврора»: веер из трёх стеклянных документов
     вместо одинокого кружка «КП». Кобальт — холодное стекло и синий
     кант, Аврора — холодно-золотой блик сверху и тёплый подсвет снизу.
     --------------------------------------------------------------- */
  .templates-hero__docs {
    position: absolute; right: 6%; top: 50%; width: 300px; height: 330px;
    --hero-docs-scale: 1;
    transform: translateY(-50%) scale(var(--hero-docs-scale)); pointer-events: none;
    animation: heroDocsFloat 7s ease-in-out infinite;
  }
  @keyframes heroDocsFloat {
    0%, 100% { transform: translateY(-50%) scale(var(--hero-docs-scale)); }
    50% { transform: translateY(calc(-50% - 12px)) scale(var(--hero-docs-scale)); }
  }
  .hero-doc {
    position: absolute; left: 50%; top: 50%; width: 250px; min-height: 316px;
    display: flex; flex-direction: column; gap: 8px; padding: 18px 18px 16px;
    border-radius: 16px; overflow: hidden;
    border: 1px solid rgba(126, 172, 235, .34);
    background:
      linear-gradient(160deg, rgba(30, 49, 73, .88) 0%, rgba(17, 27, 45, .9) 58%, rgba(12, 20, 34, .94) 100%);
    box-shadow:
      inset 0 1px 0 rgba(198, 226, 255, .22),
      inset 0 -1px 0 rgba(0, 0, 0, .4),
      0 26px 48px -22px rgba(0, 0, 0, .92);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    transform-origin: 50% 90%;
  }
  /* Аврора: тёплый золотой блик на верхней кромке и холодный отблеск внизу */
  .hero-doc::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(120% 60% at 14% 0%, rgba(234, 185, 104, .20) 0%, transparent 58%),
      radial-gradient(100% 55% at 88% 100%, rgba(86, 155, 255, .22) 0%, transparent 62%);
  }
  .hero-doc strong, .hero-doc .hero-doc__meta, .hero-doc .hero-doc__top, .hero-doc .hero-doc__sheet {
    position: relative; z-index: 1;
  }
  .hero-doc strong { color: var(--text-primary, #f2f6fb); font-size: 1rem; line-height: 1.3; letter-spacing: -.01em; }
  .hero-doc__meta { color: var(--hero-doc-meta, #d7e0ea); font-size: .74rem; line-height: 1.4; }
  .hero-doc__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px; }
  .hero-doc__pdf {
    display: inline-grid; place-items: center; min-width: 40px; padding: 3px 8px;
    border-radius: 7px; color: var(--on-accent, #f8fbff); font: 800 .64rem/1 'Inter', system-ui, sans-serif;
    letter-spacing: .1em;
    background: linear-gradient(135deg, #0e7490 0%, #2563eb 52%, #4338ca 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .28), 0 4px 12px -4px rgba(20, 74, 180, .7);
  }
  .hero-doc__lines {
    width: 54px; height: 6px; border-radius: 99px;
    background: linear-gradient(90deg, rgba(234, 185, 104, .55), rgba(126, 172, 235, .12));
  }
  /* Строки-«текст» документа: три светлые полоски, последняя короче */
  .hero-doc__sheet {
    display: block; height: 5px; border-radius: 99px;
    background: rgba(178, 205, 235, .22);
  }
  .hero-doc__sheet:nth-of-type(2) { width: 88%; }
  .hero-doc__sheet:nth-of-type(3) { width: 72%; }
  .hero-doc__sheet:nth-of-type(4) { width: 54%; }

  .hero-doc--back  { transform: translate(-58%, -50%) rotate(-15deg) scale(.9);  filter: saturate(.85) brightness(.82); }
  .hero-doc--mid   { transform: translate(-46%, -50%) rotate(-6deg)  scale(.95); filter: saturate(.92) brightness(.92); }
  .hero-doc--front { transform: translate(-50%, -50%) rotate(7deg);              z-index: 2; }
  .template-catalog { max-width: 1280px; margin: auto; padding: 76px 22px 88px; }
  .template-catalog__heading { display: flex; justify-content: space-between; align-items: end; gap: 28px; }
  .template-catalog h2 { margin: 0; font-size: clamp(2rem,4vw,3rem); letter-spacing: -.04em; }
  .template-catalog__heading p:not(.eyebrow) { color: var(--text-secondary,#c1cbd8); }
  .template-search { display: flex; align-items: center; gap: 11px; width: min(100%,330px); padding: 0 15px; border: 1px solid var(--border-color,rgba(255,255,255,.15)); border-radius: 12px; background: var(--bg-card,#17202b); color: var(--accent,#58a6ff); font-size: 1.55rem; }
  .template-search input { width: 100%; min-height: 48px; border: 0; outline: 0; background: transparent; color: var(--text-primary,#f2f6fb); font: inherit; font-size: .95rem; }
  .template-search input::placeholder { color: var(--text-muted,#94a2b2); }
  .template-filters { display: flex; gap: 9px; overflow: auto; padding: 24px 0 8px; scrollbar-width: thin; }
  .template-filters button { flex: 0 0 auto; min-height: 39px; padding: 0 13px; border: 1px solid var(--border-color,rgba(255,255,255,.15)); border-radius: 999px; color: var(--text-secondary,#c1cbd8); background: var(--bg-card,#17202b); font: 600 .83rem inherit; cursor: pointer; }
  .template-filters button.is-active { border-color: var(--accent-border,rgba(88,166,255,.38)); color: var(--on-accent,#f8fbff); background: var(--grad-btn,linear-gradient(135deg,#2563eb,#1d4ed8)); box-shadow: inset 0 1px 0 rgba(255,255,255,.24), 0 6px 16px rgba(20,74,180,.25); }
  .template-filters button span { margin-left: 4px; opacity: .85; }
  .template-results { color: var(--text-muted,#94a2b2); font-size: .85rem; }
  .template-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 17px; margin-top: 18px; }
  .template-tile {
    overflow: hidden; border: 1px solid var(--border-color,rgba(255,255,255,.15)); border-radius: 17px;
    background: var(--grad-card,linear-gradient(165deg,rgba(26,39,64,.9),rgba(14,21,36,.97)));
    box-shadow: var(--card-highlight,inset 0 1px 0 rgba(186,220,255,.10)), 0 12px 30px -10px rgba(4,8,20,.6);
    transition: transform .22s ease,border-color .22s ease,box-shadow .22s ease;
  }
  .template-tile:hover { transform: translateY(-5px); border-color: var(--accent-border,rgba(88,166,255,.48)); box-shadow: var(--card-highlight,inset 0 1px 0 rgba(186,220,255,.10)),0 18px 38px -10px rgba(4,8,20,.72),0 0 24px var(--accent-glow,rgba(88,166,255,.14)); }
  /* Spotlight Авроры: блик в точке курсора (координаты пишет site.ts) */
  @media (hover: hover) and (pointer: fine) {
    .template-tile {
      background-image: radial-gradient(280px circle at var(--spot-x, 50%) var(--spot-y, 50%), rgba(79, 209, 197, 0.09) 0%, rgba(88, 166, 255, 0.08) 45%, transparent 72%), var(--grad-card, linear-gradient(165deg, rgba(26, 39, 64, .9), rgba(14, 21, 36, .97)));
    }
  }
  .template-tile[hidden] { display: none; }
  .template-tile__visual { position: relative; aspect-ratio: 1.12; overflow: hidden; background: #121b2a; }
  .template-tile__visual img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .template-tile__free-cover {
    position: relative; isolation: isolate; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
    color: var(--accent-text,#b6daff);
    background: radial-gradient(circle at 18% 12%,var(--accent-glow,rgba(88,166,255,.16)),transparent 42%),repeating-linear-gradient(0deg,rgba(186,220,255,.035) 0 1px,transparent 1px 24px),repeating-linear-gradient(90deg,rgba(186,220,255,.035) 0 1px,transparent 1px 24px),linear-gradient(145deg,#1a2942 0%,var(--bg-card,#17202b) 48%,#0d1420 100%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), inset 0 -18px 36px rgba(3,9,20,.35);
  }
  .template-tile__free-cover::before { content: ''; position: absolute; z-index: -1; inset: 12% 17%; border: 1px solid rgba(186,220,255,.16); border-radius: 9px; box-shadow: 0 0 35px var(--accent-glow,rgba(88,166,255,.12)); }
  .template-tile__free-cover span { font-size: 3rem; filter: drop-shadow(0 5px 12px rgba(3,9,20,.4)); }
  .template-tile__free-cover small { font: 700 .62rem 'JetBrains Mono',monospace; letter-spacing: .1em; }
  .template-badge { position: absolute; top: 11px; left: 11px; padding: 6px 10px; border-radius: 999px; font-size: .73rem; font-weight: 800; }
  .template-badge--free { color: var(--on-accent,#f8fbff); background: var(--grad-btn,linear-gradient(135deg,#2563eb,#1d4ed8)); box-shadow: inset 0 1px 0 rgba(255,255,255,.24),0 5px 14px rgba(8,28,61,.4); }
  .template-badge--paid { color: var(--accent-secondary-text,#fde4b8); border: 1px solid var(--accent-secondary-border,rgba(234,185,104,.35)); background: linear-gradient(145deg,rgba(234,185,104,.09),rgba(14,21,36,.94)); backdrop-filter: blur(8px); }
  .template-tile__number { position: absolute; right: 10px; bottom: 10px; padding: 5px 8px; border-radius: 7px; color: var(--text-primary,#f2f6fb); background: rgba(8,15,27,.82); font: 600 .7rem 'JetBrains Mono',monospace; }
  .template-tile__content { padding: 17px; display: flex; flex-direction: column; min-height: 205px; }
  .template-tile__category { color: var(--accent-text,#b6daff); font-size: .72rem; font-weight: 700; }
  .template-tile h3 { margin: 8px 0; color: var(--text-primary,#f2f6fb); font-size: 1.04rem; line-height: 1.35; }
  .template-tile p { margin: 0; color: var(--text-secondary,#c1cbd8); font-size: .83rem; line-height: 1.5; }
  .template-tile__footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 18px; }
  .template-download,.template-request { font-weight: 700; font-size: .82rem; text-decoration: none; }
  .template-download { color: var(--accent-text,#b6daff); }
  .template-request { padding: 9px 11px; border: 1px solid var(--border-light,rgba(255,255,255,.28)); border-radius: 9px; color: var(--text-primary,#f2f6fb); }
  .template-price { color: var(--text-primary,#f2f6fb); font-weight: 800; }
  .template-empty { padding: 30px; border: 1px dashed var(--border-light,rgba(255,255,255,.28)); border-radius: 14px; color: var(--text-secondary,#c1cbd8); text-align: center; background: linear-gradient(145deg,rgba(26,39,64,.55),rgba(14,21,36,.72)); }
  .templates-assurance { max-width: 1236px; margin: 0 auto 80px; padding: 25px; display: flex; align-items: center; gap: 18px; border: 1px solid var(--border-color,rgba(255,255,255,.15)); border-radius: 18px; background: var(--grad-card,linear-gradient(165deg,rgba(26,39,64,.9),rgba(14,21,36,.97))); box-shadow: inset 0 1px 0 rgba(255,255,255,.1),0 14px 34px rgba(4,8,20,.4); }
  .templates-assurance__mark { display: grid; flex: 0 0 42px; place-items: center; width: 42px; height: 42px; border: 1px solid var(--accent-secondary-border,rgba(234,185,104,.35)); border-radius: 50%; color: var(--accent-secondary-text,#fde4b8); background: linear-gradient(145deg,rgba(234,185,104,.11),rgba(14,21,36,.9)); box-shadow: inset 0 1px 0 rgba(255,255,255,.14),0 6px 16px rgba(4,8,20,.3); font-size: 1.4rem; }
  .templates-assurance h2 { margin: 0 0 6px; font-size: 1.1rem; }
  .templates-assurance p { margin: 0; color: var(--text-secondary,#c1cbd8); font-size: .88rem; line-height: 1.6; }
  .templates-assurance>a { flex: 0 0 auto; color: var(--accent-text,#b6daff); font-weight: 700; text-decoration: none; }
