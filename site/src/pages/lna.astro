import Base from '../layouts/Base.astro';
import { renderPriceToken, formatPrice, getPrice } from '../shared/prices.ts';
import QuickLeadForm from '../components/QuickLeadForm.astro';
const content = renderPriceToken("<!-- HERO -->\n  <section class=\"hero hero-sub\">\n    <div class=\"hero-bg\"></div>\n    <div class=\"container\">\n      <div class=\"hero-content\">\n        <h1 class=\"anim\">Разработка <strong class=\"accent\">ЛНА</strong> под ключ</h1>\n        <p class=\"hero-subtitle anim anim-delay-1\">Локальные нормативные акты: ПВТР, положения, инструкции. Индивидуально под специфику вашей компании — не шаблоны из интернета</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- КОНТЕНТ -->\n  <section class=\"section\">\n    <div class=\"container\" style=\"max-width: 900px;\">\n\n      <!-- Что такое ЛНА -->\n      <div class=\"card anim\" style=\"margin-bottom: 32px; background: linear-gradient(135deg, var(--accent-glow), transparent);\">\n        <h2 style=\"font-size: 1.3rem; margin-bottom: 16px; color: var(--accent-text);\">Что такое ЛНА и зачем они нужны</h2>\n        <p style=\"color: var(--text-secondary); line-height: 1.8; margin-bottom: 16px;\">\n          <strong>Локальные нормативные акты (ЛНА)</strong> — это внутренние документы компании, которые регламентируют трудовые отношения.\n          Они обязательны для всех работодателей по ТК РФ и защищают как права сотрудников, так и интересы бизнеса.\n        </p>\n        <p style=\"color: var(--text-secondary); line-height: 1.8;\">\n          <strong>Без ЛНА:</strong> штрафы от 30 000 до 200 000 ₽, проигрыши в трудовых спорах, невозможность удержать компенсацию за обучение или оборудование.\n        </p>\n      </div>\n\n      <!-- Список документов -->\n      <h2 class=\"anim\" style=\"font-size: 1.5rem; font-weight: 300; margin: 48px 0 24px; text-align: center;\">\n        Какие документы я <strong>разрабатываю</strong>\n      </h2>\n\n      <div class=\"services-grid\" style=\"grid-template-columns: repeat(2, 1fr);\">\n\n        <div class=\"card service-card anim\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">📋</div>\n          <h3>Правила внутреннего трудового распорядка (ПВТР)</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Режим работы, перерывы, отпуска, дисциплинарная ответственность</p>\n          <div class=\"service-card-price\">{{price:lna.pvtr}}</div>\n        </div>\n\n        <div class=\"card service-card anim anim-delay-1\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">💰</div>\n          <h3>Положение об оплате труда</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Система окладов, премирование, компенсации, надбавки</p>\n          <div class=\"service-card-price\">{{price:lna.pay}}</div>\n        </div>\n\n        <div class=\"card service-card anim\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">🎯</div>\n          <h3>Положение о премировании</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Критерии и порядок начисления премий, лишение премий</p>\n          <div class=\"service-card-price\">{{price:lna.bonus}}</div>\n        </div>\n\n        <div class=\"card service-card anim anim-delay-1\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">📊</div>\n          <h3>Положение об аттестации</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Порядок проведения аттестации, критерии оценки</p>\n          <div class=\"service-card-price\">{{price:lna.attestation}}</div>\n        </div>\n\n        <div class=\"card service-card anim\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">🔒</div>\n          <h3>Положение о персональных данных</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">По ФЗ-152: согласие, политика, обязательства сторон</p>\n          <div class=\"service-card-price\">{{price:lna.personal-data}}</div>\n        </div>\n\n        <div class=\"card service-card anim anim-delay-1\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">📖</div>\n          <h3>Регламент кадрового делопроизводства</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Описание процессов, сроков, ответственности</p>\n          <div class=\"service-card-price\">{{price:lna.hr-regulation}}</div>\n        </div>\n\n        <div class=\"card service-card anim\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">✈️</div>\n          <h3>Положение о командировках</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Порядок оформления, суточные, возмещение расходов</p>\n          <div class=\"service-card-price\">{{price:lna.business-trips}}</div>\n        </div>\n\n        <div class=\"card service-card anim anim-delay-1\" style=\"cursor: default;\">\n          <div class=\"service-card-icon\">🤫</div>\n          <h3>Положение о конфиденциальности</h3>\n          <p style=\"color: var(--text-secondary); font-size: 0.9rem;\">Коммерческая тайна, NDA, ответственность</p>\n          <div class=\"service-card-price\">{{price:lna.nda}}</div>\n        </div>\n\n      </div>\n\n      <!-- Почему не шаблоны -->\n      <div class=\"card anim\" style=\"margin-top: 48px; margin-bottom: 32px;\">\n        <h3 style=\"color: var(--accent-text); margin-bottom: 16px;\">Почему индивидуальная разработка лучше шаблонов</h3>\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 24px;\">\n          <div>\n            <h4 style=\"margin-bottom: 8px; color: var(--danger);\">❌ Шаблоны из интернета</h4>\n            <ul style=\"color: var(--text-secondary); font-size: 0.9rem; line-height: 1.8; list-style: none;\">\n              <li>• Не учитывают специфику вашего бизнеса</li>\n              <li>• Устаревшие формулировки</li>\n              <li>• Нет защиты от рисков</li>\n              <li>• Часто противоречат ТК РФ</li>\n            </ul>\n          </div>\n          <div>\n            <h4 style=\"margin-bottom: 8px; color: var(--accent-text);\">✓ Моя разработка</h4>\n            <ul style=\"color: var(--text-secondary); font-size: 0.9rem; line-height: 1.8; list-style: none;\">\n              <li>• Учитываю специфику отрасли</li>\n              <li>• Актуальные нормы 2026 года</li>\n              <li>• Защита интересов работодателя</li>\n              <li>• Проходят проверки ГИТ</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n\n      <!-- Комплексные пакеты -->\n      <h2 class=\"anim\" style=\"font-size: 1.5rem; font-weight: 300; margin: 48px 0 24px; text-align: center;\">\n        Комплексные <strong>пакеты</strong> (выгоднее)\n      </h2>\n\n      <div class=\"packages-grid\">\n        <div class=\"card package-card anim\">\n          <h3>Минимальный</h3>\n          <div class=\"package-price\">{{price:lna.bundle-min}}</div>\n          <div class=\"package-saving\">Экономия 4 000 ₽</div>\n          <ul class=\"package-includes\">\n            <li>ПВТР</li>\n            <li>Положение об оплате труда</li>\n            <li>3 должностные инструкции</li>\n          </ul>\n          <a href=\"/contact.html\" class=\"btn btn-outline btn-block\">Заказать</a>\n        </div>\n\n        <div class=\"card package-card featured anim anim-delay-1\">\n          <div class=\"pricing-badge\">Популярный</div>\n          <h3>Стандартный</h3>\n          <div class=\"package-price\">{{price:lna.bundle-standard}}</div>\n          <div class=\"package-saving\">Экономия 7 000 ₽</div>\n          <ul class=\"package-includes\">\n            <li>Всё из пакета «Минимальный»</li>\n            <li>Регламент кадрового делопроизводства</li>\n            <li>Положение о персональных данных</li>\n            <li>Пакет шаблонов документов</li>\n          </ul>\n          <a href=\"/contact.html\" class=\"btn btn-primary btn-block\">Заказать</a>\n        </div>\n\n        <div class=\"card package-card anim anim-delay-2\">\n          <h3>Полный</h3>\n          <div class=\"package-price\">{{price:lna.bundle-full}}</div>\n          <div class=\"package-saving\">Индивидуально для 50+ сотрудников</div>\n          <ul class=\"package-includes\">\n            <li>Все ЛНА</li>\n            <li>Все шаблоны и формы</li>\n            <li>Адаптация под специфику</li>\n            <li>Программа адаптации сотрудников</li>\n          </ul>\n          <a href=\"/contact.html\" class=\"btn btn-outline btn-block\">Заказать</a>\n        </div>\n      </div>\n\n      <!-- CTA -->\n      <div class=\"card anim\" style=\"margin-top: 48px; text-align: center; background: linear-gradient(135deg, var(--accent-glow), var(--accent-glow)); border-color: var(--accent-border);\">\n        <h3 style=\"margin-bottom: 16px;\">Нужна консультация по составу ЛНА?</h3>\n        <p style=\"color: var(--text-secondary); margin-bottom: 24px;\">\n          Проанализирую ваш бизнес и скажу, какие документы нужны именно вам\n        </p>\n        <a href=\"/contact.html\" class=\"btn btn-primary btn-lg\">Бесплатная консультация</a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n");
---

<Base
  title={"Разработка ЛНА (локальных нормативных актов) под ключ | Кадры-Про"}
  description={"Разработка ЛНА: ПВТР, положения об оплате труда, должностные инструкции. Индивидуально под ваш бизнес, не шаблоны. От " + formatPrice(getPrice('lna.job-description')) + ". Ростов-на-Дону, работаю по всей России."}
  page="lna"
  jsonLd={[{"@context":"https://schema.org","@type":"Service","serviceType":"Разработка локальных нормативных актов","provider":{"@type":"Person","name":"Мария Перепечай"},"areaServed":"Россия","priceRange":"от " + formatPrice(getPrice('lna.job-description')) + ""}]}
  
>
  <Fragment set:html={content} />

  <QuickLeadForm page="lna" service="lna" title="Разработаю ЛНА под ваш бизнес" />
</Base>
