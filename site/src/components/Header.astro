---
/**
 * Шапка сайта: логотип, основное меню, кнопка заявки, гамбургер и мобильное меню.
 *
 * Что исправлено против старых 18 HTML-файлов:
 *  • меню везде одинаковое (раньше на privacy не было «Подбора кадров», на audit
 *    пункт назывался «Подбор», на thank-you-paid пропадали «Трудовые споры»);
 *  • логотип — векторный logo.svg без чёрных полей, поэтому шапка нормально
 *    помещается на ноутбуках 1024–1240 px и не «теснит» 8 пунктов;
 *  • в мобильном меню есть кнопки Telegram и MAX, а не только телефон.
 */
import { NAV, OWNER, SITE } from '../data/site.ts';

interface Props {
  /** Ключ страницы из NAV: home, services, podbor, … — подсвечивает активный пункт. */
  page?: string;
}
const { page = '' } = Astro.props;
---

<nav class="nav" id="site-nav" role="navigation" aria-label="Главная навигация">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label={`${SITE.name} — на главную`}>
      <img src="/img/logo.svg" alt="" class="logo" width="170" height="34">
      <span class="nav-logo-text">{SITE.name}</span>
    </a>

    <div class="nav-links">
      {NAV.map((item) => (
        <a href={item.href} class:list={{ active: page === item.key }} aria-current={page === item.key ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </div>

    <a href="/contact.html" class="nav-cta">Оставить заявку</a>

    <button class="hamburger" type="button" aria-label="Меню" aria-expanded="false" aria-controls="mobile-menu" id="hamburger">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-label="Мобильное меню" aria-modal="true">
  {NAV.map((item) => (
    <a href={item.href} class:list={{ active: page === item.key }}>{item.label}</a>
  ))}

  <div class="mobile-menu-contacts">
    <a href={OWNER.phoneHref} class="mobile-menu-btn mobile-menu-btn--call">{OWNER.phone}</a>
    <a href={OWNER.telegram} class="mobile-menu-btn mobile-menu-btn--tg" target="_blank" rel="noopener">
      Telegram {OWNER.telegramHandle}
    </a>
    <a href={OWNER.max} class="mobile-menu-btn mobile-menu-btn--max" target="_blank" rel="noopener">MAX</a>
    <a href="/contact.html" class="btn btn-primary btn-sm">Заявка</a>
  </div>
</div>
