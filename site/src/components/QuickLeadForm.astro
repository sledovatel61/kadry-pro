---
/**
 * Аккуратная встроенная форма заявки: имя + телефон/мессенджер + согласие.
 *
 * Ставится внизу продающих страниц (services, audit, lna, sout, voinskiy-uchet,
 * shtrafy-git, cases, about, trudovoy-spor) и на главной. Раньше на этих
 * страницах формы не было вовсе — человеку приходилось уходить в «Контакты».
 *
 * Отправка: форма помечена data-lead-form, адрес приёмника и сама отправка —
 * зона Агента 03 (site/src/client/leads-form.ts). Пока его модуль не подключён,
 * форма аккуратно проверяет поля и показывает телефон/Telegram, чтобы заявка
 * не потерялась. Formspree (серверы США) не используется.
 */
interface Props {
  /** Заголовок карточки. */
  title?: string;
  /** Пояснение под заголовком. */
  lead?: string;
  /** Ключ страницы — уйдёт в заявку, чтобы Мария видела, откуда пришёл человек. */
  page: string;
  /** Какая услуга интересует (для скрытого поля). */
  service?: string;
  /** Узкая версия без заголовка — для блоков внутри страницы. */
  compact?: boolean;
}
import { OWNER } from '../data/site.ts';
const {
  title = 'Оставьте заявку — рассчитаю стоимость',
  lead = 'Перезвоню в течение 2 часов в рабочее время. Бесплатно и без обязательств.',
  page,
  service = '',
  compact = false,
} = Astro.props;
const formId = `lead-${page}`;
---

<section class:list={['quick-lead', { 'quick-lead--compact': compact }]} id="lead-form" aria-labelledby={`${formId}-title`}>
  <div class="container">
    <div class="quick-lead-card anim">
      <div class="quick-lead-info">
        <h2 id={`${formId}-title`} class="quick-lead-title">{title}</h2>
        <p class="quick-lead-lead">{lead}</p>
        <div class="quick-lead-contacts">
          <a href={OWNER.phoneHref} class="quick-lead-contact">
            <span class="quick-lead-contact-icon" aria-hidden="true">📞</span>
            <span><b>{OWNER.phone}</b><br><small>звонок или SMS</small></span>
          </a>
          <a href={OWNER.telegram} class="quick-lead-contact" target="_blank" rel="noopener">
            <span class="quick-lead-contact-icon" aria-hidden="true">✈️</span>
            <span><b>Telegram {OWNER.telegramHandle}</b><br><small>написать сейчас</small></span>
          </a>
          <a href={OWNER.max} class="quick-lead-contact" target="_blank" rel="noopener">
            <span class="quick-lead-contact-icon" aria-hidden="true">Ⓜ️</span>
            <span><b>MAX</b><br><small>написать сейчас</small></span>
          </a>
        </div>
      </div>

      <form
        class="quick-lead-form"
        id={formId}
        data-lead-form
        data-page={page}
        data-service={service}
        novalidate
      >
        <input type="hidden" name="page" value={page}>
        {service && <input type="hidden" name="service" value={service}>}
        <input type="hidden" name="source" value={`quick-lead:${page}`}>

        <div class="form-group">
          <label class="form-label" for={`${formId}-name`}>Ваше имя *</label>
          <input
            type="text"
            id={`${formId}-name`}
            name="name"
            class="form-input"
            placeholder="Иван Иванов"
            autocomplete="name"
            required
          >
          <span class="form-error">Укажите имя</span>
        </div>

        <div class="form-group">
          <label class="form-label" for={`${formId}-phone`}>Телефон или мессенджер *</label>
          <input
            type="tel"
            id={`${formId}-phone`}
            name="phone"
            class="form-input"
            data-mask="phone"
            placeholder="+7 (___) ___-__-__"
            autocomplete="tel"
            inputmode="tel"
            required
          >
          <span class="form-error">Укажите телефон или @ник в Telegram</span>
        </div>

        <div class="form-group">
          <label class="form-label" for={`${formId}-comment`}>Что нужно сделать? <span class="quick-lead-optional">(необязательно)</span></label>
          <textarea
            id={`${formId}-comment`}
            name="comment"
            class="form-textarea"
            rows="2"
            placeholder="Например: нужны ПВТР и подготовка к проверке ГИТ"
          ></textarea>
        </div>

        <!-- Ловушка для спам-ботов: человек это поле не видит и не заполняет -->
        <input type="text" name="company_website" class="quick-lead-hp" tabindex="-1" autocomplete="off" aria-hidden="true">

        <label class="form-checkbox quick-lead-consent">
          <input type="checkbox" name="consent" required>
          <span>
            Согласен на обработку персональных данных по
            <a href="/privacy" target="_blank" rel="noopener">политике конфиденциальности</a>
            и <a href="/consent" target="_blank" rel="noopener">согласию на обработку ПДн</a>.
          </span>
        </label>

        <button type="submit" class="btn btn-primary btn-block btn-lg">Отправить заявку</button>

        <p class="quick-lead-status" role="status" aria-live="polite" hidden></p>
        <div class="form-success">
          <h3>✓ Заявка отправлена!</h3>
          <p>Свяжусь с вами в течение 2 часов в рабочее время.</p>
        </div>
      </form>
    </div>
  </div>
</section>
