---
/**
 * Логотип «Кадры-Про» — вектор прямо в разметке.
 *
 * Зачем inline, а не <img src="/img/logo.svg">: файл на диске остаётся
 * неизменным (его использует OG-карточка и превью в мессенджерах), а знак
 * и надпись на странице красятся переменными темы. Меняется палитра —
 * логотип перекрашивается вместе с ней, без второй копии файла.
 *
 *   знак «цветок»  → fill / stroke: var(--accent)
 *   «Kadry»        → fill: var(--text-primary)
 *   «-Pro»         → fill: var(--accent-text)  (осветлённый акцент: на тёмном
 *                    фоне обычный акцент в мелком кегле читается хуже)
 *
 * Геометрия ровно та же, что в public/img/logo.svg: viewBox 0 0 299 62.
 */
interface Props {
  /** Высота в пикселях: в шапке 34, в подвале 40. */
  height?: number;
  /** Что прочитать скринридеру. Пустая строка — логотип декоративный. */
  label?: string;
  class?: string;
}
const { height = 34, label = '', class: className = 'logo' } = Astro.props;
const width = Math.round((height * 299) / 62);
---

<svg
  class:list={[className]}
  width={width}
  height={height}
  viewBox="0 0 299 62"
  xmlns="http://www.w3.org/2000/svg"
  role={label ? 'img' : 'presentation'}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title>{label}</title>}
    <g fill="var(--accent)">
  <g fill="none" stroke="var(--accent)" stroke-width="9" stroke-linecap="round">
  <line x1="34" y1="28" x2="34" y2="19"/>
  <line x1="30" y1="32" x2="21" y2="26"/>
  <line x1="38" y1="32" x2="47" y2="26"/>
  <line x1="30" y1="37" x2="22" y2="44"/>
  <line x1="38" y1="37" x2="46" y2="44"/>
  </g>
  <circle cx="34" cy="32" r="10"/>
  <circle cx="34" cy="12" r="10.5"/>
  <circle cx="12.5" cy="25" r="10.5"/>
  <circle cx="55.5" cy="25" r="10.5"/>
  <circle cx="15" cy="50" r="10.5"/>
  <circle cx="53" cy="50" r="10.5"/>
  </g>
  <g fill="var(--text-primary)">
