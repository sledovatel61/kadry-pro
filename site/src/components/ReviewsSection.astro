---
/**
 * Блок отзывов для вставки на главную, в «Обо мне» и в «Кейсы».
 *
 * Источник — `site/content/reviews.json` (прошедшие сборку отзывы) плюс живые
 * отзывы из прослойки: их подтягивает `site/src/client/reviews-live.ts` в
 * `[data-reviews]`. Выдуманных отзывов нет и быть не может: если файл пуст,
 * блок честно говорит «пока нет отзывов» и предлагает оставить первый.
 *
 * Что важно сохранить при вставке:
 *   - `id` блока уникален на странице (`reviews-home`, `reviews-about`, `reviews-cases`);
 *   - `data-reviews` — на сетке карточек: по нему работает обновление;
 *   - форма отзыва (`ReviewModal.astro`) — одна на страницу.
 *
 * Пропсы:
 *   id        — якорь блока (`#reviews`);
 *   source    — `home` | `about` | `cases` (для data-атрибута и текста);
 *   title     — заголовок блока;
 *   limit     — сколько карточек показывать;
 *   withForm  — показывать кнопку «Оставить отзыв» (по умолчанию true).
 */
import { publishedReviews, reviewsStats, plural, type SiteReview } from '../shared/reviews-schema.ts';
import { relayMode } from '../shared/leads-endpoint.ts';

interface Props {
  id?: string;
  source?: 'home' | 'about' | 'cases';
  title?: string;
  limit?: number;
  withForm?: boolean;
}

const {
  id = 'reviews',
  source = 'home',
  title = 'Отзывы клиентов',
  limit = 6,
  withForm = true,
} = Astro.props;

/** Читаем файл отзывов, положенный в сборку (если Агент 04 ещё не подключил — пусто). */
let items: SiteReview[] = [];
try {
  const mod = await import('../../content/reviews.json');
  const file = (mod.default ?? mod) as { items?: SiteReview[] };
  items = publishedReviews({ updated_at: '', items: file.items ?? [] });
} catch {
  items = [];
}
const shown = items.slice(0, limit);
const stats = reviewsStats(items);
const avgText = stats.average === null ? null : String(stats.average).replace('.', ',');

const MONTHS_GEN = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
const nowYear = new Date().getFullYear();
function fmtDay(iso: string): string {
  const d = new Date(`${iso}T00:00:00Z`);
  if (Number.isNaN(d.getTime())) return iso;
  const base = `${d.getUTCDate()} ${MONTHS_GEN[d.getUTCMonth()]}`;
  return d.getUTCFullYear() === nowYear ? base : `${base} ${d.getUTCFullYear()}`;
}

const sourceNote = source === 'cases'
  ? 'Отзывы о совместной работе: что получилось и какие были задачи.'
  : source === 'about'
    ? 'Что пишут клиенты о работе со мной — без правок и купюр.'
    : 'Отзывы клиентов, которые уже работают со мной. Новые появляются здесь же — сразу после отправки.';
---

<section class="sec rev-section" id={id} aria-labelledby={`${id}-h`}>
  <div class="container">
    <div class="rev-head">
      <div>
        <span class="eyebrow">Отзывы</span>
        <h2 id={`${id}-h`}>{title}</h2>
        <p class="lead">{sourceNote}</p>
      </div>
      {withForm && (
        <button class="btn btn--primary" type="button" data-open-review>
          Оставить отзыв
        </button>
      )}
    </div>

    <div class="rev-summary" data-reviews-summary hidden={shown.length === 0}>
      {shown.length > 0 && avgText ? (
        <>
          <div class="rev-summary-num"><b>{avgText}</b><small>из 5</small></div>
          <div class="rev-summary-body">
            <p class="rev-summary-line">
              {stats.count} {plural(stats.count, 'отзыв', 'отзыва', 'отзывов')} на сайте · средняя оценка {avgText}
            </p>
            <p class="hint">Оценки ставили клиенты — здесь только отзывы, оставленные на сайте.</p>
          </div>
        </>
      ) : null}
    </div>

    <div class="rev-grid" data-reviews={source} data-reviews-limit={String(limit)}>
      {shown.map((r) => (
        <article class="rev-card" data-review-id={r.id}>
          <span class="rev-stars" role="img" aria-label={`Оценка ${r.rating} из 5`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <svg viewBox="0 0 24 24" aria-hidden="true" class={i < r.rating ? 'is-on' : ''}>
                <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z" />
              </svg>
            ))}
          </span>
          <div class="rev-text"><p>{r.text}</p></div>
          <div class="rev-who">
            <span class="rev-ava" aria-hidden="true">{r.author.slice(0, 1).toUpperCase()}</span>
            <span>
              <b>{r.author}</b>
              <span>Сайт · {fmtDay(r.published_at)}</span>
            </span>
          </div>
          {r.reply && (
            <div class="rev-reply"><b>Ответ Марии: </b>{r.reply}</div>
          )}
        </article>
      ))}
    </div>

    <div class="rev-empty" data-reviews-empty hidden={shown.length > 0}>
      <p><b>Пока на сайте нет отзывов.</b> Здесь появятся настоящие отзывы клиентов — без правок и «примеров».</p>
      {withForm && relayMode && (
        <p class="hint">Уже работали со мной? Оставьте отзыв — он появится сразу.</p>
      )}
    </div>

    {withForm && (
      <p class="rev-note hint">
        Отзыв публикуется сразу, без модерации. Если в нём окажется спам или грубость, я его уберу.
        Ссылки в отзывах не нужны.
      </p>
    )}
  </div>
</section>
