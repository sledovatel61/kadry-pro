{
  "name": "kadry-pro-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:pages": "astro build && node scripts/export-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs --dir pages-dist",
    "check:media": "node scripts/check-media-budget.mjs",
    "check:prices": "node scripts/check-prices-sync.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "check:reviews": "node scripts/check-reviews.mjs",
    "check:cases": "node scripts/check-cases.mjs",
    "check:articles": "node scripts/check-articles.mjs",
    "check": "npm run check:prices && npm run check:templates && npm run check:reviews && npm run check:cases && npm run check:articles && npm run check:analytics && npm run check:media && npm run check:pages",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "images": "node scripts/build-images.mjs"
  },
  "dependencies": {
    "astro": "^5.14.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fontkit": "^3.0.0",
    "jsdom": "^31.0.1"
  }
}
