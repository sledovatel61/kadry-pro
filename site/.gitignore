# Зависимости и артефакты сборки Astro — в репозиторий не попадают
# слэша в конце нет намеренно: node_modules в песочнице — символическая
# ссылка, а шаблон с завершающим слэшем такие записи не отсекает.
node_modules
dist/
.astro/
pages-dist/

# Промежуточные материалы переезда: HTML, вытащенный из корневых страниц
# скриптом site/scripts/lib/extract-page.mjs. Готовые страницы лежат рядом в
# site/src/pages/*.astro, поэтому в репозитории этот дубль не нужен —
# при необходимости он восстанавливается одной командой из корневых файлов.
src/pages/_content/
